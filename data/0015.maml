    mamlText: "# Email template configuration\n{\n  from: \"noreply@judicious-baseboard.org\"\n  subject: \"Ultra taedium contabesco.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Tertius fugiat aequus nobis aliquid. Modi consequuntur supplanto baiulus casus apparatus officia commodi mollitia. Vox thesis circumvenio videlicet terreo advenio cicuta curo truculenter.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nDeinde concido vergo vestigium acquiro adhaero. Altus vinculum angulus curto turpis beneficium adsidue summa umerus patior. Architecto iure tot degusto.\n\nVisit: {{url}}\n\"\"\"\n}"
