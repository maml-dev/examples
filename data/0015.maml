    mamlText: "{\n  engine: \"typesense\"\n  connection: {\n    host: \"localhost:7700\"\n    api_key: \"VWYw6cmdVsUsL5gn3QjvhmvOutf5w7bP\"\n    timeout: 7442\n  }\n\n  # Index settings\n  index: {\n    name: \"minion\"\n    primary_key: \"id\"\n    searchable: [\n      \"title\"\n      \"description\"\n      \"content\"\n    ]\n    filterable: [\n      \"category\"\n      \"status\"\n      \"date\"\n    ]\n    sortable: [\n      \"date\"\n      \"relevance\"\n    ]\n  }\n\n  synonyms: {\n    js: [\n      \"javascript\"\n      \"ecmascript\"\n    ]\n    ts: [\n      \"typescript\"\n    ]\n  }\n}"
