    mamlText: "# Pallaby Changelog\n{\n  project: \"bell\"\n  releases: [\n    {\n      version: \"0.16.5\"\n      date: \"2026-08-18\"\n      notes: \"\"\"\nAdded:\n- override virtual feed\n- calculate multi-byte bandwidth\n\nFixed:\n- compress wireless card\n\"\"\"\n    }\n\n    {\n      version: \"7.17.18\"\n      date: \"2026-08-11\"\n      notes: \"\"\"\nChanged:\n- override online firewall\n\nRemoved:\n- reboot back-end alarm\n\"\"\"\n    }\n\n    {\n      version: \"8.9.12\"\n      date: \"2026-04-04\"\n      notes: \"\"\"\nInitial release:\n- calculate primary interface\n- connect bluetooth interface\n- transmit 1080p array\n\"\"\"\n    }\n  ]\n}"
