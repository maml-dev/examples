    mamlText: "{\n  sprint: \"Sprint 5\"\n  tasks: [\n    {\n      id: \"VLKE0O\"\n      title: \"Use the redundant TLS alarm, then you can navigate the primary pixel!\"\n      assignee: \"Lynne Breitenberg-Carroll\"\n      priority: \"medium\"\n      status: \"todo\"\n      points: 13\n    }\n\n    {\n      id: \"CNOEXY\"\n      title: \"The ADP pixel is down, back up the open-source hard drive so we can quantify the SSL protocol!\"\n      assignee: \"Della Lowe\"\n      priority: \"critical\"\n      status: \"review\"\n      points: 1\n    }\n\n    {\n      id: \"UUGMTE\"\n      title: \"The AI array is down, input the optical feed so we can index the DRAM array!\"\n      assignee: \"Irene Senger\"\n      priority: \"high\"\n      status: \"review\"\n      points: 1\n    }\n\n    {\n      id: \"QMAVM7\"\n      title: \"Try to synthesize the XSS driver, maybe it will generate the back-end sensor!\"\n      assignee: \"Dr. Kadin Cruickshank\"\n      priority: \"high\"\n      status: \"done\"\n      points: 8\n    }\n\n    {\n      id: \"JC6KKZ\"\n      title: \"Use the 1080p PNG driver, then you can hack the mobile firewall!\"\n      assignee: \"Rodrigo Homenick Jr.\"\n      priority: \"low\"\n      status: \"review\"\n      points: 1\n    }\n\n    {\n      id: \"RYFL8Q\"\n      title: \"The USB protocol is down, connect the back-end pixel so we can transmit the CSS system!\"\n      assignee: \"Joanny Kerluke\"\n      priority: \"medium\"\n      status: \"review\"\n      points: 13\n    }\n  ]\n}"
