    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@some-mythology.net\"\n  subject: \"Ulterius iusto umbra arcesso tardus.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Aetas adnuo vinum animadverto maiores qui agnitio pauper considero. Thermae beneficium cupiditate vilis complectus tenax. Tantillus cometes concido crapula viduo excepturi sum animadverto tristis.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nBlandior conservo quidem tollo stips cito commodi pax sulum recusandae. Vomer aperiam arbitro ullus cura velit vorago casso. Cresco nostrum vorago custodia.\n\nVisit: {{url}}\n\"\"\"\n}"
