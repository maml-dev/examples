    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"aws\"\n  region: \"ap-southeast-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 4\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 20\n      target_cpu: 57\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 323\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-e4ecdd5d\"\n    subnet: \"10.235.0.0/16\"\n    public_ip: true\n  }\n}"
  }
