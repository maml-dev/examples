    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"delectable-netsuke.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.delectable-netsuke.org\"\n      \"mx2.delectable-netsuke.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.delectable-netsuke.org\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 401\n      per_hour: 9669\n    }\n  }\n}"
  }
  {
    num: "15130"
    title: "Theme Config"
    description: "Design system theme configuration."
    shapeIndex: 1
    mamlText: "{\n  name: \"biodegradable Theme\"\n  # Color palette\n  colors: {\n    primary: \"#ad39da\"\n    secondary: \"#cab556\"\n    accent: \"#bbea44\"\n    background: \"#ffffff\"\n    text: \"#1a1a1a\"\n\n    error: \"#dc3545\"\n    warning: \"#ffc107\"\n    success: \"#28a745\"\n  }\n\n  # Typography\n  typography: {\n    font_family: \"\\\"JetBrains Mono\\\", monospace\"\n    base_size: 18\n    line_height: 1.5\n    headings: {\n      font_family: \"\\\"Space Grotesk\\\", sans-serif\"\n      weight: 800\n    }\n  }\n\n  spacing: {\n    unit: 4\n    scale: [\n      0\n      4\n      8\n      16\n      24\n      32\n      48\n    ]\n  }\n  border_radius: 4\n}"
  }
  {
