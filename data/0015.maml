  {
    num: "15644"
    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 43\"\n  tasks: [\n    {\n      id: \"HYLQJE\"\n      title: \"The ADP firewall is down, input the wireless array so we can reboot the SMS matrix!\"\n      assignee: \"Dr. Amber Murazik\"\n      priority: \"medium\"\n      status: \"todo\"\n      points: 3\n    }\n\n    {\n      id: \"HG8X9L\"\n      title: \"If we copy the alarm, we can get to the SDD array through the neural VGA bandwidth!\"\n      assignee: \"Mable Hettinger\"\n      priority: \"low\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"MPWBIM\"\n      title: \"Use the multi-byte TCP protocol, then you can copy the open-source firewall!\"\n      assignee: \"Micheal Batz-Lynch\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 2\n    }\n\n    {\n      id: \"E3V2PM\"\n      title: \"bypassing the interface won't do anything, we need to connect the redundant JBOD sensor!\"\n      assignee: \"Solon Daugherty\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 3\n    }\n\n    {\n      id: \"P1Z8WU\"\n      title: \"We need to override the open-source TLS pixel!\"\n      assignee: \"Dillan Herzog\"\n      priority: \"high\"\n      status: \"done\"\n      points: 1\n    }\n\n    {\n      id: \"F6FLCI\"\n      title: \"Try to back up the SSL port, maybe it will parse the mobile capacitor!\"\n      assignee: \"Gladys Ryan Sr.\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 13\n    }\n  ]\n}"
  }
