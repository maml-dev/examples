    mamlText: "{\n  provider: \"aws\"\n  region: \"ap-southeast-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 8\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 11\n      target_cpu: 69\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 237\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-faaab262\"\n    subnet: \"10.12.0.0/16\"\n    public_ip: true\n  }\n}"
