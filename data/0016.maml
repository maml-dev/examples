    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"localhost\"\n    databases: [\n      \"soup\"\n      \"arcade\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 7\n    weekly: 10\n    monthly: 19\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"s3://backups-allegation\"\n    encryption: true\n    compression: \"zstd\"\n  }\n}"
