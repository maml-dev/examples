    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"localhost\"\n    databases: [\n      \"markup\"\n      \"starboard\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 10\n    weekly: 5\n    monthly: 8\n  }\n\n  destination: {\n    type: \"gcs\"\n    path: \"/mnt/backups/bump\"\n    encryption: true\n    compression: \"gzip\"\n  }\n}"
