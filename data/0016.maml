    mamlText: "# Email template configuration\n{\n  from: \"noreply@fuzzy-toothbrush.net\"\n  subject: \"Cuppedia aliquam quaerat tribuo arma.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Summopere decerno arbustum adiuvo derideo creber vir ater video. Animi dens comburo distinctio utrimque commemoro. Textilis cui stipes dedico carmen desparatus pectus delego.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nCurriculum attonbitus comburo basium cunae totidem alias uter currus. Arx tribuo vesper illo complectus eos autus vestigium. Agnosco veritatis sui terreo quia adsum suffoco cicuta nam.\n\nVisit: {{url}}\n\"\"\"\n}"
