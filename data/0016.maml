    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 5\"\n  tasks: [\n    {\n      id: \"T4OGJJ\"\n      title: \"We need to quantify the auxiliary PNG driver!\"\n      assignee: \"Albert Corkery-Weimann\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 2\n    }\n\n    {\n      id: \"6IYKBX\"\n      title: \"Try to transmit the JBOD feed, maybe it will input the back-end monitor!\"\n      assignee: \"Kylie Schaefer\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"NEHNNE\"\n      title: \"If we program the transmitter, we can get to the HTTP matrix through the neural CLI array!\"\n      assignee: \"Kristin Bernhard\"\n      priority: \"high\"\n      status: \"done\"\n      points: 5\n    }\n\n    {\n      id: \"YNUA6O\"\n      title: \"You can't transmit the microchip without backing up the multi-byte USB card!\"\n      assignee: \"Gerhard Paucek\"\n      priority: \"critical\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"AP2ALY\"\n      title: \"parsing the feed won't do anything, we need to compress the mobile JBOD panel!\"\n      assignee: \"Joann Wolff\"\n      priority: \"low\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"AZZAOC\"\n      title: \"I'll calculate the auxiliary SCSI port, that should pixel the SMS pixel!\"\n      assignee: \"Devin Rodriguez\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 8\n    }\n  ]\n}"
  }
