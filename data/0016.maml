    mamlText: "{\n  roles: [\n    {\n      name: \"viewer\"\n      permissions: [\n        \"read\"\n        \"manage_billing\"\n        \"write\"\n        \"manage_users\"\n        \"view_analytics\"\n      ]\n      max_seats: 3\n    }\n\n    {\n      name: \"support\"\n      permissions: [\n        \"manage_billing\"\n        \"export_data\"\n        \"delete\"\n        \"view_analytics\"\n        \"manage_users\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"moderator\"\n      permissions: [\n        \"manage_billing\"\n        \"view_analytics\"\n        \"delete\"\n        \"export_data\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"support\"\n      permissions: [\n        \"manage_users\"\n        \"export_data\"\n        \"read\"\n      ]\n      max_seats: 17\n    }\n  ]\n}"
