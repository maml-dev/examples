    mamlText: "{\n  trip: \"New Madalyn to Lake Jeanniebury\"\n  traveler: \"Janet Crooks\"\n  dates: {\n    departure: \"2026-11-03\"\n    return: \"2026-11-21\"\n  }\n\n  flights: [\n    {\n      flight: \"0143\"\n      from: \"CHC\"\n      to: \"ORD\"\n      departure: \"18:45\"\n      seat: \"20E\"\n    }\n\n    {\n      flight: \"0052\"\n      from: \"XIY\"\n      to: \"CKG\"\n      departure: \"11:30\"\n      seat: \"21D\"\n    }\n  ]\n\n  hotel: {\n    name: \"Jones, Kemmer and Russel Hotel\"\n    address: \"67485 Nelson Street\"\n    check_in: \"14:00\"\n    check_out: \"10:00\"\n    confirmation: \"JTECC349\"\n  }\n}"
