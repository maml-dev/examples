    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 8\"\n  tasks: [\n    {\n      id: \"QNVPTK\"\n      title: \"You can't index the alarm without hacking the optical ASCII hard drive!\"\n      assignee: \"Alycia Jacobs\"\n      priority: \"high\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"0TI1TG\"\n      title: \"You can't hack the protocol without synthesizing the mobile IB application!\"\n      assignee: \"Alan Senger\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 5\n    }\n\n    {\n      id: \"F7B7BD\"\n      title: \"If we program the application, we can get to the DNS firewall through the open-source ASCII program!\"\n      assignee: \"Trisha Larkin-Mante\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 3\n    }\n\n    {\n      id: \"YHGG0C\"\n      title: \"Use the auxiliary IP array, then you can override the wireless monitor!\"\n      assignee: \"Janie Hegmann\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 1\n    }\n\n    {\n      id: \"ZDWINK\"\n      title: \"The RSS panel is down, index the wireless circuit so we can hack the API microchip!\"\n      assignee: \"Ruben Luettgen\"\n      priority: \"low\"\n      status: \"review\"\n      points: 8\n    }\n  ]\n}"
