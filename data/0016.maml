  {
    num: "16566"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Sour Pork With Endive\"\n  servings: 4\n  prep_time: \"34 minutes\"\n  cook_time: \"94 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 lbs snowpea sprouts\"\n    \"3 tsp cream\"\n    \"1 cups vanilla beans\"\n    \"4 tbsp dates\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A succulent salmon steak, encased in a juicy tagine crust, served with a side of poppy seed mashed cos lettuce.\"\n    \"A succulent emu steak, encased in a bitter cardamom crust, served with a side of sweet laurel mashed bean sprouts.\"\n    \"Grilled quail kebabs, marinated in Tamil spices and served with a fresh iceberg lettuce and watermelon salad.\"\n    \"Fresh mixed greens tossed with poppy seed-rubbed salmon, peppers, and a light dressing.\"\n    \"Three enoki mushrooms with okra, english spinach, bean sprouts, pumpkin and caraway seed. With a side of baked lychee, and your choice of buckwheat flour or nectarines.\"\n    \"A succulent kangaroo steak, encased in a fluffy chervil crust, served with a side of lemon pepper mashed jerusalem artichoke.\"\n  ]\n\n  nutrition: {\n    calories: 373\n    protein: \"48g\"\n    carbs: \"83g\"\n    fat: \"35g\"\n  }\n}"
  }
