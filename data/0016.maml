  {
    num: "16969"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Sweet Chilli Sauce-infused Rabbit\"\n  servings: 3\n  prep_time: \"29 minutes\"\n  cook_time: \"98 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 tsp rose water\"\n    \"2 cups kohlrabi\"\n    \"1 tsp kiwi berries\"\n    \"1 oz fresh chillies\"\n    \"4 oz fennel\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A delightful tart combining moist bean shoots and sweet aubergine, set in a buttery pastry shell and finished with a hint of jerk.\"\n    \"Tender quail skewers, glazed with a sweet and tangy tomato sauce, served over a bed of fragrant jasmine rice.\"\n    \"Our salty chicken, slow-cooked to perfection, accompanied by steamed artichoke and a rich, savory gravy.\"\n    \"Fresh mixed greens tossed with anise star-rubbed crocodile, carob carrot, and a light dressing.\"\n    \"Fresh mixed greens tossed with chillies-rubbed venison, bean shoots, and a light dressing.\"\n    \"A succulent kangaroo steak, encased in a golden rogan josh crust, served with a side of lemon grass mashed red pepper.\"\n  ]\n\n  nutrition: {\n    calories: 204\n    protein: \"31g\"\n    carbs: \"84g\"\n    fat: \"37g\"\n  }\n}"
  }
