    mamlText: "{\n  application: \"metrics\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: I'll back up the redundant EXE protocol, that should alarm the PNG sensor!\n    at /boot/defaults/kooky_what.ttf:99\n    at /tmp/following.boz:204\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPUT /api/validity HTTP/1.1\nHost: stark-yarmulke.org\nUser-Agent: Mozilla/5.0 (Linux; Android 6; SM-G998N) AppleWebKit/537.3 (KHTML, like Gecko) Chrome/105.1.4.10 Mobile Safari/577.5\nAccept: application/json\n\"\"\"\n  retention_days: 18\n}"
