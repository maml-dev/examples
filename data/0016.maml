  {
    num: "16925"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"localhost\"\n    databases: [\n      \"bell\"\n      \"boulevard\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 9\n    weekly: 9\n    monthly: 13\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"s3://backups-barracks\"\n    encryption: true\n    compression: \"gzip\"\n  }\n}"
  }
  {
