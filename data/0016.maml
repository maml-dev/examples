    mamlText: "{\n  title: \"Longan And Dragonfruit Tart\"\n  servings: 8\n  prep_time: \"42 minutes\"\n  cook_time: \"61 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 lbs aubergine\"\n    \"3 pieces spelt\"\n    \"4 tbsp miso\"\n    \"3 lbs wholewheat flour\"\n    \"3 lbs broccoli\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Crispy fried venison bites, seasoned with french lavender and served with a tangy berry dipping sauce.\"\n    \"A slow-roasted Bachman's Sparrow with a crunchy, juicy exterior. Stuffed with cantaloupe and covered in starfruit sauce. Sides with zucchini puree and wild garlic.\"\n    \"An exquisite chicken roast, infused with the essence of fingerlime, slow-roasted to bring out its natural flavors and served with a side of creamy asian greens\"\n    \"A robust savory stew featuring Italian-American flavors, loaded with delicious meat, zesty vegetables, and a smoky, moist broth.\"\n    \"An exquisite pork roast, infused with the essence of kiwi fruit, slow-roasted to bring out its natural flavors and served with a side of creamy zucchini\"\n  ]\n\n  nutrition: {\n    calories: 264\n    protein: \"23g\"\n    carbs: \"47g\"\n    fat: \"31g\"\n  }\n}"
  }
