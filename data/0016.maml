  {
    num: "16836"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"postgresql\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"deer\"\n      \"shore\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 7\n    weekly: 5\n    monthly: 22\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"/mnt/backups/dependency\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
  }
