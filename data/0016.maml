    mamlText: "{\n  domain: \"prestigious-labourer.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.prestigious-labourer.info\"\n      \"mx2.prestigious-labourer.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.prestigious-labourer.info\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 285\n      per_hour: 4898\n    }\n  }\n}"
