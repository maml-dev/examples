    shapeIndex: 3
    mamlText: "{\n  title: \"Pappardelle Alla Bolognese\"\n  servings: 2\n  prep_time: \"42 minutes\"\n  cook_time: \"74 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 tsp tamarillo\"\n    \"3 oz rosemary\"\n    \"2 tsp porcini mushrooms\"\n    \"2 tsp dashi\"\n    \"4 tbsp lentils\"\n    \"3 oz cassia bark\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A special ivory snowpea sprouts from Mexico. To support the strong flavor it is sided with a tablespoon of arrowroot.\"\n    \"Hearty bread and rabbit stew, slow-cooked with german chamomile and artichoke for a comforting, flavorful meal.\"\n    \"Fresh mixed greens tossed with pepper-rubbed crocodile, pumpkin, and a light dressing.\"\n    \"Tenderly braised ostrich in a rich thyme and carrot sauce, served with a side of creamy green beans.\"\n    \"Juicy venison, grilled to your liking and drizzled with a bold balti stir fry mix sauce, served alongside roasted garlic.\"\n    \"A classic pie filled with delicious emu and juicy safflower oil, baked in a sweet pastry crust and topped with a golden-brown lattice.\"\n  ]\n\n  nutrition: {\n    calories: 767\n    protein: \"38g\"\n    carbs: \"44g\"\n    fat: \"10g\"\n  }\n}"
