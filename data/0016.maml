    mamlText: "# Email template configuration\n{\n  from: \"noreply@muddy-cricket.net\"\n  subject: \"Atrocitas acerbitas aliqua adopto cicuta crux.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Decens calco virga tardus textor audeo cometes. Tredecim tabesco clibanus aut dolor. Comitatus calamitas aestivus alveus illo dicta chirographum coruscus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nDeprimo valde atavus conforto taceo umbra. Summisse omnis vulariter. Audacia arceo conor alias neque sequi vix.\n\nVisit: {{url}}\n\"\"\"\n}"
