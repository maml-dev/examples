    mamlText: "# Email template configuration\n{\n  from: \"noreply@free-linseed.org\"\n  subject: \"Odit acervus quos verbera.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Aliquid tyrannus veritatis ait. Sursum amplitudo adiuvo curiositas thesaurus. Facere cursim depono comptus caterva supellex.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nCentum damnatio subnecto defleo vix stella. Vestigium sponte cruciamentum advoco magni curis clarus totam pecto campana. Arx sperno suadeo adamo abbas comptus.\n\nVisit: {{url}}\n\"\"\"\n}"
