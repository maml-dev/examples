    mamlText: "{\n  base_url: \"/api/v1\"\n  routes: [\n    {\n      method: \"PUT\"\n      path: \"/users\"\n      handler: \"createUsers\"\n      auth: false\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/users/:id\"\n      handler: \"listPosts\"\n      auth: false\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/products/:id\"\n      handler: \"deleteUsers\"\n      auth: false\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/comments/:id\"\n      handler: \"createProducts\"\n      auth: false\n    }\n\n    {\n      method: \"POST\"\n      path: \"/products\"\n      handler: \"createProducts\"\n      auth: true\n    }\n\n    {\n      method: \"GET\"\n      path: \"/posts/:id\"\n      handler: \"createOrders\"\n      auth: false\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/comments/:id\"\n      handler: \"listOrders\"\n      auth: true\n    }\n  ]\n}"
