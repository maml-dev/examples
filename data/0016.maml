    mamlText: "# Email template configuration\n{\n  from: \"noreply@immaculate-climb.org\"\n  subject: \"Occaecati veritatis suus.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Acquiro vero volo cibus beatus timor. Iste maxime adhuc subnecto cilicium. Tabgo defaeco balbus animus turpis reprehenderit.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nTersus cervus vitae magni. Aggredior demulceo vilicus architecto degenero. Cupiditate cruentus aegre.\n\nVisit: {{url}}\n\"\"\"\n}"
