  {
    num: "16471"
    title: "App Manifest"
    description: "Full application manifest with metadata, dependencies, and scripts."
    shapeIndex: 3
    mamlText: "{\n  name: \"possession-farm\"\n  version: \"6.6.2\"\n  description: \"Sharable tertiary parallelism\"\n\n  keywords: [\n    \"draft\"\n    \"sonnet\"\n    \"immaculate\"\n  ]\n\n  scripts: {\n    dev: \"node server.js --watch\"\n    build: \"tsc && esbuild src/index.ts --bundle --outfile=dist/index.js\"\n    test: \"mocha\"\n    lint: \"eslint .\"\n  }\n  engines: {\n    node: \">=20\"\n  }\n\n  author: {\n    name: \"Roberta Kulas\"\n    email: \"Granville.Russel34@gmail.com\"\n    url: \"https://ironclad-cuckoo.org/\"\n  }\n}"
