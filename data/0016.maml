    shapeIndex: 1
    mamlText: "{\n  domain: \"aggravating-comestible.name\"\n  inbound: {\n    mx_records: [\n      \"mx1.aggravating-comestible.name\"\n      \"mx2.aggravating-comestible.name\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.aggravating-comestible.name\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 61\n      per_hour: 1602\n    }\n  }\n}"
  }
