    mamlText: "{\n  title: \"Snowpea Pie\"\n  servings: 3\n  prep_time: \"32 minutes\"\n  cook_time: \"19 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 tsp guava\"\n    \"2 tsp unbleached flour\"\n    \"4 tbsp limes\"\n    \"2 lbs blue eye trevalla\"\n    \"1 oz tabasco\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Fresh mixed greens tossed with amchoor-rubbed turkey, carob carrot, and a light dressing.\"\n    \"Savor the rich flavors of rich red pepper, complemented by olive and german chamomile.\"\n    \"Juicy kangaroo, grilled to your liking and drizzled with a bold allspice sauce, served alongside roasted purple carrot.\"\n    \"A heartwarming Pennsylvania Dutch soup, featuring fresh black eyed beans and an aromatic blend of traditional spices.\"\n  ]\n\n  nutrition: {\n    calories: 345\n    protein: \"12g\"\n    carbs: \"96g\"\n    fat: \"5g\"\n  }\n}"
