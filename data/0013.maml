    mamlText: "{\n  base_url: \"/api/v3\"\n  routes: [\n    {\n      method: \"POST\"\n      path: \"/orders\"\n      handler: \"updateUsers\"\n      auth: false\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/products/:id\"\n      handler: \"getProducts\"\n      auth: true\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/comments\"\n      handler: \"updateProducts\"\n      auth: false\n    }\n\n    {\n      method: \"GET\"\n      path: \"/users/:id\"\n      handler: \"updatePosts\"\n      auth: true\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/comments\"\n      handler: \"getUsers\"\n      auth: true\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/posts/:id\"\n      handler: \"createUsers\"\n      auth: true\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/posts\"\n      handler: \"createPosts\"\n      auth: false\n    }\n  ]\n}"
