    description: "Authentication and authorization settings."
    shapeIndex: 1
    mamlText: "{\n  provider: \"oauth2\"\n  # Token settings\n  jwt: {\n    secret_key: \"y1VQmm34zXmWU7fh8ggWyLlOEUTL8smE\"\n    algorithm: \"HS256\"\n    expiry: \"1h\"\n    refresh_expiry: \"30d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"alEMMbsqV8zSxWAC8AM0JKEF\"\n    authorize_url: \"https://auth.simple-doorpost.net/authorize\"\n    token_url: \"https://auth.tiny-lady.info/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"redis\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
