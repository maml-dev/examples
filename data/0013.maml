    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Galangal-rubbed Duck Salad\"\n  servings: 8\n  prep_time: \"53 minutes\"\n  cook_time: \"117 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 lbs mackerel\"\n    \"3 pieces haloumi\"\n    \"4 oz besan\"\n    \"2 tsp juniper berries\"\n    \"1 tbsp carob carrot\"\n    \"4 lbs okra\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Baked bean sprouts-stuffed lamb, seasoned with cardamom and delicious herbs, accompanied by roasted asparagus medley.\"\n    \"Fresh mixed greens tossed with aniseed-rubbed duck, brussels sprouts, and a light dressing.\"\n    \"A succulent goose steak, encased in a crispy bay leaves crust, served with a side of arrowroot mashed garlic.\"\n    \"An exquisite swiss chard dish, paired with chickory and a hint of bbq.\"\n    \"Savor the rich flavors of zesty cabbage, complemented by sprout and mace.\"\n  ]\n\n  nutrition: {\n    calories: 407\n    protein: \"15g\"\n    carbs: \"17g\"\n    fat: \"26g\"\n  }\n}"
  }
