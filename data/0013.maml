  {
    num: "13238"
    title: "K8s Deployment"
    description: "Kubernetes deployment specification."
    shapeIndex: 1
    mamlText: "{\n  apiVersion: \"apps/v1\"\n  kind: \"Deployment\"\n  metadata: {\n    name: \"flight-worker\"\n    namespace: \"production\"\n    labels: {\n      app: \"scorpion\"\n      tier: \"backend\"\n    }\n  }\n\n  # Deployment spec\n  spec: {\n    replicas: 4\n    container: {\n      image: \"diversity:7.9.18\"\n      port: 8080\n      resources: {\n        cpu_limit: \"250m\"\n        memory_limit: \"512Mi\"\n      }\n    }\n\n    health_check: {\n      path: \"/health\"\n      interval: 10\n      timeout: 5\n    }\n  }\n}"
  }
  {
    num: "13239"
    title: "Search Config"
    description: "Search engine index configuration."
    shapeIndex: 1
    mamlText: "{\n  engine: \"elasticsearch\"\n  connection: {\n    host: \"search.internal:7700\"\n    api_key: \"MZK1vIDrcelFgXhvVwrImiWJmkkHJzql\"\n    timeout: 6094\n  }\n\n  # Index settings\n  index: {\n    name: \"stump\"\n    primary_key: \"id\"\n    searchable: [\n      \"title\"\n      \"description\"\n      \"content\"\n    ]\n    filterable: [\n      \"category\"\n      \"status\"\n      \"date\"\n    ]\n    sortable: [\n      \"date\"\n      \"relevance\"\n    ]\n  }\n\n  synonyms: {\n    js: [\n      \"javascript\"\n      \"ecmascript\"\n    ]\n    ts: [\n      \"typescript\"\n    ]\n  }\n}"
  }
  {
    num: "13240"
    title: "GraphQL Schema"
    description: "GraphQL type and resolver configuration."
    shapeIndex: 1
    mamlText: "{\n  schema: {\n    query: \"Query\"\n    mutation: \"Mutation\"\n  }\n\n  types: {\n    # User type\n    User: {\n      fields: {\n        id: \"ID!\"\n        name: \"String!\"\n        email: \"String!\"\n        avatar: \"String\"\n        posts: \"[Post!]!\"\n        role: \"Role!\"\n      }\n    }\n\n    # Post type\n    Post: {\n      fields: {\n        id: \"ID!\"\n        title: \"String!\"\n        body: \"String!\"\n        author: \"User!\"\n        published: \"Boolean!\"\n        created_at: \"DateTime!\"\n      }\n    }\n  }\n\n  resolvers: {\n    cache: true\n    max_depth: 11\n    max_complexity: 323\n  }\n}"
  }
  {
    num: "13241"
    title: "DNS Records"
    description: "DNS zone record entries."
    shapeIndex: 2
    mamlText: "{\n  zone: \"exotic-programme.info\"\n  records: [\n    {\n      type: \"NS\"\n      name: \"*\"\n      value: \"183.17.20.103\"\n      ttl: 86400\n    }\n\n    {\n      type: \"NS\"\n      name: \"mail\"\n      value: \"separate-postbox.net\"\n      ttl: 3600\n    }\n\n    {\n      type: \"MX\"\n      name: \"cdn\"\n      value: \"v=spf1 include:_spf.punctual-roundabout.com ~all\"\n      ttl: 86400\n    }\n\n    {\n      type: \"CNAME\"\n      name: \"*\"\n      value: \"colorful-electronics.biz\"\n      ttl: 86400\n    }\n\n    {\n      type: \"TXT\"\n      name: \"mail\"\n      value: \"179.48.232.94\"\n      ttl: 86400\n    }\n\n    {\n      type: \"MX\"\n      name: \"api\"\n      value: \"v=spf1 include:_spf.nautical-casket.info ~all\"\n      ttl: 86400\n    }\n\n    {\n      type: \"NS\"\n      name: \"staging\"\n      value: \"purple-receptor.name\"\n      ttl: 86400\n    }\n  ]\n}"
  }
  {
    num: "13242"
    title: "API Routes"
    description: "REST API route definitions."
    shapeIndex: 2
    mamlText: "{\n  base_url: \"/api/v1\"\n  routes: [\n    {\n      method: \"PATCH\"\n      path: \"/orders\"\n      handler: \"updateUsers\"\n      auth: true\n    }\n\n    {\n      method: \"GET\"\n      path: \"/posts\"\n      handler: \"createOrders\"\n      auth: true\n    }\n\n    {\n      method: \"GET\"\n      path: \"/orders\"\n      handler: \"createProducts\"\n      auth: true\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/comments/:id\"\n      handler: \"updateOrders\"\n      auth: true\n    }\n\n    {\n      method: \"GET\"\n      path: \"/products/:id\"\n      handler: \"createProducts\"\n      auth: true\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/products\"\n      handler: \"updatePosts\"\n      auth: true\n    }\n  ]\n}"
  }
  {
    num: "13243"
    title: "Environment Vars"
    description: "Environment variable definitions."
    shapeIndex: 2
    mamlText: "{\n  app: \"fibre\"\n  variables: [\n    {\n      name: \"REDIS_URL\"\n      required: true\n      secret: true\n      default: \"supplanto\"\n    }\n\n    {\n      name: \"SENTRY_DSN\"\n      required: true\n      secret: false\n      default: null\n    }\n\n    {\n      name: \"SENTRY_DSN\"\n      required: true\n      secret: false\n      default: \"adulescens\"\n    }\n\n    {\n      name: \"API_KEY\"\n      required: false\n      secret: true\n      default: null\n    }\n\n    {\n      name: \"SMTP_PASSWORD\"\n      required: false\n      secret: true\n      default: \"pecco\"\n    }\n\n    {\n      name: \"JWT_SECRET\"\n      required: true\n      secret: true\n      default: \"voluptate\"\n    }\n  ]\n}"
  }
  {
    num: "13244"
    title: "Cron Jobs"
    description: "Scheduled task definitions."
    shapeIndex: 2
    mamlText: "{\n  timezone: \"America/New_York\"\n  jobs: [\n    {\n      name: \"rotate-logs\"\n      schedule: \"0 2 * * 0\"\n      command: \"python manage.py report\"\n      enabled: true\n    }\n\n    {\n      name: \"cleanup-temp\"\n      schedule: \"0 2 * * 0\"\n      command: \"python manage.py report\"\n      enabled: false\n    }\n\n    {\n      name: \"cleanup-temp\"\n      schedule: \"*/15 * * * *\"\n      command: \"node scripts/cleanup.js\"\n      enabled: true\n    }\n  ]\n}"
  }
  {
    num: "13245"
    title: "Sprint Board"
