    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 29\"\n  tasks: [\n    {\n      id: \"PDZ9MX\"\n      title: \"The XML sensor is down, index the solid state transmitter so we can generate the CLI array!\"\n      assignee: \"Dr. Dock Brakus\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 3\n    }\n\n    {\n      id: \"AJ5TET\"\n      title: \"I'll bypass the digital XML matrix, that should bus the SMS sensor!\"\n      assignee: \"Martha Moen\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 2\n    }\n\n    {\n      id: \"AVZUCB\"\n      title: \"You can't parse the transmitter without synthesizing the open-source THX feed!\"\n      assignee: \"Mallie Ledner\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 3\n    }\n\n    {\n      id: \"IDDYTU\"\n      title: \"Use the virtual SQL bus, then you can transmit the wireless application!\"\n      assignee: \"Francesco Koss MD\"\n      priority: \"low\"\n      status: \"review\"\n      points: 2\n    }\n\n    {\n      id: \"CZEFZP\"\n      title: \"Try to quantify the DRAM firewall, maybe it will bypass the mobile port!\"\n      assignee: \"Rodger Kassulke-Collins\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 8\n    }\n\n    {\n      id: \"KOR05N\"\n      title: \"If we connect the program, we can get to the DRAM panel through the bluetooth JBOD array!\"\n      assignee: \"Ansel Koch DDS\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 5\n    }\n  ]\n}"
  }
