    description: "Search engine index configuration."
    shapeIndex: 1
    mamlText: "{\n  engine: \"elasticsearch\"\n  connection: {\n    host: \"search.internal:8108\"\n    api_key: \"rXGaWVrAVND4bTNyl5EHdl58ddFG197e\"\n    timeout: 7991\n  }\n\n  # Index settings\n  index: {\n    name: \"babushka\"\n    primary_key: \"id\"\n    searchable: [\n      \"title\"\n      \"description\"\n      \"content\"\n    ]\n    filterable: [\n      \"category\"\n      \"status\"\n      \"date\"\n    ]\n    sortable: [\n      \"date\"\n      \"relevance\"\n    ]\n  }\n\n  synonyms: {\n    js: [\n      \"javascript\"\n      \"ecmascript\"\n    ]\n    ts: [\n      \"typescript\"\n    ]\n  }\n}"
