    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@brisk-quart.net\"\n  subject: \"Vesper theologus claro.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Tristis coruscus tergeo creptio excepturi temeritas debeo accommodo abstergo. Concido suscipit supplanto. Tibi somniculosus teres adsuesco cursus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nAdficio caveo harum vulnus. Sursum derelinquo caelum ustulo. Umquam cunabula pecus taedium velut vehemens comprehendo amicitia cometes.\n\nVisit: {{url}}\n\"\"\"\n}"
