    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 33\"\n  tasks: [\n    {\n      id: \"6LCNNW\"\n      title: \"If we synthesize the interface, we can get to the ADP application through the auxiliary SDD monitor!\"\n      assignee: \"Freda Hane\"\n      priority: \"high\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"AH6SJX\"\n      title: \"Use the redundant SMTP circuit, then you can generate the cross-platform matrix!\"\n      assignee: \"Noel Bernhard\"\n      priority: \"high\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"NA8UVU\"\n      title: \"You can't override the bus without indexing the redundant HTTP pixel!\"\n      assignee: \"Juan Satterfield\"\n      priority: \"high\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"KXYEFM\"\n      title: \"We need to calculate the multi-byte DRAM port!\"\n      assignee: \"Mr. Grady Frami\"\n      priority: \"low\"\n      status: \"done\"\n      points: 8\n    }\n  ]\n}"
