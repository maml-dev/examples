    mamlText: "# Email template configuration\n{\n  from: \"noreply@obedient-brush.biz\"\n  subject: \"Tener vorax peccatus ascit.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Velum calcar universe virtus ter vacuus qui amiculum denego aperiam. Vestigium ustilo fugiat consequatur averto tutis una supra desolo adeptio. Canto cibus validus unde unus aranea conforto.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nDedecor iusto vulnus bibo templum ab spero aro taedium. Natus valetudo vorago. Vaco bardus traho summisse voluptates defaeco deorsum totam cavus aetas.\n\nVisit: {{url}}\n\"\"\"\n}"
