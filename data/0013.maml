    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"warped-median.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.warped-median.biz\"\n      \"mx2.warped-median.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.warped-median.biz\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 438\n      per_hour: 5318\n    }\n  }\n}"
