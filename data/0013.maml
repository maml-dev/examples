  {
    num: "13636"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"filesystem\"\n    host: \"localhost\"\n    databases: [\n      \"elevation\"\n      \"scaffold\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 12\n    weekly: 7\n    monthly: 10\n  }\n\n  destination: {\n    type: \"gcs\"\n    path: \"/mnt/backups/overload\"\n    encryption: true\n    compression: \"gzip\"\n  }\n}"
  }
  {
