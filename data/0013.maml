    shapeIndex: 1
    mamlText: "{\n  provider: \"azure\"\n  region: \"eu-west-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"t3.medium\"\n    count: 4\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 18\n      target_cpu: 53\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 168\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-c7babdf3\"\n    subnet: \"10.215.0.0/16\"\n    public_ip: true\n  }\n}"
