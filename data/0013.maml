    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"granular-noon.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.granular-noon.biz\"\n      \"mx2.granular-noon.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.granular-noon.biz\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 394\n      per_hour: 8044\n    }\n  }\n}"
