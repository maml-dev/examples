    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 13\"\n  tasks: [\n    {\n      id: \"AJLSAA\"\n      title: \"The HDD program is down, transmit the mobile panel so we can connect the SSL transmitter!\"\n      assignee: \"Crystal Hickle\"\n      priority: \"high\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"ZKUYXP\"\n      title: \"You can't generate the monitor without transmitting the haptic USB program!\"\n      assignee: \"Frederique Walsh\"\n      priority: \"high\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"ZCYHP2\"\n      title: \"The SCSI array is down, input the bluetooth array so we can back up the SSD feed!\"\n      assignee: \"Carolanne Schumm\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 8\n    }\n\n    {\n      id: \"VWRYIG\"\n      title: \"Try to calculate the DRAM hard drive, maybe it will index the cross-platform system!\"\n      assignee: \"Santos Cartwright\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 1\n    }\n  ]\n}"
