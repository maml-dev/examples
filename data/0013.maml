    mamlText: "# Email template configuration\n{\n  from: \"noreply@live-curl.info\"\n  subject: \"Adflicto armarium ustilo urbanus nemo supplanto.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Succedo valeo calcar debilito celebrer. Nostrum alii delinquo. Coma ubi vallum tam copia.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nFugiat voveo ipsum neque angulus amplitudo coerceo concedo. Aranea adhuc vae atrox labore aveho desidero. Tribuo deprecator desipio eius adfero thesaurus color contigo vesper.\n\nVisit: {{url}}\n\"\"\"\n}"
