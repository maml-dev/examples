    mamlText: "# Email template configuration\n{\n  from: \"noreply@oval-forage.name\"\n  subject: \"Accendo cuius verumtamen acervus beneficium hic.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Cervus turpis aut bos magni vestrum quod. Comitatus audio tremo tendo ea currus. Cuppedia sint cum venia concedo depopulo.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nCenaculum explicabo crur caste incidunt subvenio varietas placeat. Aestivus deinde titulus bellicus. Aufero speculum adopto temporibus sonitus conculco.\n\nVisit: {{url}}\n\"\"\"\n}"
