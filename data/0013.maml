    mamlText: "{\n  source: {\n    type: \"mysql\"\n    host: \"localhost\"\n    databases: [\n      \"exasperation\"\n      \"knickers\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 12\n    weekly: 7\n    monthly: 15\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"s3://backups-bob\"\n    encryption: true\n    compression: \"zstd\"\n  }\n}"
