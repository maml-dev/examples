  {
    num: "11121"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mysql\"\n    host: \"localhost\"\n    databases: [\n      \"interchange\"\n      \"couch\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 7\n    weekly: 10\n    monthly: 6\n  }\n\n  destination: {\n    type: \"local\"\n    path: \"s3://backups-fort\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
  }
  {
