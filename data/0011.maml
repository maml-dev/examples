    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@lined-pants.name\"\n  subject: \"Iste subiungo chirographum adinventitias.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Contego accusator ustilo strenuus chirographum viduo. Baiulus arma adeo velum speculum turba cupressus. Turbo subnecto commodo cernuus derelinquo perspiciatis abscido aliquid.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nNobis depopulo derideo vel undique accedo contigo texo. Magni angulus spoliatio cura vitae. Modi est compello creptio atrocitas sapiente.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
