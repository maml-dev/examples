    mamlText: "{\n  name: \"switch-hooks\"\n  secret: \"NaUVGHZeLyh7aBoGoxd7CvMe2paP4lS5\"\n  endpoints: [\n    {\n      url: \"https://antique-effector.org/webhook\"\n      events: [\n        \"create\"\n        \"update\"\n        \"delete\"\n      ]\n      active: true\n    }\n\n    {\n      url: \"https://easy-wilderness.net/callback\"\n      events: [\n        \"payment.success\"\n        \"payment.failed\"\n      ]\n      active: true\n    }\n  ]\n\n  retry: {\n    max_attempts: 9\n    backoff: \"linear\"\n    interval: 19 # seconds\n  }\n  timeout: 14 # seconds\n}"
