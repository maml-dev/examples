    description: "Role-based access control definitions."
    shapeIndex: 2
    mamlText: "{\n  roles: [\n    {\n      name: \"viewer\"\n      permissions: [\n        \"export_data\"\n        \"read\"\n      ]\n      max_seats: 24\n    }\n\n    {\n      name: \"viewer\"\n      permissions: [\n        \"manage_billing\"\n        \"manage_users\"\n        \"view_analytics\"\n        \"delete\"\n        \"read\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"billing\"\n      permissions: [\n        \"write\"\n        \"view_analytics\"\n      ]\n      max_seats: 35\n    }\n\n    {\n      name: \"support\"\n      permissions: [\n        \"write\"\n        \"manage_users\"\n        \"delete\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"viewer\"\n      permissions: [\n        \"view_analytics\"\n        \"manage_billing\"\n        \"manage_users\"\n      ]\n      max_seats: 27\n    }\n\n    {\n      name: \"editor\"\n      permissions: [\n        \"write\"\n        \"export_data\"\n        \"delete\"\n        \"view_analytics\"\n        \"manage_billing\"\n      ]\n      max_seats: 36\n    }\n  ]\n}"
