    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"firm-traffic.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.firm-traffic.info\"\n      \"mx2.firm-traffic.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.firm-traffic.info\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 439\n      per_hour: 6020\n    }\n  }\n}"
  }
