  {
    num: "11562"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Jackfruit Carnitas\"\n  servings: 3\n  prep_time: \"38 minutes\"\n  cook_time: \"68 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 oz sunflower oil\"\n    \"3 oz chilli pepper\"\n    \"3 tsp avocado\"\n    \"1 tsp radish\"\n    \"1 oz bran\"\n    \"4 lbs basil basmati rice\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A simple grapefruit pie. No fancy stuff. Just pie.\"\n    \"Tenderly braised salmon in a rich rice paper and asparagus sauce, served with a side of creamy spinach.\"\n    \"A robust juicy stew featuring Malaysian Indian flavors, loaded with fresh meat, salty vegetables, and a delicious, salty broth.\"\n    \"A slow-roasted Little Gull with a creamy, creamy exterior. Stuffed with nashi pear and covered in kiwi fruit sauce. Sides with capers puree and wild sweet potato.\"\n    \"A succulent quail steak, encased in a salty caraway seed crust, served with a side of baharat mashed arugula.\"\n    \"88-day aged beef steak, with choice of 3 sides.\"\n    \"Grilled lamb kebabs, marinated in Peranakan spices and served with a fresh squash and bush tomato salad.\"\n  ]\n\n  nutrition: {\n    calories: 687\n    protein: \"21g\"\n    carbs: \"34g\"\n    fat: \"19g\"\n  }\n}"
  }
