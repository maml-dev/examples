    mamlText: "{\n  title: \"Seafood Paella\"\n  servings: 3\n  prep_time: \"57 minutes\"\n  cook_time: \"89 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 cups kokam\"\n    \"3 tsp zucchini\"\n    \"2 tbsp green beans\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A classic pie filled with delicious kangaroo and savory oat flour, baked in a rich pastry crust and topped with a golden-brown lattice.\"\n    \"Grilled beef kebabs, marinated in Malaysian Chinese spices and served with a fresh sweet potato and orange salad.\"\n    \"Juicy chicken, grilled to your liking and drizzled with a bold bbq sauce, served alongside roasted parsnip.\"\n    \"A robust tangy stew featuring Peruvian flavors, loaded with crispy meat, zesty vegetables, and a delicious, creamy broth.\"\n  ]\n\n  nutrition: {\n    calories: 406\n    protein: \"6g\"\n    carbs: \"26g\"\n    fat: \"13g\"\n  }\n}"
