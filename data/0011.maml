    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 10\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 9\n      target_cpu: 54\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 272\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-68adb2b5\"\n    subnet: \"10.137.0.0/16\"\n    public_ip: false\n  }\n}"
