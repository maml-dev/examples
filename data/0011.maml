  {
    num: "11627"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"filesystem\"\n    host: \"db.internal\"\n    databases: [\n      \"heartache\"\n      \"loaf\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 13\n    weekly: 11\n    monthly: 13\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"/mnt/backups/brush\"\n    encryption: true\n    compression: \"zstd\"\n  }\n}"
  }
