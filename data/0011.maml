    mamlText: "# Email template configuration\n{\n  from: \"noreply@well-groomed-translation.name\"\n  subject: \"Acquiro accommodo advoco alveus decor.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Beatae perferendis clibanus suggero sodalitas subnecto iste depulso vinculum. Vomer baiulus denique labore itaque coadunatio solitudo tracto voco. Desino adhuc cultura.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nCalcar cubitum asperiores perspiciatis inventore beneficium perspiciatis absorbeo comes. Annus virtus ascisco usitas caste depromo addo vere constans abstergo. Conor vado vere maiores terror.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
