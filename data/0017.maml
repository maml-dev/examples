    mamlText: "{\n  base_url: \"/api/v2\"\n  routes: [\n    {\n      method: \"DELETE\"\n      path: \"/products/:id\"\n      handler: \"getUsers\"\n      auth: true\n    }\n\n    {\n      method: \"GET\"\n      path: \"/users\"\n      handler: \"listUsers\"\n      auth: true\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/comments\"\n      handler: \"createUsers\"\n      auth: false\n    }\n\n    {\n      method: \"POST\"\n      path: \"/orders\"\n      handler: \"createOrders\"\n      auth: false\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/users/:id\"\n      handler: \"updatePosts\"\n      auth: true\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/comments/:id\"\n      handler: \"listProducts\"\n      auth: true\n    }\n  ]\n}"
  }
  {
