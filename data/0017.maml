    mamlText: "{\n  domain: \"supportive-kettledrum.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.supportive-kettledrum.biz\"\n      \"mx2.supportive-kettledrum.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.supportive-kettledrum.biz\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 142\n      per_hour: 6854\n    }\n  }\n}"
  }
