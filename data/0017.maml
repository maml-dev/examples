    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"postgresql\"\n    host: \"localhost\"\n    databases: [\n      \"galoshes\"\n      \"equal\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 9\n    weekly: 8\n    monthly: 10\n  }\n\n  destination: {\n    type: \"sftp\"\n    path: \"/mnt/backups/overload\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
