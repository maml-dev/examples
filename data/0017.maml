    mamlText: "{\n  engine: \"algolia\"\n  connection: {\n    host: \"search.internal:7700\"\n    api_key: \"cwVKGm9ubtvdifjXek11gBPtQmKQiRb8\"\n    timeout: 1955\n  }\n\n  # Index settings\n  index: {\n    name: \"impact\"\n    primary_key: \"id\"\n    searchable: [\n      \"title\"\n      \"description\"\n      \"content\"\n    ]\n    filterable: [\n      \"category\"\n      \"status\"\n      \"date\"\n    ]\n    sortable: [\n      \"date\"\n      \"relevance\"\n    ]\n  }\n\n  synonyms: {\n    js: [\n      \"javascript\"\n      \"ecmascript\"\n    ]\n    ts: [\n      \"typescript\"\n    ]\n  }\n}"
