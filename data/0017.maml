    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"db.internal\"\n    databases: [\n      \"hydrolyse\"\n      \"viability\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 9\n    weekly: 9\n    monthly: 10\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"/mnt/backups/sport\"\n    encryption: true\n    compression: \"gzip\"\n  }\n}"
