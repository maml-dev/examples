    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"greedy-mainstream.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.greedy-mainstream.info\"\n      \"mx2.greedy-mainstream.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.greedy-mainstream.info\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 197\n      per_hour: 5123\n    }\n  }\n}"
