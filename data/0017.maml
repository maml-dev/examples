  {
    num: "17071"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Pasta With Tomato And Basil\"\n  servings: 8\n  prep_time: \"24 minutes\"\n  cook_time: \"110 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 pieces corella pear\"\n    \"4 pieces feta\"\n    \"3 tbsp pumpkin\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Savor the rich flavors of moist carrot, complemented by apricot and sweet laurel.\"\n    \"Fresh mixed greens tossed with parsley-rubbed rabbit, bok choy, and a light dressing.\"\n    \"Three rice flour with carrot, bok choy, asian greens, dried chinese broccoli and rosemary. With a side of baked passionfruit, and your choice of brie or tamarillo.\"\n    \"A classic pie filled with delicious ostrich and juicy liver, baked in a tangy pastry crust and topped with a golden-brown lattice.\"\n    \"Fresh mixed greens tossed with chilli pepper-rubbed pork, fresh chillies, and a light dressing.\"\n    \"Baked kidney beans-stuffed turkey, seasoned with sage and zesty herbs, accompanied by roasted kale medley.\"\n    \"A robust salty stew featuring Mughal flavors, loaded with crispy meat, savory vegetables, and a bitter, savory broth.\"\n  ]\n\n  nutrition: {\n    calories: 400\n    protein: \"41g\"\n    carbs: \"17g\"\n    fat: \"25g\"\n  }\n}"
  }
