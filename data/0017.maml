    mamlText: "{\n  domain: \"whirlwind-pressure.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.whirlwind-pressure.biz\"\n      \"mx2.whirlwind-pressure.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.whirlwind-pressure.biz\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 416\n      per_hour: 5375\n    }\n  }\n}"
