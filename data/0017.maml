    shapeIndex: 1
    mamlText: "{\n  domain: \"nocturnal-handle.com\"\n  inbound: {\n    mx_records: [\n      \"mx1.nocturnal-handle.com\"\n      \"mx2.nocturnal-handle.com\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.nocturnal-handle.com\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 372\n      per_hour: 4281\n    }\n  }\n}"
