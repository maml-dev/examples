    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"filesystem\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"pocket-watch\"\n      \"foodstuffs\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 8\n    weekly: 11\n    monthly: 11\n  }\n\n  destination: {\n    type: \"sftp\"\n    path: \"/mnt/backups/agreement\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
  }
