    mamlText: "{\n  provider: \"gcp\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 6\n    auto_scaling: {\n      enabled: true\n      min: 3\n      max: 12\n      target_cpu: 60\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 229\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-c7feaece\"\n    subnet: \"10.114.0.0/16\"\n    public_ip: false\n  }\n}"
