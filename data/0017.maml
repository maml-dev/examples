    mamlText: "{\n  application: \"niches\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: You can't parse the panel without hacking the back-end AI microchip!\n    at /usr/ports/governance_joshingly_that.deploy:253\n    at /home/user/boring_provided_schedule.ogx:264\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPOST /api/netsuke HTTP/1.1\nHost: wasteful-settler.com\nUser-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:131.0) Gecko/20100101 Firefox/132.0\nAccept: application/json\n\"\"\"\n  retention_days: 87\n}"
