    description: "REST API route definitions."
    shapeIndex: 2
    mamlText: "{\n  base_url: \"/api/v3\"\n  routes: [\n    {\n      method: \"DELETE\"\n      path: \"/comments\"\n      handler: \"deleteOrders\"\n      auth: true\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/comments\"\n      handler: \"listOrders\"\n      auth: false\n    }\n\n    {\n      method: \"GET\"\n      path: \"/users\"\n      handler: \"listProducts\"\n      auth: false\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/products/:id\"\n      handler: \"listProducts\"\n      auth: false\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/posts\"\n      handler: \"createOrders\"\n      auth: true\n    }\n  ]\n}"
