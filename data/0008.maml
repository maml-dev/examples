    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"monumental-decryption.com\"\n  inbound: {\n    mx_records: [\n      \"mx1.monumental-decryption.com\"\n      \"mx2.monumental-decryption.com\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.monumental-decryption.com\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 253\n      per_hour: 7358\n    }\n  }\n}"
  }
  {
    num: "8128"
    title: "Monitoring Config"
    description: "Application monitoring and alerting setup."
    shapeIndex: 1
    mamlText: "{\n  service: \"functionalities\"\n  # Prometheus metrics\n  metrics: {\n    endpoint: \"/metrics\"\n    interval: 15 # seconds\n    labels: {\n      env: \"prod\"\n      region: \"ap-south\"\n      team: \"music\"\n    }\n  }\n\n  # Alert thresholds\n  alerts: {\n    cpu_threshold: 72\n    memory_threshold: 75\n    latency_p99_ms: 418\n    error_rate: 0.05\n    notification: {\n      channel: \"#oncall\"\n      severity: \"info\"\n    }\n  }\n}"
  }
  {
