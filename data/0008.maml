    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 26\"\n  tasks: [\n    {\n      id: \"CVC0CM\"\n      title: \"The COM matrix is down, compress the mobile pixel so we can reboot the USB panel!\"\n      assignee: \"Myrtie Hauck\"\n      priority: \"critical\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"OB4DNA\"\n      title: \"I'll parse the 1080p VGA card, that should program the SSD hard drive!\"\n      assignee: \"Flossie Beahan DVM\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"EYLMTA\"\n      title: \"If we reboot the port, we can get to the TCP hard drive through the virtual HDD program!\"\n      assignee: \"Letitia Murphy\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"Y6KDXX\"\n      title: \"transmitting the bus won't do anything, we need to reboot the haptic DNS array!\"\n      assignee: \"Andrea Baumbach\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 2\n    }\n\n    {\n      id: \"CDXT7Z\"\n      title: \"The ASCII feed is down, navigate the redundant bandwidth so we can transmit the SSL sensor!\"\n      assignee: \"Bernard Lubowitz\"\n      priority: \"medium\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"W1W6YN\"\n      title: \"The THX transmitter is down, index the digital card so we can compress the SQL port!\"\n      assignee: \"Mckenna Doyle\"\n      priority: \"critical\"\n      status: \"review\"\n      points: 5\n    }\n  ]\n}"
  }
