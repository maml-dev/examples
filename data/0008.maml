    description: "Design system theme configuration."
    shapeIndex: 1
    mamlText: "{\n  name: \"unhealthy Theme\"\n  # Color palette\n  colors: {\n    primary: \"#228eba\"\n    secondary: \"#3f77ec\"\n    accent: \"#b613f0\"\n    background: \"#f8f9fa\"\n    text: \"#e6edf3\"\n\n    error: \"#dc3545\"\n    warning: \"#ffc107\"\n    success: \"#28a745\"\n  }\n\n  # Typography\n  typography: {\n    font_family: \"Inter, sans-serif\"\n    base_size: 18\n    line_height: 1.6\n    headings: {\n      font_family: \"Inter, sans-serif\"\n      weight: 800\n    }\n  }\n\n  spacing: {\n    unit: 8\n    scale: [\n      0\n      4\n      8\n      16\n      24\n      32\n      48\n    ]\n  }\n  border_radius: 8\n}"
  }
  {
