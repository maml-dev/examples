  {
    num: "8277"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Buddha Bowl\"\n  servings: 8\n  prep_time: \"16 minutes\"\n  cook_time: \"119 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 cups sea salt\"\n    \"3 tsp red cabbage\"\n    \"3 cups cacao\"\n    \"1 tbsp grape seed oil\"\n    \"3 tsp nasturtium\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Juicy kangaroo, grilled to your liking and drizzled with a bold balti stir fry mix sauce, served alongside roasted okra.\"\n    \"Fresh mixed greens tossed with poppy seed-rubbed duck, red pepper, and a light dressing.\"\n    \"A slow-roasted Red-whiskered Bulbul with a zesty, salty exterior. Stuffed with kiwiberry and covered in lemon sauce. Sides with cabbage puree and wild english spinach.\"\n    \"Savor the rich flavors of moist cucumber, complemented by bush tomato and fennel seed.\"\n    \"A special blue barramundi from Tanzania. To support the strong flavor it is sided with a tablespoon of mustard.\"\n    \"A slow-roasted Sharp-tailed Sandpiper with a zesty, creamy exterior. Stuffed with mangosteen and covered in strawberry sauce. Sides with broccoli puree and wild leeks.\"\n    \"Tenderly braised beef in a rich vanilla and asparagus sauce, served with a side of creamy english spinach.\"\n  ]\n\n  nutrition: {\n    calories: 719\n    protein: \"36g\"\n    carbs: \"26g\"\n    fat: \"30g\"\n  }\n}"
  }
