    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"aws\"\n  region: \"us-west-2\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 5\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 6\n      target_cpu: 70\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 322\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-3381c57d\"\n    subnet: \"10.80.0.0/16\"\n    public_ip: false\n  }\n}"
