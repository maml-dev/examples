  {
    num: "8430"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"postgresql\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"cantaloupe\"\n      \"polarisation\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 14\n    weekly: 8\n    monthly: 14\n  }\n\n  destination: {\n    type: \"sftp\"\n    path: \"/mnt/backups/lyre\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
  }
