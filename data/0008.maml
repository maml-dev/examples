    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 35\"\n  tasks: [\n    {\n      id: \"8FKI4D\"\n      title: \"You can't transmit the monitor without transmitting the virtual SCSI microchip!\"\n      assignee: \"Porter Thiel\"\n      priority: \"high\"\n      status: \"done\"\n      points: 3\n    }\n\n    {\n      id: \"XCKYG4\"\n      title: \"Use the neural SAS alarm, then you can hack the 1080p panel!\"\n      assignee: \"Mr. Jedidiah Schulist\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 5\n    }\n\n    {\n      id: \"EE1EYK\"\n      title: \"The SMS monitor is down, index the haptic hard drive so we can hack the IB transmitter!\"\n      assignee: \"Magdalen Strosin\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 8\n    }\n\n    {\n      id: \"PHDOTM\"\n      title: \"Use the back-end PCI application, then you can navigate the online circuit!\"\n      assignee: \"Olive Yundt\"\n      priority: \"medium\"\n      status: \"review\"\n      points: 8\n    }\n\n    {\n      id: \"UYIPDP\"\n      title: \"If we synthesize the array, we can get to the THX bandwidth through the 1080p HDD protocol!\"\n      assignee: \"Ted Champlin\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 2\n    }\n\n    {\n      id: \"VTMDIZ\"\n      title: \"The CLI panel is down, bypass the open-source transmitter so we can parse the THX bus!\"\n      assignee: \"Darlene Smith\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 1\n    }\n  ]\n}"
  }
