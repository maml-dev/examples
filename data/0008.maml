    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Spicy Pineapple And Snowpea Sprouts Salad\"\n  servings: 3\n  prep_time: \"46 minutes\"\n  cook_time: \"24 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 cups kiwi berries\"\n    \"1 tsp sugar\"\n    \"1 cups pumpkin\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Savor the rich flavors of creamy green beans, complemented by mandarin and balti stir fry mix.\"\n    \"Our delicious venison, slow-cooked to perfection, accompanied by steamed cauliflower and a rich, savory gravy.\"\n    \"A succulent lamb steak, encased in a spicy nutmeg crust, served with a side of fenugreek mashed okra.\"\n    \"Crispy fried rabbit bites, seasoned with lemon grass and served with a tangy custard apple dipping sauce.\"\n    \"An exquisite okra dish, paired with oat flour and a hint of lemon pepper.\"\n  ]\n\n  nutrition: {\n    calories: 178\n    protein: \"22g\"\n    carbs: \"85g\"\n    fat: \"36g\"\n  }\n}"
  }
