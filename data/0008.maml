  {
    num: "8365"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Pierogi\"\n  servings: 6\n  prep_time: \"28 minutes\"\n  cook_time: \"45 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 tsp pear juice\"\n    \"1 cups molasses\"\n    \"4 lbs elderberry\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A sweet carob carrot creation, seasoned with asafoetida and dill, showcasing the best of plant-based cuisine.\"\n    \"Hearty molasses and quail stew, slow-cooked with celery and beans for a comforting, flavorful meal.\"\n    \"Hearty turnips and crocodile stew, slow-cooked with mace and leeks for a comforting, flavorful meal.\"\n    \"Juicy lamb, grilled to your liking and drizzled with a bold amchoor sauce, served alongside roasted jicama.\"\n    \"A robust savory stew featuring Zanzibari flavors, loaded with moist meat, savory vegetables, and a bitter, rich broth.\"\n    \"A succulent emu steak, encased in a salty bay leaves crust, served with a side of pepper mashed jerusalem artichoke.\"\n    \"Three leeks with jerusalem artichoke, zucchini, eggplant, cauliflower and brie. With a side of baked honeydew melon, and your choice of banana or bush tomato.\"\n  ]\n\n  nutrition: {\n    calories: 635\n    protein: \"7g\"\n    carbs: \"26g\"\n    fat: \"24g\"\n  }\n}"
  }
