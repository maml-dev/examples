    mamlText: "{\n  engine: \"elasticsearch\"\n  connection: {\n    host: \"search.internal:8108\"\n    api_key: \"0qDGtBgEwP4wYyp9bCJMCQAYMztnMxwn\"\n    timeout: 4987\n  }\n\n  # Index settings\n  index: {\n    name: \"summary\"\n    primary_key: \"id\"\n    searchable: [\n      \"title\"\n      \"description\"\n      \"content\"\n    ]\n    filterable: [\n      \"category\"\n      \"status\"\n      \"date\"\n    ]\n    sortable: [\n      \"date\"\n      \"relevance\"\n    ]\n  }\n\n  synonyms: {\n    js: [\n      \"javascript\"\n      \"ecmascript\"\n    ]\n    ts: [\n      \"typescript\"\n    ]\n  }\n}"
