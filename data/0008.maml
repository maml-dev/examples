    shapeIndex: 4
    mamlText: "{\n  application: \"e-commerce\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: If we program the card, we can get to the TLS bus through the bluetooth SSL interface!\n    at /etc/defaults/before.bz:370\n    at /usr/local/bin/simple_sarcastic_how.msp:176\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nGET /api/tomatillo HTTP/1.1\nHost: secondary-archaeology.org\nUser-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:87.0) Gecko/20100101 Firefox/115.0\nAccept: application/json\n\"\"\"\n  retention_days: 82\n}"
