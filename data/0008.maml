    mamlText: "{\n  application: \"functionalities\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: The ASCII sensor is down, transmit the online circuit so we can calculate the CSS system!\n    at /media/yuck_buzzing.spx:48\n    at /usr/X11R6/boo_forenenst.xlw:61\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPOST /api/punctuation HTTP/1.1\nHost: punctual-outrun.org\nUser-Agent: Mozilla/5.0 (compatible; MSIE 7.0; Windows NT 6.1; Trident/6.0)\nAccept: application/json\n\"\"\"\n  retention_days: 88\n}"
