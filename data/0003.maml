  {
    num: "3675"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Fish And Chips\"\n  servings: 4\n  prep_time: \"40 minutes\"\n  cook_time: \"30 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 lbs kangaroo\"\n    \"3 cups alfalfa\"\n    \"2 oz morwong\"\n    \"4 oz brazil nut\"\n    \"3 lbs sage\"\n  ]\n\n  # Instructions\n  steps: [\n    \"An exquisite emu roast, infused with the essence of butternut pumpkin, slow-roasted to bring out its natural flavors and served with a side of creamy asian greens\"\n    \"A heartwarming Ethiopian soup, featuring fresh chinese five spice and an aromatic blend of traditional spices.\"\n    \"Crispy fried kangaroo bites, seasoned with amchoor and served with a tangy juniper berry dipping sauce.\"\n    \"Tenderly braised pigeon in a rich onion seed and swiss chard sauce, served with a side of creamy kohlrabi.\"\n    \"Savor the rich flavors of crunchy leeks, complemented by aubergine and oregano.\"\n    \"An exquisite venison roast, infused with the essence of fingerlime, slow-roasted to bring out its natural flavors and served with a side of creamy okra\"\n  ]\n\n  nutrition: {\n    calories: 520\n    protein: \"46g\"\n    carbs: \"61g\"\n    fat: \"26g\"\n  }\n}"
  }
