    mamlText: "# Email template configuration\n{\n  from: \"noreply@limping-schedule.info\"\n  subject: \"Candidus copiose curia cicuta.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Quas ara utpote aspicio ventus beatus. Terror defessus vorago cohaero veniam auxilium ascit sulum facere. Sopor caelum cilicium curo amor tandem blanditiis subito quo.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nAmicitia agnosco stips stipes viridis. Aggredior abutor stipes assentator dens amitto cupressus cohors. Vallum asperiores arbor abbas absque sonitus deludo delectatio admitto enim.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
