  {
    num: "3572"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Peanut Noodles\"\n  servings: 6\n  prep_time: \"58 minutes\"\n  cook_time: \"43 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 lbs green tea noodles\"\n    \"4 pieces quince\"\n    \"1 pieces oyster mushrooms\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Tenderly braised pork in a rich lemon pepper and sweet potato sauce, served with a side of creamy arugula.\"\n    \"A robust delicious stew featuring Zambian flavors, loaded with fresh meat, savory vegetables, and a creamy, creamy broth.\"\n    \"A simple apricot pie. No fancy stuff. Just pie.\"\n    \"A delightful tart combining golden cornichons and sweet snowpea, set in a buttery pastry shell and finished with a hint of poudre de colombo.\"\n    \"Tenderly braised venison in a rich celery and brussels sprouts sauce, served with a side of creamy cornichons.\"\n  ]\n\n  nutrition: {\n    calories: 488\n    protein: \"18g\"\n    carbs: \"75g\"\n    fat: \"21g\"\n  }\n}"
  }
  {
    num: "3573"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Poudre De Colombo-crusted Venison\"\n  servings: 8\n  prep_time: \"43 minutes\"\n  cook_time: \"95 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 tbsp licorice\"\n    \"1 cups aubergine\"\n    \"2 tsp pear juice\"\n    \"1 tsp oranges\"\n    \"4 lbs elderberry\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Crispy fried venison bites, seasoned with cassia and served with a tangy blood orange dipping sauce.\"\n    \"A delightful tart combining crunchy turnips and sweet rockmelon, set in a buttery pastry shell and finished with a hint of thyme.\"\n    \"Crispy fried kangaroo bites, seasoned with pepper and served with a tangy aubergine dipping sauce.\"\n    \"Three pistachio nut with broccolini, peas, butternut lettuce, okra and olives. With a side of baked lime, and your choice of currants or hijiki.\"\n    \"Juicy venison, grilled to your liking and drizzled with a bold turmeric sauce, served alongside roasted dried chinese broccoli.\"\n    \"Tenderly braised ostrich in a rich cayenne pepper and chilli pepper sauce, served with a side of creamy broccolini.\"\n  ]\n\n  nutrition: {\n    calories: 442\n    protein: \"26g\"\n    carbs: \"34g\"\n    fat: \"11g\"\n  }\n}"
  }
