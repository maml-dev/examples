    shapeIndex: 3
    mamlText: "{\n  title: \"Dapifer conitor deludo torrens agnitio alienus.\"\n  slug: \"decet-repellat-comitatus\"\n  author: {\n    name: \"Candice Ritchie\"\n    avatar: \"https://avatars.githubusercontent.com/u/16103629\"\n    bio: \"exploration junkie, parent\"\n  }\n  date: \"2026-03-22\"\n  tags: [\n    \"chiffonier\"\n    \"repeat\"\n    \"injunction\"\n  ]\n\n  published: false\n  reading_time: \"20 min\"\n  summary: \"Aetas officiis stipes ustulo comprehendo. Vesica temeritas numquam ambitus vis vomica terror cubo similique. Caelum xiphias turbo adsuesco depono aveho considero.\"\n}"
