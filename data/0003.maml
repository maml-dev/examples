    mamlText: "# Lecklace Changelog\n{\n  project: \"swath\"\n  releases: [\n    {\n      version: \"6.5.1\"\n      date: \"2026-04-07\"\n      notes: \"\"\"\nAdded:\n- compress open-source pixel\n- connect digital interface\n\nFixed:\n- transmit optical panel\n\"\"\"\n    }\n\n    {\n      version: \"6.16.18\"\n      date: \"2026-03-30\"\n      notes: \"\"\"\nChanged:\n- connect digital interface\n\nRemoved:\n- hack neural panel\n\"\"\"\n    }\n\n    {\n      version: \"1.10.19\"\n      date: \"2025-12-15\"\n      notes: \"\"\"\nInitial release:\n- copy back-end program\n- parse multi-byte circuit\n- navigate mobile protocol\n\"\"\"\n    }\n  ]\n}"
