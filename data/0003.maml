    mamlText: "{\n  title: \"Claustrum ab conicio vomica vehemens vulgaris carbo.\"\n  slug: \"degenero-vulgaris-creator\"\n  author: {\n    name: \"Ms. Joshuah Lebsack-Christiansen\"\n    avatar: \"https://avatars.githubusercontent.com/u/5293155\"\n    bio: \"inventor, engineer, streamer\"\n  }\n  date: \"2026-02-12\"\n  tags: [\n    \"violin\"\n    \"gripper\"\n    \"popularity\"\n  ]\n\n  published: true\n  reading_time: \"7 min\"\n  summary: \"Aliqua universe comminor vitiosus temeritas vesper. Sumptus inventore saepe teres crepusculum deserunt. Amplus animadverto concedo concedo.\"\n}"
