    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@spotless-management.com\"\n  subject: \"Vinculum nostrum aperiam.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Stillicidium amiculum tremo thema stips. Ullam conventus eaque. Antea dolore tubineus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nPossimus nemo suffoco sustineo uter beatae aveho tactus. Synagoga vapulus repellendus conservo terminatio victus. Suffragium coniuratio tempora conculco dolores clementia.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
