    description: "Authentication and authorization settings."
    shapeIndex: 1
    mamlText: "{\n  provider: \"jwt\"\n  # Token settings\n  jwt: {\n    secret_key: \"0AYOdAHGA2gke1iaGwhJ8Mvj6es215Zf\"\n    algorithm: \"RS256\"\n    expiry: \"7d\"\n    refresh_expiry: \"7d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"jHKiL5JOD2tUZg54nQ8ZX0ui\"\n    authorize_url: \"https://auth.familiar-elevator.net/authorize\"\n    token_url: \"https://auth.handy-puritan.net/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"database\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
