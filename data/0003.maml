    mamlText: "# Email template configuration\n{\n  from: \"noreply@windy-resource.com\"\n  subject: \"Audio tametsi vaco umquam.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Alo nihil vitiosus patria delego. Torrens cometes concido adopto iure delectatio denique vorago ustilo. Abscido cariosus architecto assentator termes solum nesciunt cinis statua.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nSum tricesimus concido catena cultellus calculus. Pauper dignissimos abbas uberrime talio bene autus desino spargo tempore. Sublime damnatio quas tenetur caecus vulgivagus patrocinor tamdiu occaecati.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
