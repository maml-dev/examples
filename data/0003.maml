    mamlText: "{\n  display: {\n    resolution: \"3840x2160\"\n    fullscreen: true\n    vsync: true\n    fps_limit: 60\n  }\n\n  graphics: {\n    quality: \"ultra\"\n    shadows: \"low\"\n    anti_aliasing: \"TAA\"\n    render_distance: 9\n    ray_tracing: false\n  }\n\n  audio: {\n    master: 66\n    music: 33\n    sfx: 88\n    voice: 70\n  }\n\n  controls: {\n    sensitivity: 4.7\n    invert_y: false\n    vibration: true\n  }\n}"
