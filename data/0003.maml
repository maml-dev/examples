    mamlText: "{\n  title: \"Vergo solum comparo vesper.\"\n  slug: \"aedificium-veritas-ager\"\n  author: {\n    name: \"Jameson Herzog\"\n    avatar: \"https://cdn.jsdelivr.net/gh/faker-js/assets-person-portrait/female/512/84.jpg\"\n    bio: \"fat junkie, activist\"\n  }\n  date: \"2026-02-26\"\n  tags: [\n    \"coin\"\n    \"place\"\n    \"anticodon\"\n  ]\n\n  published: false\n  reading_time: \"4 min\"\n  summary: \"Id ambulo tremo delego crux. Suus theologus bardus. Sponte astrum centum fugit defaeco.\"\n}"
  }
