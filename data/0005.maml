    mamlText: "{\n  sprint: \"Sprint 24\"\n  tasks: [\n    {\n      id: \"DIITSO\"\n      title: \"Use the virtual HDD port, then you can input the back-end hard drive!\"\n      assignee: \"Ross Stroman\"\n      priority: \"medium\"\n      status: \"todo\"\n      points: 13\n    }\n\n    {\n      id: \"LJKDK0\"\n      title: \"The SCSI microchip is down, connect the wireless transmitter so we can navigate the AGP capacitor!\"\n      assignee: \"Vivian Buckridge\"\n      priority: \"high\"\n      status: \"in_progress\"\n      points: 2\n    }\n\n    {\n      id: \"S5EN9H\"\n      title: \"I'll hack the redundant UDP microchip, that should firewall the SQL feed!\"\n      assignee: \"Gustave Emard\"\n      priority: \"high\"\n      status: \"done\"\n      points: 2\n    }\n\n    {\n      id: \"PRCMRN\"\n      title: \"Try to input the JSON array, maybe it will back up the redundant transmitter!\"\n      assignee: \"Uriah Turcotte-Sauer\"\n      priority: \"low\"\n      status: \"review\"\n      points: 8\n    }\n\n    {\n      id: \"FS4YWU\"\n      title: \"I'll override the bluetooth XSS sensor, that should driver the ASCII bus!\"\n      assignee: \"Andy Purdy\"\n      priority: \"high\"\n      status: \"done\"\n      points: 1\n    }\n\n    {\n      id: \"GSPPGN\"\n      title: \"If we hack the transmitter, we can get to the USB bus through the redundant JSON alarm!\"\n      assignee: \"Homer Hansen DVM\"\n      priority: \"low\"\n      status: \"done\"\n      points: 5\n    }\n  ]\n}"
