    shapeIndex: 1
    mamlText: "{\n  domain: \"stable-fellow.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.stable-fellow.org\"\n      \"mx2.stable-fellow.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.stable-fellow.org\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 337\n      per_hour: 2859\n    }\n  }\n}"
