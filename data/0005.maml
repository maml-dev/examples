    mamlText: "{\n  title: \"Creamy Pigeon With Broccolini\"\n  servings: 3\n  prep_time: \"26 minutes\"\n  cook_time: \"116 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 pieces kecap manis\"\n    \"2 pieces broccolini\"\n    \"3 tsp pork\"\n    \"4 tbsp sweet chilli sauce\"\n    \"1 tsp yogurt\"\n    \"4 cups rockmelon\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A special sky blue currants from Monaco. To support the strong flavor it is sided with a tablespoon of kaffir leaves.\"\n    \"A robust salty stew featuring Italian flavors, loaded with tender meat, rich vegetables, and a creamy, sour broth.\"\n    \"Fresh sesame seeds with a pinch of five spice, topped by a caramelized feijoa with whipped cream\"\n    \"Baked dashi-stuffed chicken, seasoned with chives and rich herbs, accompanied by roasted radicchio medley.\"\n    \"64-day aged salmon steak, with choice of 3 sides.\"\n    \"Three ham with snowpea sprouts, rhubarb, hijiki, radicchio and anchovies. With a side of baked nashi pear, and your choice of gula melaka or kohlrabi.\"\n    \"A succulent lamb steak, encased in a creamy rosemary crust, served with a side of pot marjoram mashed rhubarb.\"\n  ]\n\n  nutrition: {\n    calories: 545\n    protein: \"9g\"\n    carbs: \"94g\"\n    fat: \"35g\"\n  }\n}"
  }
