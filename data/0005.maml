    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"finding\"\n      \"ad\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 8\n    weekly: 8\n    monthly: 14\n  }\n\n  destination: {\n    type: \"gcs\"\n    path: \"s3://backups-creator\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
  }
  {
