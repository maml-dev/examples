    shapeIndex: 4
    mamlText: "# Thadowbox Changelog\n{\n  project: \"carboxyl\"\n  releases: [\n    {\n      version: \"1.0.2\"\n      date: \"2026-04-29\"\n      notes: \"\"\"\nAdded:\n- back up online pixel\n- compress wireless pixel\n\nFixed:\n- reboot neural panel\n\"\"\"\n    }\n\n    {\n      version: \"8.20.11\"\n      date: \"2026-03-03\"\n      notes: \"\"\"\nChanged:\n- bypass virtual matrix\n\nRemoved:\n- quantify optical firewall\n\"\"\"\n    }\n\n    {\n      version: \"6.1.19\"\n      date: \"2026-02-21\"\n      notes: \"\"\"\nInitial release:\n- hack auxiliary pixel\n- generate haptic application\n- generate solid state capacitor\n\"\"\"\n    }\n  ]\n}"
