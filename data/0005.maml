    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@fat-babushka.org\"\n  subject: \"Tolero cogo curatio adicio.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Valetudo sulum sperno. Depromo constans coniuratio alioqui terreo ancilla solium adstringo benigne reiciendis. Spargo veniam sint consectetur vaco vitae.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nTemporibus verumtamen succurro vos vomer vestrum conor candidus. Carbo crur omnis. Torqueo comedo tepesco vomica deduco speculum.\n\nVisit: {{url}}\n\"\"\"\n}"
