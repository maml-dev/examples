  {
    num: "5475"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Salmon With Strawberry Sauce\"\n  servings: 7\n  prep_time: \"13 minutes\"\n  cook_time: \"82 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 pieces sesame oil\"\n    \"1 lbs cucumber\"\n    \"2 pieces mung beans\"\n    \"2 cups beans\"\n    \"3 cups flat mushrooms\"\n    \"2 lbs poppy seed\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Tender turkey skewers, glazed with a sweet and tangy dried apricot sauce, served over a bed of fragrant jasmine rice.\"\n    \"A classic pie filled with delicious turkey and tender william pear, baked in a golden pastry crust and topped with a golden-brown lattice.\"\n    \"Our fresh lamb, slow-cooked to perfection, accompanied by steamed beans and a rich, savory gravy.\"\n    \"A heartwarming Assyrian soup, featuring fresh freekeh and an aromatic blend of traditional spices.\"\n    \"A special black cottage cheese from South Sudan. To support the strong flavor it is sided with a tablespoon of parsley.\"\n  ]\n\n  nutrition: {\n    calories: 433\n    protein: \"28g\"\n    carbs: \"87g\"\n    fat: \"15g\"\n  }\n}"
  }
