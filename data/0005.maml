    mamlText: "{\n  title: \"Orange Zest-spiced Brussels Sprouts Bowl\"\n  servings: 6\n  prep_time: \"58 minutes\"\n  cook_time: \"94 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 tsp mango\"\n    \"1 tsp polenta\"\n    \"2 tsp tahini\"\n    \"1 lbs fenugreek\"\n    \"3 pieces salmon\"\n    \"1 pieces sultanas\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Baked rosemary-stuffed goose, seasoned with piri piri and tangy herbs, accompanied by roasted bean shoots medley.\"\n    \"A robust salty stew featuring Greek flavors, loaded with tender meat, crispy vegetables, and a delicious, golden broth.\"\n    \"A smoky zucchini creation, seasoned with bay leaves and balti stir fry mix, showcasing the best of plant-based cuisine.\"\n    \"A succulent goose steak, encased in a fresh korma crust, served with a side of sage mashed jerusalem artichoke.\"\n    \"Tender emu skewers, glazed with a sweet and tangy cavalo sauce, served over a bed of fragrant jasmine rice.\"\n    \"A classic pie filled with delicious ostrich and rich cake, baked in a sour pastry crust and topped with a golden-brown lattice.\"\n  ]\n\n  nutrition: {\n    calories: 215\n    protein: \"17g\"\n    carbs: \"55g\"\n    fat: \"37g\"\n  }\n}"
  }
