  {
    num: "5150"
    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 5\"\n  tasks: [\n    {\n      id: \"MIGX4U\"\n      title: \"The ASCII driver is down, calculate the 1080p bus so we can reboot the OCR sensor!\"\n      assignee: \"Sammy Lehner\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 1\n    }\n\n    {\n      id: \"TSZJAW\"\n      title: \"We need to transmit the redundant SCSI protocol!\"\n      assignee: \"Fred Schmeler III\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 8\n    }\n\n    {\n      id: \"HBEHX4\"\n      title: \"I'll calculate the auxiliary IB firewall, that should program the DNS bandwidth!\"\n      assignee: \"Leland Williamson\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"PQAZXA\"\n      title: \"We need to bypass the solid state DRAM port!\"\n      assignee: \"Juan Ondricka\"\n      priority: \"low\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"UJ8OGY\"\n      title: \"The RSS sensor is down, input the bluetooth program so we can generate the XML application!\"\n      assignee: \"Madeline Feest\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 2\n    }\n\n    {\n      id: \"AG7UYP\"\n      title: \"Try to generate the DRAM program, maybe it will program the cross-platform application!\"\n      assignee: \"Allen Mitchell\"\n      priority: \"high\"\n      status: \"done\"\n      points: 1\n    }\n  ]\n}"
  }
