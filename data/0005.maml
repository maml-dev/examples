    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"gcp\"\n  region: \"us-west-2\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 8\n    auto_scaling: {\n      enabled: true\n      min: 2\n      max: 13\n      target_cpu: 59\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 184\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-34beb13f\"\n    subnet: \"10.194.0.0/16\"\n    public_ip: true\n  }\n}"
