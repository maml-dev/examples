    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"scared-stay.name\"\n  inbound: {\n    mx_records: [\n      \"mx1.scared-stay.name\"\n      \"mx2.scared-stay.name\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.scared-stay.name\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 485\n      per_hour: 6643\n    }\n  }\n}"
