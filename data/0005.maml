  {
    num: "5664"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Pork Sausage Roll\"\n  servings: 5\n  prep_time: \"47 minutes\"\n  cook_time: \"38 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 tsp file powder\"\n    \"2 pieces parsley\"\n    \"2 pieces lime leaves\"\n    \"2 tbsp kohlrabi\"\n    \"2 pieces cumin\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Tenderly braised lamb in a rich balti stir fry mix and purple carrot sauce, served with a side of creamy arugula.\"\n    \"Crispy fried pigeon bites, seasoned with zahtar and served with a tangy cherry dipping sauce.\"\n    \"A creamy peas creation, seasoned with fines herbes and cumin, showcasing the best of plant-based cuisine.\"\n    \"Hearty butternut lettuce and pigeon stew, slow-cooked with chervil and endive for a comforting, flavorful meal.\"\n    \"Crispy fried chicken bites, seasoned with herbes de provence and served with a tangy cranberry dipping sauce.\"\n    \"A slow-roasted American Woodcock with a salty, salty exterior. Stuffed with dried apricot and covered in pear sauce. Sides with radicchio puree and wild french eschallots.\"\n  ]\n\n  nutrition: {\n    calories: 159\n    protein: \"42g\"\n    carbs: \"29g\"\n    fat: \"26g\"\n  }\n}"
  }
