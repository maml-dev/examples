    mamlText: "{\n  title: \"Sweet Corella Pear And English Spinach Salad\"\n  servings: 2\n  prep_time: \"28 minutes\"\n  cook_time: \"29 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 tbsp morwong\"\n    \"3 cups muesli\"\n    \"2 tsp buckwheat\"\n    \"3 cups butter\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Our moist lamb, slow-cooked to perfection, accompanied by steamed cabbage and a rich, savory gravy.\"\n    \"A crispy chinese cabbage creation, seasoned with sweet laurel and chilli pepper, showcasing the best of plant-based cuisine.\"\n    \"Fresh mixed greens tossed with thyme-rubbed turkey, turnips, and a light dressing.\"\n  ]\n\n  nutrition: {\n    calories: 708\n    protein: \"34g\"\n    carbs: \"85g\"\n    fat: \"26g\"\n  }\n}"
