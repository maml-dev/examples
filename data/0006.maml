  {
    num: "6132"
    title: "Terraform Resource"
    description: "Infrastructure as code resource definition."
    shapeIndex: 1
    mamlText: "{\n  provider: \"azurerm\"\n  region: \"asia-southeast1\"\n  resources: {\n    # Network\n    vpc: {\n      cidr_block: \"10.144.0.0/16\"\n      enable_dns: true\n      tags: {\n        Name: \"equal-vpc\"\n        Environment: \"production\"\n      }\n    }\n\n    # Compute\n    instance: {\n      ami: \"ami-be5ac829\"\n      type: \"t3.small\"\n      key_name: \"hope-key\"\n      monitoring: true\n      root_volume: {\n        size: 20\n        type: \"io1\"\n        encrypted: true\n      }\n    }\n\n    # Security\n    security_group: {\n      name: \"allow-web\"\n      ingress_port: 443\n      ingress_cidr: \"0.0.0.0/0\"\n    }\n  }\n}"
  }
  {
    num: "6133"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"careless-coordination.net\"\n  inbound: {\n    mx_records: [\n      \"mx1.careless-coordination.net\"\n      \"mx2.careless-coordination.net\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.careless-coordination.net\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 444\n      per_hour: 3425\n    }\n  }\n}"
  }
