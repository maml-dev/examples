    mamlText: "{\n  name: \"airline-climb\"\n  version: \"5.4.11\"\n  description: \"Compatible analyzing hub\"\n\n  keywords: [\n    \"pop\"\n    \"boulevard\"\n    \"comfortable\"\n  ]\n\n  scripts: {\n    dev: \"node server.js --watch\"\n    build: \"tsc && esbuild src/index.ts --bundle --outfile=dist/index.js\"\n    test: \"jest\"\n    lint: \"oxlint\"\n  }\n  engines: {\n    node: \">=18\"\n  }\n\n  author: {\n    name: \"Desiree Walker\"\n    email: \"Julie.Crist@hotmail.com\"\n    url: \"https://handy-subsidy.net\"\n  }\n}"
