    mamlText: "{\n  provider: \"aws\"\n  region: \"ap-southeast-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 10\n    auto_scaling: {\n      enabled: true\n      min: 2\n      max: 10\n      target_cpu: 59\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 24\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-eec9bddd\"\n    subnet: \"10.201.0.0/16\"\n    public_ip: true\n  }\n}"
