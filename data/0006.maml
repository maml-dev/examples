    mamlText: "{\n  provider: \"azure\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 2\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 6\n      target_cpu: 67\n    }\n  }\n\n  storage: {\n    type: \"nvme\"\n    size_gb: 380\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-bf5c804c\"\n    subnet: \"10.134.0.0/16\"\n    public_ip: true\n  }\n}"
  }
  {
