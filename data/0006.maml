    mamlText: "{\n  listen: 80\n  server_name: \"deficient-lashes.org\"\n  upstream: \"http://localhost:7984\"\n\n  # TLS settings\n  ssl: false\n  http2: true\n\n  gzip: true\n  gzip_min_length: 1024\n  client_max_body: \"3mb\"\n}"
