    mamlText: "# Cverload Changelog\n{\n  project: \"premise\"\n  releases: [\n    {\n      version: \"3.12.8\"\n      date: \"2026-05-07\"\n      notes: \"\"\"\nAdded:\n- parse mobile pixel\n- bypass online feed\n\nFixed:\n- override primary pixel\n\"\"\"\n    }\n\n    {\n      version: \"2.11.15\"\n      date: \"2026-05-26\"\n      notes: \"\"\"\nChanged:\n- connect online sensor\n\nRemoved:\n- synthesize auxiliary microchip\n\"\"\"\n    }\n\n    {\n      version: \"8.14.0\"\n      date: \"2026-04-17\"\n      notes: \"\"\"\nInitial release:\n- compress cross-platform bus\n- compress mobile driver\n- navigate bluetooth array\n\"\"\"\n    }\n  ]\n}"
