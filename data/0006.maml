    mamlText: "# Email template configuration\n{\n  from: \"noreply@coordinated-colonialism.biz\"\n  subject: \"Solio architecto cohibeo defetiscor volubilis.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Distinctio tristis talio dens culpo cilicium ocer decretum conculco attonbitus. Comptus corrumpo solvo verbera repellat conatus expedita consuasor toties tondeo. Desolo arcus anser adeo clam cursus vir supplanto.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nVester natus architecto. Suspendo spectaculum stella minus cubitum sono. Volaticus demonstro eligendi cursim statua depono synagoga aestus cunae solio.\n\nVisit: {{url}}\n\"\"\"\n}"
