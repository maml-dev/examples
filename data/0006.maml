  {
    num: "6839"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"fundraising\"\n      \"sweatshop\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 8\n    weekly: 10\n    monthly: 9\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"s3://backups-sonnet\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
  }
