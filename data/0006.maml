  {
    num: "6262"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Tender Cumquat And Eggplant Salad\"\n  servings: 8\n  prep_time: \"58 minutes\"\n  cook_time: \"80 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 lbs rosemary\"\n    \"3 tsp kenchur\"\n    \"1 cups dark chocolate\"\n    \"2 tbsp chia seeds\"\n    \"1 pieces sunflower seeds\"\n  ]\n\n  # Instructions\n  steps: [\n    \"47-day aged emu steak, with choice of 3 sides.\"\n    \"Savor the rich flavors of savory radicchio, complemented by cranberry and fenugreek.\"\n    \"A special cyan dates from Mexico. To support the strong flavor it is sided with a tablespoon of ajwain seed.\"\n    \"A robust juicy stew featuring Pashtun flavors, loaded with juicy meat, crunchy vegetables, and a rich, golden broth.\"\n    \"A fluffy chilli pepper creation, seasoned with asafoetida and curry, showcasing the best of plant-based cuisine.\"\n    \"Grilled salmon kebabs, marinated in German spices and served with a fresh jicama and honeydew melon salad.\"\n    \"Hearty goat milk and ostrich stew, slow-cooked with rosemary and endive for a comforting, flavorful meal.\"\n  ]\n\n  nutrition: {\n    calories: 442\n    protein: \"25g\"\n    carbs: \"90g\"\n    fat: \"40g\"\n  }\n}"
  }
