  {
    num: "6663"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Snowpea Sprouts Salad\"\n  servings: 4\n  prep_time: \"21 minutes\"\n  cook_time: \"83 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 oz fingerlime\"\n    \"1 oz peppers\"\n    \"4 oz yeast\"\n    \"2 tbsp tempeh\"\n    \"1 oz haricot beans\"\n    \"1 pieces mackerel\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Crispy fried pork bites, seasoned with anise and served with a tangy berry dipping sauce.\"\n    \"An exquisite rabbit roast, infused with the essence of incaberry, slow-roasted to bring out its natural flavors and served with a side of creamy carob carrot\"\n    \"A special green pomegranate from Tokelau. To support the strong flavor it is sided with a tablespoon of cassia.\"\n    \"Our juicy venison, slow-cooked to perfection, accompanied by steamed rhubarb and a rich, savory gravy.\"\n  ]\n\n  nutrition: {\n    calories: 187\n    protein: \"21g\"\n    carbs: \"77g\"\n    fat: \"23g\"\n  }\n}"
  }
  {
    num: "6664"
    title: "Blog Post"
    description: "A blog post with metadata and content sections."
    shapeIndex: 3
    mamlText: "{\n  title: \"Concedo adfectus canonicus crepusculum argumentum sapiente.\"\n  slug: \"vestigium-amplexus-vociferor\"\n  author: {\n    name: \"Aliyah Nikolaus\"\n    avatar: \"https://cdn.jsdelivr.net/gh/faker-js/assets-person-portrait/male/512/39.jpg\"\n    bio: \"violin fan\"\n  }\n  date: \"2026-03-11\"\n  tags: [\n    \"lifestyle\"\n    \"reasoning\"\n    \"grandpa\"\n  ]\n\n  published: true\n  reading_time: \"10 min\"\n  summary: \"Comparo maiores urbs cursim delibero depromo terminatio theologus constans. Tolero absque repellendus calamitas atrox corpus delectus taceo. Ascit aspicio verbera valeo.\"\n}"
  }
