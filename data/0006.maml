    mamlText: "{\n  base_url: \"/api/v1\"\n  routes: [\n    {\n      method: \"POST\"\n      path: \"/users/:id\"\n      handler: \"createOrders\"\n      auth: false\n    }\n\n    {\n      method: \"POST\"\n      path: \"/posts\"\n      handler: \"getProducts\"\n      auth: false\n    }\n\n    {\n      method: \"GET\"\n      path: \"/orders/:id\"\n      handler: \"listPosts\"\n      auth: true\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/posts\"\n      handler: \"createOrders\"\n      auth: true\n    }\n  ]\n}"
