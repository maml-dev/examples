  {
    num: "6487"
    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@optimistic-pliers.info\"\n  subject: \"Articulus consuasor pax caterva.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Cubicularis vitae chirographum curvo corporis porro assumenda angelus qui cruentus. Validus cito centum. Tamen abeo vigor calculus patruus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nSupra una tui. Aperiam somniculosus confido comis creator adiuvo crux cunabula claudeo comedo. Voluptatibus certus aureus ad cupiditas tergum voveo.\n\nVisit: {{url}}\n\"\"\"\n}"
