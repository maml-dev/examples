    shapeIndex: 3
    mamlText: "{\n  title: \"Aestus varietas theatrum cubitum.\"\n  slug: \"appello-vomito-animi\"\n  author: {\n    name: \"Icie Lakin\"\n    avatar: \"https://avatars.githubusercontent.com/u/12192619\"\n    bio: \"peninsula devotee\"\n  }\n  date: \"2026-02-25\"\n  tags: [\n    \"redesign\"\n    \"submitter\"\n    \"hydrocarbon\"\n  ]\n\n  published: false\n  reading_time: \"12 min\"\n  summary: \"Congregatio adsidue creo cariosus defluo harum vomer valde tubineus. Decimus cras tergiversatio nobis ut abduco commodo adopto debitis. Desipio abbas aspicio tamquam asperiores venio corrumpo conturbo.\"\n}"
  }
