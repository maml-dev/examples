    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"troubled-airline.net\"\n  inbound: {\n    mx_records: [\n      \"mx1.troubled-airline.net\"\n      \"mx2.troubled-airline.net\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.troubled-airline.net\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 213\n      per_hour: 3775\n    }\n  }\n}"
