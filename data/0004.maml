    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"torn-markup.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.torn-markup.info\"\n      \"mx2.torn-markup.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.torn-markup.info\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 321\n      per_hour: 4880\n    }\n  }\n}"
  }
