  {
    num: "4661"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Arrowroot-rubbed Crocodile Salad\"\n  servings: 8\n  prep_time: \"12 minutes\"\n  cook_time: \"88 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 tbsp macadamia nut\"\n    \"1 pieces red lentils\"\n    \"2 tsp cornichons\"\n    \"2 tsp goat cheese\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A special white rockmelon from Djibouti. To support the strong flavor it is sided with a tablespoon of lemon pepper.\"\n    \"A simple pineapple pie. No fancy stuff. Just pie.\"\n    \"A special yellow cocoa powder from United States Minor Outlying Islands. To support the strong flavor it is sided with a tablespoon of chillies.\"\n    \"Juicy turkey, grilled to your liking and drizzled with a bold anise star sauce, served alongside roasted red pepper.\"\n    \"A succulent kangaroo steak, encased in a savory pimento crust, served with a side of pepper mashed sun dried tomatoes.\"\n    \"A special lime kiwi fruit from Ireland. To support the strong flavor it is sided with a tablespoon of bay leaves.\"\n  ]\n\n  nutrition: {\n    calories: 162\n    protein: \"15g\"\n    carbs: \"86g\"\n    fat: \"7g\"\n  }\n}"
  }
