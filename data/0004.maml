    mamlText: "# Jathrobe Changelog\n{\n  project: \"hunt\"\n  releases: [\n    {\n      version: \"2.15.17\"\n      date: \"2026-04-14\"\n      notes: \"\"\"\nAdded:\n- quantify auxiliary panel\n- compress solid state driver\n\nFixed:\n- quantify bluetooth pixel\n\"\"\"\n    }\n\n    {\n      version: \"2.18.20\"\n      date: \"2026-02-10\"\n      notes: \"\"\"\nChanged:\n- calculate cross-platform panel\n\nRemoved:\n- override virtual panel\n\"\"\"\n    }\n\n    {\n      version: \"0.7.19\"\n      date: \"2026-02-17\"\n      notes: \"\"\"\nInitial release:\n- transmit wireless hard drive\n- program cross-platform firewall\n- parse online sensor\n\"\"\"\n    }\n  ]\n}"
