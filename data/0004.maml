  {
    num: "4092"
    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@lawful-sideboard.net\"\n  subject: \"Tabula degenero asporto volup civis.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Paulatim volutabrum suscipio speciosus occaecati vester. Paens at suggero hic terminatio accendo utrum. Calculus apostolus cilicium carbo adicio bibo.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nBenigne benigne uter turbo tergum. Tabgo vorax copia abutor. Vitiosus corona cognomen vos adopto sum aspernatur corrumpo cogito xiphias.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
