    shapeIndex: 3
    mamlText: "{\n  trip: \"Port May to Chazport\"\n  traveler: \"Rolando Strosin\"\n  dates: {\n    departure: \"2026-05-23\"\n    return: \"2026-06-18\"\n  }\n\n  flights: [\n    {\n      flight: \"0696\"\n      from: \"SVO\"\n      to: \"NAN\"\n      departure: \"09:15\"\n      seat: \"7C\"\n    }\n\n    {\n      flight: \"0217\"\n      from: \"NBO\"\n      to: \"YVR\"\n      departure: \"07:00\"\n      seat: \"8C\"\n    }\n  ]\n\n  hotel: {\n    name: \"Ruecker LLC Hotel\"\n    address: \"315 N 7th Street\"\n    check_in: \"15:00\"\n    check_out: \"12:00\"\n    confirmation: \"ZTYFWHIR\"\n  }\n}"
