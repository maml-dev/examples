    mamlText: "{\n  sprint: \"Sprint 26\"\n  tasks: [\n    {\n      id: \"HZRPQY\"\n      title: \"The SAS microchip is down, override the digital circuit so we can transmit the UTF8 alarm!\"\n      assignee: \"Benny Collins\"\n      priority: \"high\"\n      status: \"review\"\n      points: 8\n    }\n\n    {\n      id: \"IGT5SP\"\n      title: \"We need to generate the open-source CSS interface!\"\n      assignee: \"Letitia Prohaska Sr.\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 5\n    }\n\n    {\n      id: \"GY8XLV\"\n      title: \"We need to compress the primary AGP hard drive!\"\n      assignee: \"Katrina Rutherford\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 13\n    }\n\n    {\n      id: \"IMBUPW\"\n      title: \"You can't compress the monitor without connecting the back-end RSS capacitor!\"\n      assignee: \"Myrtice Barton\"\n      priority: \"high\"\n      status: \"review\"\n      points: 8\n    }\n\n    {\n      id: \"TITCF5\"\n      title: \"If we index the port, we can get to the VGA microchip through the multi-byte JBOD protocol!\"\n      assignee: \"Krystal Rohan\"\n      priority: \"high\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"VXP7DW\"\n      title: \"backing up the bus won't do anything, we need to back up the open-source SMS array!\"\n      assignee: \"Daniel Torp\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 13\n    }\n  ]\n}"
  }
