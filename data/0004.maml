    shapeIndex: 3
    mamlText: "{\n  name: \"hospitalization-hooks\"\n  secret: \"RlbqpZK0t6wDKvRcZd5p25HdHgXoEbHA\"\n  endpoints: [\n    {\n      url: \"https://jumbo-reorganisation.net//webhook\"\n      events: [\n        \"create\"\n        \"update\"\n        \"delete\"\n      ]\n      active: true\n    }\n\n    {\n      url: \"https://hopeful-teammate.net/callback\"\n      events: [\n        \"payment.success\"\n        \"payment.failed\"\n      ]\n      active: true\n    }\n  ]\n\n  retry: {\n    max_attempts: 8\n    backoff: \"linear\"\n    interval: 28 # seconds\n  }\n  timeout: 5 # seconds\n}"
  }
