    mamlText: "{\n  sprint: \"Sprint 30\"\n  tasks: [\n    {\n      id: \"16MJF2\"\n      title: \"I'll compress the cross-platform IP port, that should firewall the COM interface!\"\n      assignee: \"Abbie Crist\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"C0EJUU\"\n      title: \"We need to program the digital SQL monitor!\"\n      assignee: \"Mr. Justin McDermott\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"PQGQ3J\"\n      title: \"Try to back up the COM application, maybe it will copy the redundant array!\"\n      assignee: \"Delores Toy\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 8\n    }\n\n    {\n      id: \"0HR4MF\"\n      title: \"You can't hack the system without copying the digital RAM interface!\"\n      assignee: \"Ethel Stoltenberg\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 1\n    }\n\n    {\n      id: \"HGGLT3\"\n      title: \"The AI pixel is down, program the solid state driver so we can bypass the API port!\"\n      assignee: \"Homer Howe-Kertzmann\"\n      priority: \"critical\"\n      status: \"done\"\n      points: 8\n    }\n  ]\n}"
