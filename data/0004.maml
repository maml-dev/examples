    title: "Blog Post"
    description: "A blog post with metadata and content sections."
    shapeIndex: 3
    mamlText: "{\n  title: \"Voveo deduco admitto admiratio.\"\n  slug: \"attonbitus-odio-civitas\"\n  author: {\n    name: \"Felix Padberg V\"\n    avatar: \"https://avatars.githubusercontent.com/u/29441599\"\n    bio: \"clamp enthusiast\"\n  }\n  date: \"2026-03-08\"\n  tags: [\n    \"disappointment\"\n    \"ice-cream\"\n    \"printer\"\n  ]\n\n  published: true\n  reading_time: \"18 min\"\n  summary: \"Careo censura colo centum supplanto astrum ars assentator. Aliquam vox pecco defetiscor substantia cultura audeo surculus. Tamdiu caritas defluo stella aequus taceo deleo.\"\n}"
  }
  {
    num: "4674"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Vegetable Soup\"\n  servings: 6\n  prep_time: \"12 minutes\"\n  cook_time: \"50 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 pieces rosemary\"\n    \"2 tbsp blueberries\"\n    \"4 oz sesame seeds\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Three cantaloupe with dried chinese broccoli, endive, hijiki, asparagus and tamari. With a side of baked plum, and your choice of blue eye trevalla or cavalo.\"\n    \"A special purple mahi mahi from Norway. To support the strong flavor it is sided with a tablespoon of ginger.\"\n    \"Savor the rich flavors of spicy chinese cabbage, complemented by papaw and dill.\"\n    \"Three smoked trout with green pepper, jerusalem artichoke, radish, jerusalem artichoke and carrot. With a side of baked watermelon, and your choice of chickpea or mango.\"\n  ]\n\n  nutrition: {\n    calories: 171\n    protein: \"11g\"\n    carbs: \"80g\"\n    fat: \"18g\"\n  }\n}"
  }
