    mamlText: "# Email template configuration\n{\n  from: \"noreply@pure-cruelty.info\"\n  subject: \"Abundans cado adfero.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Odio quisquam suscipio terga avaritia quas aspernatur odit deleniti. Tempora crapula vetus. Volo aeger callide praesentium vir vehemens votum sperno.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nAdipiscor virtus terebro viscus timor confido arbustum. Asper universe combibo abundans tergum. Concedo arca aer tam deprimo cunabula terminatio.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
