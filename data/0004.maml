    mamlText: "{\n  title: \"Ebiten Maki\"\n  servings: 7\n  prep_time: \"10 minutes\"\n  cook_time: \"59 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 oz cornmeal\"\n    \"3 tsp yellow papaw\"\n    \"2 tsp capers\"\n    \"4 pieces kale\"\n    \"3 tsp bay leaves\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Fresh mixed greens tossed with fenugreek-rubbed quail, peppers, and a light dressing.\"\n    \"Our salty rabbit, slow-cooked to perfection, accompanied by steamed leeks and a rich, savory gravy.\"\n    \"A classic pie filled with delicious emu and spicy custard apples, baked in a salty pastry crust and topped with a golden-brown lattice.\"\n    \"Baked walnut-stuffed venison, seasoned with sweet laurel and savory herbs, accompanied by roasted cornichons medley.\"\n    \"Hearty onion and quail stew, slow-cooked with basil and parsnip for a comforting, flavorful meal.\"\n    \"Three fenugreek with okra, rhubarb, broccolini, squash and mountain bread. With a side of baked kiwiberry, and your choice of silverbeet or yeast.\"\n    \"A robust fresh stew featuring Ukrainian flavors, loaded with savory meat, juicy vegetables, and a fluffy, smoky broth.\"\n  ]\n\n  nutrition: {\n    calories: 713\n    protein: \"30g\"\n    carbs: \"69g\"\n    fat: \"12g\"\n  }\n}"
