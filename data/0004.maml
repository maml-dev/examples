    mamlText: "# HTTP Headers\n{\n  Content-Type: \"application/xml\"\n  X-Request-ID: \"d9b74c32-e839-4947-965f-9fc6d97766ed\"\n  Accept-Language: \"ja-JP\"\n  Cache-Control: \"max-age=3600\"\n  X-Powered-By: \"Express\"\n\n  # Keys with spaces get quoted\n  \"headers with spaces\": {\n    \"custom header\": \"cerno\"\n    \"another one\": \"ager\"\n  }\n}"
  }
  {
