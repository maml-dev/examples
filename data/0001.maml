    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 5\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 11\n      target_cpu: 73\n    }\n  }\n\n  storage: {\n    type: \"nvme\"\n    size_gb: 425\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-fdfb7d2e\"\n    subnet: \"10.129.0.0/16\"\n    public_ip: true\n  }\n}"
  }
  {
    num: "1436"
    title: "Queue Config"
    description: "Message queue and worker configuration."
    shapeIndex: 1
    mamlText: "{\n  broker: \"rabbitmq\"\n  connection: {\n    host: \"localhost\"\n    port: 5672\n    vhost: \"/staging\"\n  }\n\n  # Queue definitions\n  queues: {\n    default: {\n      concurrency: 6\n      retry: 1\n      timeout: 33326 # ms\n    }\n\n    priority: {\n      concurrency: 16\n      retry: 8\n      timeout: 5846 # ms\n    }\n  }\n\n  dead_letter: {\n    enabled: true\n    max_retries: 8\n    queue: \"dead-letter\"\n  }\n}"
  }
