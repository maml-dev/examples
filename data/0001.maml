    mamlText: "# Email template configuration\n{\n  from: \"noreply@rubbery-tinderbox.biz\"\n  subject: \"Spectaculum alii animi adopto virtus aestivus.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Nesciunt illo atque audentia vomer vicinus. Omnis dedecor demitto audio arcesso. Demum ante commodo.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nTemperantia verbera amplus cornu angelus tenax accedo officia. Corpus solus velit votum ex arbor averto. Temptatio audentia vomica.\n\nVisit: {{url}}\n\"\"\"\n}"
