    shapeIndex: 1
    mamlText: "{\n  domain: \"improbable-reboot.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.improbable-reboot.org\"\n      \"mx2.improbable-reboot.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.improbable-reboot.org\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 151\n      per_hour: 7700\n    }\n  }\n}"
