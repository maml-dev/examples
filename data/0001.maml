    title: "Blog Post"
    description: "A blog post with metadata and content sections."
    shapeIndex: 3
    mamlText: "{\n  title: \"Celebrer urbanus vulariter canonicus.\"\n  slug: \"a-aetas-beneficium\"\n  author: {\n    name: \"Josefa Okuneva\"\n    avatar: \"https://cdn.jsdelivr.net/gh/faker-js/assets-person-portrait/male/512/40.jpg\"\n    bio: \"decision advocate\"\n  }\n  date: \"2026-03-15\"\n  tags: [\n    \"tentacle\"\n    \"handle\"\n    \"swanling\"\n  ]\n\n  published: false\n  reading_time: \"13 min\"\n  summary: \"Modi acies antepono vulnus. Accendo verbum toties magni clarus amoveo auctus suasoria ultio turba. Alii summisse amitto acervus pecus.\"\n}"
