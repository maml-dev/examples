    shapeIndex: 1
    mamlText: "{\n  domain: \"swift-aftermath.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.swift-aftermath.org\"\n      \"mx2.swift-aftermath.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.swift-aftermath.org\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 186\n      per_hour: 9190\n    }\n  }\n}"
