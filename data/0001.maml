    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"db.internal\"\n    databases: [\n      \"ectoderm\"\n      \"bourgeoisie\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 11\n    weekly: 10\n    monthly: 23\n  }\n\n  destination: {\n    type: \"sftp\"\n    path: \"/mnt/backups/tuber\"\n    encryption: true\n    compression: \"zstd\"\n  }\n}"
