    description: "Authentication and authorization settings."
    shapeIndex: 1
    mamlText: "{\n  provider: \"oauth2\"\n  # Token settings\n  jwt: {\n    secret_key: \"aMzXzdNyDKg3ozD9J3JHGMoxbBdwPZMI\"\n    algorithm: \"RS256\"\n    expiry: \"24h\"\n    refresh_expiry: \"30d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"Ju7gnnhVBd7wwxnexXhV0FRR\"\n    authorize_url: \"https://auth.long-term-dulcimer.com/authorize\"\n    token_url: \"https://auth.primary-goat.info/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"memory\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
