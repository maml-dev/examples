  {
    num: "1731"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"excellent-vicinity.com\"\n  inbound: {\n    mx_records: [\n      \"mx1.excellent-vicinity.com\"\n      \"mx2.excellent-vicinity.com\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.excellent-vicinity.com\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 477\n      per_hour: 5716\n    }\n  }\n}"
