    mamlText: "{\n  application: \"methodologies\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: If we generate the sensor, we can get to the COM microchip through the cross-platform TCP card!\n    at /opt/sbin/wry_judgementally_aw.mp2:14\n    at /opt/lib/as.htm:82\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nGET /api/reporter HTTP/1.1\nHost: enlightened-planula.info\nUser-Agent: Mozilla/5.0 (Linux; Android 10; SM-G998U) AppleWebKit/550.26 (KHTML, like Gecko) Chrome/103.5.18.13 Mobile Safari/578.10\nAccept: application/json\n\"\"\"\n  retention_days: 82\n}"
