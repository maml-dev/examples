    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"distinct-masterpiece.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.distinct-masterpiece.org\"\n      \"mx2.distinct-masterpiece.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.distinct-masterpiece.org\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 245\n      per_hour: 5816\n    }\n  }\n}"
