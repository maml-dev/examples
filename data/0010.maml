    mamlText: "{\n  name: \"intellect-hooks\"\n  secret: \"jyGKozw1i9QSiR9IOVU8EYdRzRd1Z4KN\"\n  endpoints: [\n    {\n      url: \"https://energetic-earth.biz/webhook\"\n      events: [\n        \"create\"\n        \"update\"\n        \"delete\"\n      ]\n      active: true\n    }\n\n    {\n      url: \"https://experienced-rationale.biz/callback\"\n      events: [\n        \"payment.success\"\n        \"payment.failed\"\n      ]\n      active: false\n    }\n  ]\n\n  retry: {\n    max_attempts: 6\n    backoff: \"linear\"\n    interval: 13 # seconds\n  }\n  timeout: 27 # seconds\n}"
