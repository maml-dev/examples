    description: "Message queue and worker configuration."
    shapeIndex: 1
    mamlText: "{\n  broker: \"redis\"\n  connection: {\n    host: \"localhost\"\n    port: 5672\n    vhost: \"/\"\n  }\n\n  # Queue definitions\n  queues: {\n    default: {\n      concurrency: 6\n      retry: 5\n      timeout: 41436 # ms\n    }\n\n    priority: {\n      concurrency: 6\n      retry: 9\n      timeout: 4524 # ms\n    }\n  }\n\n  dead_letter: {\n    enabled: true\n    max_retries: 7\n    queue: \"dead-letter\"\n  }\n}"
  }
  {
    num: "10322"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"parched-summary.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.parched-summary.org\"\n      \"mx2.parched-summary.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.parched-summary.org\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 190\n      per_hour: 8221\n    }\n  }\n}"
  }
  {
