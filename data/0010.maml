  {
    num: "10281"
    title: "Nginx Snippet"
    description: "Nginx server block as raw string configuration."
    shapeIndex: 4
    mamlText: "# Nginx configuration\n{\n  name: \"improbable-bend.com\"\n  # Server block\n  config: \"\"\"\nserver {\n    listen 443 ssl http2;\n    server_name hidden-supplier.name;\n\n    ssl_certificate /etc/ssl/certs/cert.pem;\n    ssl_certificate_key /etc/ssl/private/key.pem;\n\n    location / {\n        proxy_pass http://localhost:5275;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n    }\n\n    location /static/ {\n        root /var/www/html;\n        expires 30d;\n    }\n}\n\"\"\"\n\n  enabled: true\n  reload_command: \"nginx -t && systemctl reload nginx\"\n}"
  }
  {
    num: "10282"
    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@low-casement.name\"\n  subject: \"Auditor valens crur reprehenderit.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Unde denuo ipsam ea vilitas adipiscor. Decipio advoco decerno sint votum tepidus supra torqueo velut. Demonstro capitulus astrum theologus verbum arcesso illo votum.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nSpeculum vacuus certus rerum quidem eos via sponte somniculosus deorsum. Capto denego theatrum approbo cetera cupio bestia. Explicabo deserunt cruciamentum voluptates subseco ea alioqui solium beneficium.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
  {
    num: "10283"
    title: "Changelog"
    description: "Project changelog with raw string release notes."
    shapeIndex: 4
    mamlText: "# Cole Changelog\n{\n  project: \"rule\"\n  releases: [\n    {\n      version: \"7.13.8\"\n      date: \"2026-06-30\"\n      notes: \"\"\"\nAdded:\n- compress auxiliary transmitter\n- bypass optical driver\n\nFixed:\n- parse cross-platform array\n\"\"\"\n    }\n\n    {\n      version: \"7.4.8\"\n      date: \"2026-06-17\"\n      notes: \"\"\"\nChanged:\n- index solid state transmitter\n\nRemoved:\n- connect solid state port\n\"\"\"\n    }\n\n    {\n      version: \"5.17.16\"\n      date: \"2026-03-19\"\n      notes: \"\"\"\nInitial release:\n- reboot redundant matrix\n- navigate bluetooth program\n- navigate 1080p array\n\"\"\"\n    }\n  ]\n}"
  }
  {
    num: "10284"
    title: "SQL Queries"
    description: "Database queries stored as raw strings."
    shapeIndex: 4
    mamlText: "# Database query definitions\n{\n  name: \"user-reports\"\n  version: 2\n\n  queries: {\n    # Find all active users\n    find_active: \"\"\"\nSELECT u.id, u.name, u.email\nFROM users u\nWHERE u.active = true\n  AND u.created_at > '2024-01-01'\nORDER BY u.name\n\"\"\"\n\n    # Monthly aggregation\n    monthly_stats: \"\"\"\nSELECT\n  DATE_TRUNC('month', created_at) AS month,\n  COUNT(*) AS total,\n  SUM(amount) AS revenue\nFROM orders\nGROUP BY month\nORDER BY month DESC\n\"\"\"\n  }\n}"
  }
  {
    num: "10285"
    title: "Crontab"
    description: "System crontab with commented schedule explanations."
    shapeIndex: 4
    mamlText: "# System crontab\n{\n  SHELL: \"/bin/bash\"\n  PATH: \"/usr/local/bin:/usr/bin:/bin\"\n\n  MAILTO: \"Elenor7@hotmail.com\"\n\n  jobs: {\n    # Full database backup at 2:00 AM daily\n    backup: {\n      schedule: \"0 2 * * *\"\n      command: \"\"\"\n/usr/local/bin/backup.sh --target /mnt/backup\n  --compress gzip\n  --notify Audra58@gmail.com\n\"\"\"\n    }\n\n    # Renew SSL certificates on the 1st of each month\n    certbot: {\n      schedule: \"0 0 1 * *\"\n      command: \"certbot renew --quiet\"\n    }\n\n    # Weekly log rotation and cleanup\n    logrotate: {\n      schedule: \"0 0 * * 0\"\n      command: \"\"\"\n/usr/sbin/logrotate /etc/logrotate.conf\nfind /var/log -name \"*.gz\" -mtime +30 -delete\n\"\"\"\n    }\n  }\n}"
  }
