    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@noxious-archaeology.com\"\n  subject: \"Charisma provident uredo.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Laudantium rem terra aequus vergo crepusculum vobis aegre abeo crebro. Contego triduana cupiditas derideo artificiose adfero turba tutamen thesaurus asperiores. Accedo pectus terra cruciamentum quasi facere fugiat.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nCapillus audentia explicabo vindico libero nemo. Vorago teneo et desparatus aequitas. Comes deinde earum conscendo vere defungo.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
