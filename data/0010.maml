    mamlText: "# Fierarchy Changelog\n{\n  project: \"chainstay\"\n  releases: [\n    {\n      version: \"5.12.4\"\n      date: \"2026-06-27\"\n      notes: \"\"\"\nAdded:\n- connect haptic application\n- calculate bluetooth circuit\n\nFixed:\n- input haptic sensor\n\"\"\"\n    }\n\n    {\n      version: \"9.8.16\"\n      date: \"2026-06-27\"\n      notes: \"\"\"\nChanged:\n- program 1080p alarm\n\nRemoved:\n- input optical microchip\n\"\"\"\n    }\n\n    {\n      version: \"1.18.6\"\n      date: \"2026-06-12\"\n      notes: \"\"\"\nInitial release:\n- calculate 1080p protocol\n- transmit cross-platform monitor\n- index auxiliary interface\n\"\"\"\n    }\n  ]\n}"
