    mamlText: "{\n  title: \"Mamie's Special Swordfish\"\n  servings: 5\n  prep_time: \"35 minutes\"\n  cook_time: \"59 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 pieces mace\"\n    \"4 lbs vegetable spaghetti\"\n    \"4 cups dragonfruit\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Baked apple juice concentrate-stuffed kangaroo, seasoned with methi and smoky herbs, accompanied by roasted broccolini medley.\"\n    \"Baked chilli pepper-stuffed salmon, seasoned with kaffir leaves and smoky herbs, accompanied by roasted peppers medley.\"\n    \"An exquisite lettuce dish, paired with ajowan seed and a hint of german chamomile.\"\n    \"An exquisite sun dried tomatoes dish, paired with wheatgrass juice and a hint of garlic.\"\n    \"Three tabasco with kale, chives, swiss chard, jicama and kumera. With a side of baked guava, and your choice of soy or quark.\"\n    \"Our delicious goose, slow-cooked to perfection, accompanied by steamed okra and a rich, savory gravy.\"\n  ]\n\n  nutrition: {\n    calories: 322\n    protein: \"48g\"\n    carbs: \"73g\"\n    fat: \"30g\"\n  }\n}"
