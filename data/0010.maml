    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"whopping-brief.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.whopping-brief.biz\"\n      \"mx2.whopping-brief.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.whopping-brief.biz\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 79\n      per_hour: 6988\n    }\n  }\n}"
