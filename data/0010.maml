    mamlText: "{\n  provider: \"oauth2\"\n  # Token settings\n  jwt: {\n    secret_key: \"9kddVPN0nein022VEnMcL5sXnpJoIMaX\"\n    algorithm: \"RS256\"\n    expiry: \"24h\"\n    refresh_expiry: \"7d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"ffegUAR9uRF2zc71YFI8VeDj\"\n    authorize_url: \"https://auth.likely-alert.name/authorize\"\n    token_url: \"https://auth.lumpy-planula.name/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"memory\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
