    mamlText: "# Email template configuration\n{\n  from: \"noreply@closed-bathhouse.info\"\n  subject: \"Absconditus avaritia decens curia.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Talis desino vestrum nulla atrocitas stips cohors vomica usus tendo. Sumo vespillo alioqui tego auctor. Admiratio auditor ago sum amet.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nVicissitudo demitto ventosus optio vacuus vulnus vulgus caput tunc. Conforto calculus suffoco. Alius solus capitulus pel alveus aer tamisium.\n\nVisit: {{url}}\n\"\"\"\n}"
