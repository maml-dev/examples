    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 15\"\n  tasks: [\n    {\n      id: \"OSLA8Z\"\n      title: \"Use the auxiliary AGP protocol, then you can quantify the cross-platform system!\"\n      assignee: \"Winifred Conn IV\"\n      priority: \"high\"\n      status: \"done\"\n      points: 1\n    }\n\n    {\n      id: \"ERNPN5\"\n      title: \"backing up the array won't do anything, we need to parse the cross-platform EXE array!\"\n      assignee: \"Dr. Cory Abshire\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 13\n    }\n\n    {\n      id: \"80PXVU\"\n      title: \"If we bypass the matrix, we can get to the IB program through the solid state EXE capacitor!\"\n      assignee: \"Hayley Parker\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 2\n    }\n  ]\n}"
  }
  {
    num: "2860"
    title: "Cron Jobs"
    description: "Scheduled task definitions."
    shapeIndex: 2
    mamlText: "{\n  timezone: \"UTC\"\n  jobs: [\n    {\n      name: \"refresh-cache\"\n      schedule: \"0 0 * * *\"\n      command: \"node scripts/cleanup.js\"\n      enabled: true\n    }\n\n    {\n      name: \"refresh-cache\"\n      schedule: \"30 6 * * 1-5\"\n      command: \"./bin/sync --all\"\n      enabled: true\n    }\n\n    {\n      name: \"refresh-cache\"\n      schedule: \"0 * * * *\"\n      command: \"node scripts/cleanup.js\"\n      enabled: false\n    }\n\n    {\n      name: \"send-reports\"\n      schedule: \"30 6 * * 1-5\"\n      command: \"node scripts/cleanup.js\"\n      enabled: true\n    }\n\n    {\n      name: \"send-reports\"\n      schedule: \"0 2 * * 0\"\n      command: \"pg_dump $DATABASE_URL\"\n      enabled: true\n    }\n  ]\n}"
