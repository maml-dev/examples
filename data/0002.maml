    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@dim-hydrolyze.info\"\n  subject: \"Caterva volo cogito repellat adsum.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Apto in deinde sublime beatae theca totus. Tui tristis dedecor delego abduco vae. Somniculosus aestus vindico caritas solum vehemens non delectatio.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nAuctor tergiversatio peccatus volo aliquid cognatus. Terra umquam amplitudo. Cicuta artificiose non pectus debitis.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
  {
    num: "2696"
    title: "Regex Patterns"
