    mamlText: "{\n  provider: \"saml\"\n  # Token settings\n  jwt: {\n    secret_key: \"kPcPRkjRG4nv6GNtvGqUphAcGEgJkwyw\"\n    algorithm: \"ES256\"\n    expiry: \"15m\"\n    refresh_expiry: \"90d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"3wonpvQTXsoghnkmkTGBBzBj\"\n    authorize_url: \"https://auth.salty-fun.org/authorize\"\n    token_url: \"https://auth.whirlwind-armchair.net/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"redis\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
  }
