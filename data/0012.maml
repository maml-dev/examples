    description: "Full application manifest with metadata, dependencies, and scripts."
    shapeIndex: 3
    mamlText: "{\n  name: \"bourgeoisie-custody\"\n  version: \"2.2.12\"\n  description: \"User-friendly zero tolerance project\"\n\n  keywords: [\n    \"precedent\"\n    \"hunger\"\n    \"sparkling\"\n  ]\n\n  scripts: {\n    dev: \"node server.js --watch\"\n    build: \"tsc && esbuild src/index.ts --bundle --outfile=dist/index.js\"\n    test: \"vitest\"\n    lint: \"oxlint\"\n  }\n  engines: {\n    node: \">=20\"\n  }\n\n  author: {\n    name: \"Mr. Clifford Fadel\"\n    email: \"Angie.Armstrong@gmail.com\"\n    url: \"https://self-assured-hippodrome.com/\"\n  }\n}"
  }
  {
    num: "12965"
    title: "Test Suite"
    description: "Test runner configuration with coverage settings."
    shapeIndex: 3
    mamlText: "{\n  runner: \"jest\"\n  root: \"./src/__tests__\"\n  include: [\n    \"**/*.test.ts\"\n    \"**/*.spec.ts\"\n  ]\n  exclude: [\n    \"node_modules\"\n    \"dist\"\n    \"**/*.e2e.ts\"\n  ]\n\n  # Coverage\n  coverage: {\n    enabled: true\n    provider: \"v8\"\n    thresholds: {\n      lines: 80\n      branches: 83\n      functions: 92\n    }\n    reporter: [\n      \"text\"\n      \"lcov\"\n      \"html\"\n    ]\n  }\n  globals: true\n  timeout: 24463 # ms\n}"
  }
