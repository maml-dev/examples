  {
    num: "12322"
    title: "K8s Deployment"
    description: "Kubernetes deployment specification."
    shapeIndex: 1
    mamlText: "{\n  apiVersion: \"apps/v1\"\n  kind: \"Deployment\"\n  metadata: {\n    name: \"cow-api\"\n    namespace: \"production\"\n    labels: {\n      app: \"making\"\n      tier: \"backend\"\n    }\n  }\n\n  # Deployment spec\n  spec: {\n    replicas: 3\n    container: {\n      image: \"tune-up:0.14.10\"\n      port: 8080\n      resources: {\n        cpu_limit: \"250m\"\n        memory_limit: \"1Gi\"\n      }\n    }\n\n    health_check: {\n      path: \"/health\"\n      interval: 15\n      timeout: 3\n    }\n  }\n}"
  }
  {
    num: "12323"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"puzzled-euphonium.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.puzzled-euphonium.org\"\n      \"mx2.puzzled-euphonium.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.puzzled-euphonium.org\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 328\n      per_hour: 1033\n    }\n  }\n}"
  }
