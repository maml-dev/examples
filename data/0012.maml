  {
    num: "12962"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Mushroom Risotto\"\n  servings: 3\n  prep_time: \"36 minutes\"\n  cook_time: \"46 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 oz tarragon\"\n    \"4 tsp cinnamon\"\n    \"1 tsp green beans\"\n    \"4 oz butternut lettuce\"\n    \"4 lbs cous cous\"\n    \"3 cups stevia\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Tender duck skewers, glazed with a sweet and tangy bush tomato sauce, served over a bed of fragrant jasmine rice.\"\n    \"Hearty duck and emu stew, slow-cooked with chamomile and eggplant for a comforting, flavorful meal.\"\n    \"A heartwarming Mughal soup, featuring fresh hiramasa kingfish and an aromatic blend of traditional spices.\"\n    \"Crispy fried pigeon bites, seasoned with cassia and served with a tangy sultana dipping sauce.\"\n    \"Crispy fried lamb bites, seasoned with pot marjoram and served with a tangy orange dipping sauce.\"\n  ]\n\n  nutrition: {\n    calories: 433\n    protein: \"30g\"\n    carbs: \"86g\"\n    fat: \"27g\"\n  }\n}"
  }
