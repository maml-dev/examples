  {
    num: "12262"
    title: "App Manifest"
    description: "Full application manifest with metadata, dependencies, and scripts."
    shapeIndex: 3
    mamlText: "{\n  name: \"flint-pleasure\"\n  version: \"7.15.1\"\n  description: \"Synchronised motivating intranet\"\n\n  keywords: [\n    \"amendment\"\n    \"inspection\"\n    \"extroverted\"\n  ]\n\n  scripts: {\n    dev: \"node server.js --watch\"\n    build: \"tsc && esbuild src/index.ts --bundle --outfile=dist/index.js\"\n    test: \"vitest\"\n    lint: \"eslint .\"\n  }\n  engines: {\n    node: \">=22\"\n  }\n\n  author: {\n    name: \"Miss Abner Reichert\"\n    email: \"Haleigh51@gmail.com\"\n    url: \"https://infatuated-venom.org\"\n  }\n}"
  }
  {
    num: "12263"
    title: "Dashboard Layout"
    description: "Dashboard widget layout configuration."
    shapeIndex: 3
    mamlText: "{\n  title: \"Hane and Sons Dashboard\"\n  refresh_interval: 30 # seconds\n  widgets: [\n    {\n      type: \"chart\"\n      title: \"Signups\"\n      source: \"/api/metrics/traffic\"\n      chart_type: \"line\"\n      period: \"90d\"\n    }\n\n    {\n      type: \"stat\"\n      title: \"Total Users\"\n      source: \"/api/stats/users\"\n      format: \"currency\"\n    }\n\n    {\n      type: \"table\"\n      title: \"Top Pages\"\n      source: \"/api/recent/orders\"\n      limit: 20\n    }\n  ]\n\n  theme: \"light\"\n}"
  }
  {
    num: "12264"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Salmon With Starfruit Sauce\"\n  servings: 6\n  prep_time: \"25 minutes\"\n  cook_time: \"92 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 pieces cloves\"\n    \"4 oz lime leaves\"\n    \"4 tbsp camembert\"\n    \"4 lbs asian greens\"\n    \"1 tsp spelt bread\"\n  ]\n\n  # Instructions\n  steps: [\n    \"An exquisite okra dish, paired with cacao and a hint of tikka masala.\"\n    \"A robust rich stew featuring Louisiana Creole flavors, loaded with sweet meat, tangy vegetables, and a golden, juicy broth.\"\n    \"An exquisite parsnip dish, paired with bulghur and a hint of achiote seed.\"\n    \"An exquisite swiss chard dish, paired with mint and a hint of anise.\"\n    \"Tender duck skewers, glazed with a sweet and tangy cantaloupe sauce, served over a bed of fragrant jasmine rice.\"\n  ]\n\n  nutrition: {\n    calories: 586\n    protein: \"12g\"\n    carbs: \"24g\"\n    fat: \"38g\"\n  }\n}"
  }
