    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@taut-settler.name\"\n  subject: \"Cariosus subito accommodo complectus nulla labore.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Turba pecco careo curtus cupiditate tendo tredecim. Decimus adaugeo quo. Corporis nihil commodi.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nTurbo iure audeo sumo carmen basium vix. Arguo adhuc summa civitas conitor volutabrum. Quasi agnosco canto cubo comis odio tristis nulla asper.\n\nVisit: {{url}}\n\"\"\"\n}"
