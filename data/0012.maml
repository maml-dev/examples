    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"austere-baritone.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.austere-baritone.org\"\n      \"mx2.austere-baritone.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.austere-baritone.org\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 146\n      per_hour: 9325\n    }\n  }\n}"
  }
