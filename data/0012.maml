    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"aws\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 5\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 16\n      target_cpu: 50\n    }\n  }\n\n  storage: {\n    type: \"nvme\"\n    size_gb: 133\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-fce0cfbb\"\n    subnet: \"10.58.0.0/16\"\n    public_ip: false\n  }\n}"
