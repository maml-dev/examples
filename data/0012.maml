    mamlText: "{\n  name: \"agreement-practical\"\n  version: \"6.16.1\"\n  description: \"Cribro magni amet dolor vulgo.\"\n  license: \"ISC\"\n\n  author: \"Megan Maggio\"\n  homepage: \"https://devoted-whale.info\"\n  repository: \"https://github.com/Fanny.Harber/agreement-practical\"\n\n  private: true\n  type: \"module\"\n}"
