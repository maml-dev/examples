    mamlText: "{\n  title: \"Congregatio considero accusamus animi.\"\n  slug: \"perspiciatis-arcesso-curia\"\n  author: {\n    name: \"Eladio Stoltenberg-Braun\"\n    avatar: \"https://avatars.githubusercontent.com/u/85885743\"\n    bio: \"educator\"\n  }\n  date: \"2026-05-31\"\n  tags: [\n    \"advertisement\"\n    \"in-joke\"\n    \"reconsideration\"\n  ]\n\n  published: true\n  reading_time: \"5 min\"\n  summary: \"Tener aegre curso laborum aperio ullus curia tonsor. Cernuus est stips adficio theologus dolore vorax. Ver comburo utpote adeo.\"\n}"
  }
