    mamlText: "{\n  base_url: \"/api/v1\"\n  routes: [\n    {\n      method: \"DELETE\"\n      path: \"/posts\"\n      handler: \"createOrders\"\n      auth: true\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/posts\"\n      handler: \"getUsers\"\n      auth: true\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/posts\"\n      handler: \"listUsers\"\n      auth: false\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/products/:id\"\n      handler: \"deleteOrders\"\n      auth: true\n    }\n\n    {\n      method: \"GET\"\n      path: \"/users\"\n      handler: \"createOrders\"\n      auth: false\n    }\n\n    {\n      method: \"POST\"\n      path: \"/products\"\n      handler: \"createProducts\"\n      auth: false\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/products/:id\"\n      handler: \"deleteUsers\"\n      auth: true\n    }\n  ]\n}"
