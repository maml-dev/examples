    mamlText: "{\n  provider: \"azure\"\n  region: \"eu-west-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 10\n    auto_scaling: {\n      enabled: true\n      min: 3\n      max: 15\n      target_cpu: 59\n    }\n  }\n\n  storage: {\n    type: \"nvme\"\n    size_gb: 380\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-b3c9d62d\"\n    subnet: \"10.38.0.0/16\"\n    public_ip: false\n  }\n}"
  }
