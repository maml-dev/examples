  {
    num: "12931"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"postgresql\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"tuxedo\"\n      \"goat\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 9\n    weekly: 10\n    monthly: 23\n  }\n\n  destination: {\n    type: \"local\"\n    path: \"s3://backups-obedience\"\n    encryption: true\n    compression: \"zstd\"\n  }\n}"
  }
