    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 17\"\n  tasks: [\n    {\n      id: \"LLHLI6\"\n      title: \"I'll quantify the optical SSL port, that should panel the SDD sensor!\"\n      assignee: \"Thalia Pouros\"\n      priority: \"low\"\n      status: \"done\"\n      points: 2\n    }\n\n    {\n      id: \"3F6NBF\"\n      title: \"If we index the sensor, we can get to the PCI bandwidth through the neural DRAM microchip!\"\n      assignee: \"Lauretta Cole-Klocko V\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 13\n    }\n\n    {\n      id: \"9YBBOD\"\n      title: \"Try to quantify the HEX firewall, maybe it will synthesize the redundant driver!\"\n      assignee: \"Katrina Morar\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 5\n    }\n\n    {\n      id: \"KCE8GK\"\n      title: \"I'll transmit the 1080p SQL matrix, that should bandwidth the PCI protocol!\"\n      assignee: \"Bertha Nader\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 13\n    }\n\n    {\n      id: \"04SEPR\"\n      title: \"The USB bandwidth is down, program the neural card so we can override the DRAM monitor!\"\n      assignee: \"Laurence Willms\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 2\n    }\n\n    {\n      id: \"NCK8HH\"\n      title: \"Use the bluetooth TLS circuit, then you can back up the virtual sensor!\"\n      assignee: \"Salvatore Keeling\"\n      priority: \"medium\"\n      status: \"review\"\n      points: 13\n    }\n  ]\n}"
