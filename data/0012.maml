    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"us-west-2\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 5\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 7\n      target_cpu: 53\n    }\n  }\n\n  storage: {\n    type: \"nvme\"\n    size_gb: 181\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-c7e1b482\"\n    subnet: \"10.46.0.0/16\"\n    public_ip: false\n  }\n}"
