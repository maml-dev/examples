    mamlText: "{\n  title: \"Jackfruit Carnitas\"\n  servings: 6\n  prep_time: \"25 minutes\"\n  cook_time: \"63 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 cups mussels\"\n    \"1 tsp saffron\"\n    \"4 oz slivered almonds\"\n    \"4 pieces grapefruit\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A slow-roasted Black-legged Kittiwake with a delicious, rich exterior. Stuffed with bush tomato and covered in custard apple sauce. Sides with jerusalem artichoke puree and wild peas.\"\n    \"Our moist lamb, slow-cooked to perfection, accompanied by steamed carrot and a rich, savory gravy.\"\n    \"A classic pie filled with delicious chicken and crispy flaxseed oil, baked in a spicy pastry crust and topped with a golden-brown lattice.\"\n    \"Baked strawberries-stuffed crocodile, seasoned with chillies and salty herbs, accompanied by roasted sun dried tomatoes medley.\"\n  ]\n\n  nutrition: {\n    calories: 367\n    protein: \"23g\"\n    carbs: \"41g\"\n    fat: \"5g\"\n  }\n}"
  }
