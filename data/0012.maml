  {
    num: "12016"
    title: "Email Config"
    description: "SMTP email service settings."
    shapeIndex: 0
    mamlText: "{\n  smtp_host: \"smtp.ornery-creature.net\"\n  smtp_port: 465\n  use_tls: true\n  from_name: \"Feeney, Schowalter and Lubowitz\"\n  from_email: \"noreply@ornery-creature.net\"\n\n  # Rate limiting\n  max_batch_size: 171\n  retry_interval: 148\n}"
  }
  {
    num: "12017"
    title: "App Settings"
    description: "Application environment configuration."
    shapeIndex: 0
    mamlText: "{\n  app_name: \"Ankunding Group\"\n  environment: \"development\"\n  debug: true\n  port: 8482\n\n  # Logging\n  log_level: \"info\"\n  log_format: \"pretty\"\n  api_version: \"v2\"\n  max_request_size: \"60mb\"\n}"
  }
  {
    num: "12018"
    title: "DNS Config"
    description: "DNS zone configuration."
    shapeIndex: 0
    mamlText: "{\n  zone: \"homely-porter.name\"\n  ttl: 86400 # seconds\n  nameservers: [\n    \"ns1.infamous-stall.info\"\n    \"ns2.firsthand-t-shirt.info\"\n  ]\n\n  soa_email: \"admin@insecure-publicity.info\"\n  refresh: 14400\n  retry: 1800\n  expire: 604800\n}"
  }
  {
    num: "12019"
    title: "Cron Schedule"
    description: "Task scheduler timing configuration."
    shapeIndex: 0
    mamlText: "{\n  timezone: \"Europe/Berlin\"\n  backup: \"0 2 * * *\" # daily at 2am\n  cleanup: \"0 */6 * * *\" # every 6 hours\n  report: \"0 9 * * 1\" # Monday 9am\n  healthcheck: \"*/5 * * * *\" # every 5 min\n\n  rotate_logs: \"0 0 1 * *\" # first of month\n  sync: \"30 * * * *\" # every hour at :30\n}"
  }
  {
    num: "12020"
    title: "Git Config"
    description: "Git client configuration."
    shapeIndex: 0
    mamlText: "{\n  user_name: \"Nathaniel Hickle\"\n  user_email: \"Leo.Parisian90@gmail.com\"\n  default_branch: \"trunk\"\n  auto_crlf: false\n\n  editor: \"nvim\"\n  gpg_sign: true\n  pull_rebase: true\n  push_autosetup: true\n}"
  }
  {
    num: "12021"
    title: "API Gateway"
    description: "API gateway routing and middleware configuration."
    shapeIndex: 1
    mamlText: "{\n  gateway: {\n    host: \"api.precious-commodity.org\"\n    port: 8443\n    protocol: \"https\"\n  }\n\n  # Rate limiting\n  rate_limit: {\n    enabled: true\n    window: \"5m\"\n    max_requests: 8701\n    by: \"ip\"\n  }\n\n  # CORS policy\n  cors: {\n    enabled: true\n    origins: [\n      \"https://weekly-formamide.com\"\n      \"https://app.worthwhile-characterization.com\"\n    ]\n    methods: [\n      \"GET\"\n      \"POST\"\n      \"PUT\"\n      \"DELETE\"\n    ]\n    max_age: 7200\n  }\n\n  cache: {\n    enabled: true\n    ttl: 2796\n    store: \"memory\"\n  }\n}"
  }
  {
    num: "12022"
    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"us-west-2\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 4\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 15\n      target_cpu: 78\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 51\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-ff8ecacf\"\n    subnet: \"10.195.0.0/16\"\n    public_ip: false\n  }\n}"
  }
  {
    num: "12023"
    title: "Monitoring Config"
    description: "Application monitoring and alerting setup."
    shapeIndex: 1
    mamlText: "{\n  service: \"blockchains\"\n  # Prometheus metrics\n  metrics: {\n    endpoint: \"/metrics\"\n    interval: 30 # seconds\n    labels: {\n      env: \"prod\"\n      region: \"eu-west\"\n      team: \"books\"\n    }\n  }\n\n  # Alert thresholds\n  alerts: {\n    cpu_threshold: 91\n    memory_threshold: 75\n    latency_p99_ms: 1060\n    error_rate: 0.01\n    notification: {\n      channel: \"#incidents\"\n      severity: \"warning\"\n    }\n  }\n}"
  }
  {
    num: "12024"
    title: "Monitoring Config"
    description: "Application monitoring and alerting setup."
    shapeIndex: 1
    mamlText: "{\n  service: \"e-commerce\"\n  # Prometheus metrics\n  metrics: {\n    endpoint: \"/metrics\"\n    interval: 10 # seconds\n    labels: {\n      env: \"prod\"\n      region: \"ap-south\"\n      team: \"books\"\n    }\n  }\n\n  # Alert thresholds\n  alerts: {\n    cpu_threshold: 71\n    memory_threshold: 94\n    latency_p99_ms: 963\n    error_rate: 0.05\n    notification: {\n      channel: \"#ops-alerts\"\n      severity: \"info\"\n    }\n  }\n}"
  }
  {
    num: "12025"
    title: "Terraform Resource"
    description: "Infrastructure as code resource definition."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"asia-southeast1\"\n  resources: {\n    # Network\n    vpc: {\n      cidr_block: \"10.230.0.0/16\"\n      enable_dns: true\n      tags: {\n        Name: \"litter-vpc\"\n        Environment: \"staging\"\n      }\n    }\n\n    # Compute\n    instance: {\n      ami: \"ami-ffe07326\"\n      type: \"t3.small\"\n      key_name: \"chasuble-key\"\n      monitoring: true\n      root_volume: {\n        size: 100\n        type: \"gp2\"\n        encrypted: true\n      }\n    }\n\n    # Security\n    security_group: {\n      name: \"allow-web\"\n      ingress_port: 80\n      ingress_cidr: \"0.0.0.0/0\"\n    }\n  }\n}"
  }
  {
    num: "12026"
    title: "Terraform Resource"
    description: "Infrastructure as code resource definition."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"us-east-1\"\n  resources: {\n    # Network\n    vpc: {\n      cidr_block: \"10.0.0.0/16\"\n      enable_dns: true\n      tags: {\n        Name: \"venom-vpc\"\n        Environment: \"production\"\n      }\n    }\n\n    # Compute\n    instance: {\n      ami: \"ami-ebca6c1b\"\n      type: \"t3.micro\"\n      key_name: \"gastropod-key\"\n      monitoring: true\n      root_volume: {\n        size: 100\n        type: \"io1\"\n        encrypted: true\n      }\n    }\n\n    # Security\n    security_group: {\n      name: \"allow-ssh\"\n      ingress_port: 443\n      ingress_cidr: \"0.0.0.0/0\"\n    }\n  }\n}"
  }
  {
    num: "12027"
    title: "Search Config"
    description: "Search engine index configuration."
    shapeIndex: 1
    mamlText: "{\n  engine: \"algolia\"\n  connection: {\n    host: \"search.internal:7700\"\n    api_key: \"iZz4jndu5sKejt9SPo5OBFjhCzm5833p\"\n    timeout: 9477\n  }\n\n  # Index settings\n  index: {\n    name: \"declaration\"\n    primary_key: \"id\"\n    searchable: [\n      \"title\"\n      \"description\"\n      \"content\"\n    ]\n    filterable: [\n      \"category\"\n      \"status\"\n      \"date\"\n    ]\n    sortable: [\n      \"date\"\n      \"relevance\"\n    ]\n  }\n\n  synonyms: {\n    js: [\n      \"javascript\"\n      \"ecmascript\"\n    ]\n    ts: [\n      \"typescript\"\n    ]\n  }\n}"
  }
  {
    num: "12028"
    title: "CI Pipeline"
    description: "Continuous integration pipeline definition."
    shapeIndex: 1
    mamlText: "{\n  name: \"Main Pipeline\"\n  trigger: {\n    branches: [\n      \"main\"\n      \"develop\"\n    ]\n    paths: [\n      \"src/**\"\n      \"tests/**\"\n    ]\n  }\n\n  stages: {\n    # Code quality\n    lint: {\n      image: \"node:18\"\n      command: \"npx eslint .\"\n    }\n    test: {\n      image: \"node:18\"\n      command: \"npx vitest\"\n      coverage: true\n    }\n    build: {\n      image: \"node:22\"\n      command: \"npm run build\"\n      artifacts: [\n        \"dist/**\"\n        \"build/**\"\n      ]\n    }\n  }\n}"
  }
  {
    num: "12029"
    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"gcp\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 9\n    auto_scaling: {\n      enabled: true\n      min: 3\n      max: 9\n      target_cpu: 70\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 425\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-bbf86d3a\"\n    subnet: \"10.122.0.0/16\"\n    public_ip: true\n  }\n}"
  }
  {
    num: "12030"
    title: "Theme Config"
    description: "Design system theme configuration."
    shapeIndex: 1
    mamlText: "{\n  name: \"swift Theme\"\n  # Color palette\n  colors: {\n    primary: \"#6b4cbe\"\n    secondary: \"#b53960\"\n    accent: \"#2d8e90\"\n    background: \"#ffffff\"\n    text: \"#1a1a1a\"\n\n    error: \"#dc3545\"\n    warning: \"#ffc107\"\n    success: \"#28a745\"\n  }\n\n  # Typography\n  typography: {\n    font_family: \"\\\"JetBrains Mono\\\", monospace\"\n    base_size: 14\n    line_height: 1.75\n    headings: {\n      font_family: \"\\\"Space Grotesk\\\", sans-serif\"\n      weight: 600\n    }\n  }\n\n  spacing: {\n    unit: 4\n    scale: [\n      0\n      4\n      8\n      16\n      24\n      32\n      48\n    ]\n  }\n  border_radius: 4\n}"
  }
  {
