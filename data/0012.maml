    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"azure\"\n  region: \"ap-southeast-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 8\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 20\n      target_cpu: 51\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 291\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-dc9b7933\"\n    subnet: \"10.58.0.0/16\"\n    public_ip: false\n  }\n}"
  }
  {
