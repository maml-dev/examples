  {
    num: "12359"
    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 1\"\n  tasks: [\n    {\n      id: \"BM5FQU\"\n      title: \"Use the back-end CSS panel, then you can parse the digital panel!\"\n      assignee: \"Lorenzo Murray I\"\n      priority: \"medium\"\n      status: \"todo\"\n      points: 3\n    }\n\n    {\n      id: \"YJWG8Y\"\n      title: \"The HTTP alarm is down, compress the haptic transmitter so we can connect the SDD card!\"\n      assignee: \"Briana Schroeder\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 13\n    }\n\n    {\n      id: \"LZP21Q\"\n      title: \"If we navigate the circuit, we can get to the SSL transmitter through the bluetooth PCI driver!\"\n      assignee: \"Deven Wuckert\"\n      priority: \"low\"\n      status: \"done\"\n      points: 3\n    }\n\n    {\n      id: \"N8WK2D\"\n      title: \"If we copy the sensor, we can get to the CLI feed through the solid state SCSI port!\"\n      assignee: \"Rebecca Cronin\"\n      priority: \"low\"\n      status: \"done\"\n      points: 1\n    }\n\n    {\n      id: \"VPWU3Z\"\n      title: \"Try to override the XSS sensor, maybe it will quantify the open-source microchip!\"\n      assignee: \"Zula Reinger\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 8\n    }\n\n    {\n      id: \"QXQDJY\"\n      title: \"The ADP hard drive is down, connect the 1080p monitor so we can connect the AGP alarm!\"\n      assignee: \"Jeanette Kertzmann\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 8\n    }\n  ]\n}"
  }
