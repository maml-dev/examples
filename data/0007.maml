  {
    num: "7670"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Seafood Paella\"\n  servings: 6\n  prep_time: \"15 minutes\"\n  cook_time: \"47 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 lbs pinto beans\"\n    \"3 oz white wine vinegar\"\n    \"1 tbsp apple cider vinegar\"\n    \"1 oz nashi pear\"\n    \"4 cups sweet chilli sauce\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A robust golden stew featuring Karnataka flavors, loaded with crunchy meat, crispy vegetables, and a salty, creamy broth.\"\n    \"A robust tender stew featuring Andhra flavors, loaded with smoky meat, moist vegetables, and a tangy, juicy broth.\"\n    \"Tender ostrich skewers, glazed with a sweet and tangy raspberry sauce, served over a bed of fragrant jasmine rice.\"\n    \"A succulent lamb steak, encased in a zesty balti masala crust, served with a side of cayenne pepper mashed chilli pepper.\"\n    \"A special white paprik from Iraq. To support the strong flavor it is sided with a tablespoon of cumin.\"\n    \"A classic pie filled with delicious turkey and spicy feijoa, baked in a fluffy pastry crust and topped with a golden-brown lattice.\"\n    \"A heartwarming Lithuanian soup, featuring fresh red lentils and an aromatic blend of traditional spices.\"\n  ]\n\n  nutrition: {\n    calories: 740\n    protein: \"16g\"\n    carbs: \"52g\"\n    fat: \"5g\"\n  }\n}"
  }
