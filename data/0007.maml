    mamlText: "{\n  domain: \"pastel-awareness.net\"\n  inbound: {\n    mx_records: [\n      \"mx1.pastel-awareness.net\"\n      \"mx2.pastel-awareness.net\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.pastel-awareness.net\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 224\n      per_hour: 3898\n    }\n  }\n}"
