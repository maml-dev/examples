    mamlText: "{\n  title: \"Banana And Blood Orange Tart\"\n  servings: 2\n  prep_time: \"24 minutes\"\n  cook_time: \"43 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 tbsp carob carrot\"\n    \"4 cups brown rice\"\n    \"3 oz avocado\"\n    \"3 lbs carob carrot\"\n    \"4 oz tamarillo\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A zesty beetroot creation, seasoned with herbes de provence and dill, showcasing the best of plant-based cuisine.\"\n    \"Savor the rich flavors of delicious sweet potato, complemented by avocado and marjoram.\"\n    \"Tenderly braised goose in a rich jalfrezi and radicchio sauce, served with a side of creamy cauliflower.\"\n  ]\n\n  nutrition: {\n    calories: 738\n    protein: \"13g\"\n    carbs: \"36g\"\n    fat: \"24g\"\n  }\n}"
