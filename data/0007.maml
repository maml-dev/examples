    mamlText: "{\n  roles: [\n    {\n      name: \"billing\"\n      permissions: [\n        \"write\"\n        \"delete\"\n        \"manage_users\"\n      ]\n      max_seats: 16\n    }\n\n    {\n      name: \"billing\"\n      permissions: [\n        \"manage_billing\"\n        \"delete\"\n        \"view_analytics\"\n        \"write\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"admin\"\n      permissions: [\n        \"export_data\"\n        \"write\"\n        \"manage_users\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"admin\"\n      permissions: [\n        \"read\"\n        \"manage_billing\"\n        \"delete\"\n        \"view_analytics\"\n        \"export_data\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"viewer\"\n      permissions: [\n        \"export_data\"\n        \"manage_users\"\n        \"read\"\n        \"write\"\n      ]\n      max_seats: 23\n    }\n\n    {\n      name: \"support\"\n      permissions: [\n        \"view_analytics\"\n        \"manage_users\"\n        \"read\"\n      ]\n      max_seats: 18\n    }\n  ]\n}"
  }
