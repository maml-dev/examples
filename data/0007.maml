    shapeIndex: 3
    mamlText: "{\n  title: \"Lemon-glazed Salmon Skewers\"\n  servings: 2\n  prep_time: \"10 minutes\"\n  cook_time: \"89 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 tbsp cherries\"\n    \"3 pieces white rice\"\n    \"3 cups rye\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A classic pie filled with delicious rabbit and crunchy flour, baked in a crispy pastry crust and topped with a golden-brown lattice.\"\n    \"Three barberry with hijiki, asparagus, butternut lettuce, asian greens and soymilk. With a side of baked mulberry, and your choice of rice noodles or brown mushrooms.\"\n    \"A delightful tart combining delicious lettuce and sweet custard apple, set in a buttery pastry shell and finished with a hint of mustard.\"\n  ]\n\n  nutrition: {\n    calories: 336\n    protein: \"26g\"\n    carbs: \"52g\"\n    fat: \"36g\"\n  }\n}"
