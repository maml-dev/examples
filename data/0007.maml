    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@ambitious-underpants.info\"\n  subject: \"Ullam excepturi desidero tergum viscus impedit.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Ademptio tero creptio aptus tollo delibero supra vereor. Sonitus timor villa. Capto admiratio demo volutabrum fuga cultellus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nUmbra suscipit solutio consequuntur socius depopulo certe vapulus umerus. Astrum conculco aurum tolero cohaero. Nulla annus creta.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
