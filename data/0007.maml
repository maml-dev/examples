    mamlText: "{\n  provider: \"jwt\"\n  # Token settings\n  jwt: {\n    secret_key: \"mwIKNAxFUmmWNNSgGSxh3qeF6QjS3dGj\"\n    algorithm: \"RS256\"\n    expiry: \"15m\"\n    refresh_expiry: \"90d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"qaiR0nwgJUC2RTYN8l1dQ5e6\"\n    authorize_url: \"https://auth.worst-brook.com/authorize\"\n    token_url: \"https://auth.outlying-pharmacopoeia.com/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"redis\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
