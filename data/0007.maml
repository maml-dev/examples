  {
    num: "7976"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Arepas\"\n  servings: 8\n  prep_time: \"56 minutes\"\n  cook_time: \"93 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 tbsp avocado\"\n    \"1 tsp beetroot\"\n    \"2 oz coriander seed\"\n    \"2 cups turkey\"\n    \"2 tbsp cream\"\n    \"1 tsp blue cheese\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A fresh beans creation, seasoned with ajwan seed and turmeric, showcasing the best of plant-based cuisine.\"\n    \"A heartwarming Balochi soup, featuring fresh dried chinese broccoli and an aromatic blend of traditional spices.\"\n    \"Juicy pork, grilled to your liking and drizzled with a bold peppercorns sauce, served alongside roasted peppers.\"\n    \"Grilled goose kebabs, marinated in American spices and served with a fresh beans and papaw salad.\"\n    \"Crispy fried salmon bites, seasoned with chilli and served with a tangy avocado dipping sauce.\"\n    \"Savor the rich flavors of sweet butternut lettuce, complemented by sultana and sweet laurel.\"\n  ]\n\n  nutrition: {\n    calories: 632\n    protein: \"29g\"\n    carbs: \"30g\"\n    fat: \"22g\"\n  }\n}"
  }
  {
