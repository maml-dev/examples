    mamlText: "{\n  domain: \"ashamed-equal.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.ashamed-equal.biz\"\n      \"mx2.ashamed-equal.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.ashamed-equal.biz\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 398\n      per_hour: 4876\n    }\n  }\n}"
