    mamlText: "{\n  sprint: \"Sprint 17\"\n  tasks: [\n    {\n      id: \"EXTWK1\"\n      title: \"navigating the protocol won't do anything, we need to compress the solid state HDD panel!\"\n      assignee: \"Jules Klocko\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 5\n    }\n\n    {\n      id: \"R3QZUA\"\n      title: \"We need to program the bluetooth AGP sensor!\"\n      assignee: \"Kyle Purdy\"\n      priority: \"high\"\n      status: \"done\"\n      points: 5\n    }\n\n    {\n      id: \"CYEPET\"\n      title: \"Use the digital IP transmitter, then you can bypass the bluetooth matrix!\"\n      assignee: \"Flora Prosacco\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 3\n    }\n\n    {\n      id: \"HS3CTC\"\n      title: \"Try to connect the PNG firewall, maybe it will override the haptic panel!\"\n      assignee: \"Cecilia Beatty\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 13\n    }\n\n    {\n      id: \"8NWTW9\"\n      title: \"Use the 1080p UTF8 port, then you can calculate the solid state transmitter!\"\n      assignee: \"Aubrey Okuneva\"\n      priority: \"low\"\n      status: \"review\"\n      points: 8\n    }\n\n    {\n      id: \"4LJ4AO\"\n      title: \"Try to index the CLI hard drive, maybe it will calculate the neural array!\"\n      assignee: \"Easter Blanda\"\n      priority: \"critical\"\n      status: \"review\"\n      points: 3\n    }\n  ]\n}"
  }
