  {
    num: "7561"
    title: "Blog Post"
    description: "A blog post with metadata and content sections."
    shapeIndex: 3
    mamlText: "{\n  title: \"Vox caelum ancilla ventito aeternus aperio auctor.\"\n  slug: \"quos-distinctio-capto\"\n  author: {\n    name: \"Colin Leuschke\"\n    avatar: \"https://avatars.githubusercontent.com/u/29656192\"\n    bio: \"gamer, public speaker, philosopher\"\n  }\n  date: \"2026-05-04\"\n  tags: [\n    \"developing\"\n    \"yogurt\"\n    \"councilman\"\n  ]\n\n  published: true\n  reading_time: \"10 min\"\n  summary: \"Antepono absum vulgaris arcesso accommodo via calco cunae pecus assumenda. Est tepidus demitto caelestis argumentum subito deficio. Caelestis corpus appositus dolore statua custodia basium theca volutabrum arceo.\"\n}"
  }
  {
    num: "7562"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Pizza\"\n  servings: 4\n  prep_time: \"44 minutes\"\n  cook_time: \"62 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 lbs lemon\"\n    \"3 oz fromage blanc\"\n    \"2 cups cocoa powder\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Our delicious lamb, slow-cooked to perfection, accompanied by steamed leeks and a rich, savory gravy.\"\n    \"Three cocoa powder with hijiki, arugula, red pepper, okra and starfruit. With a side of baked mangosteen, and your choice of swordfish or curry leaves.\"\n    \"A juicy onion creation, seasoned with lemon pepper and achiote seed, showcasing the best of plant-based cuisine.\"\n    \"A succulent duck steak, encased in a bitter dill crust, served with a side of garam masala mashed okra.\"\n  ]\n\n  nutrition: {\n    calories: 689\n    protein: \"26g\"\n    carbs: \"16g\"\n    fat: \"9g\"\n  }\n}"
  }
