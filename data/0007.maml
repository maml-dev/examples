    mamlText: "{\n  name: \"bonfire-hooks\"\n  secret: \"ybCwf20Sdmj0bgSXY8hDFuVE9W8oB6ei\"\n  endpoints: [\n    {\n      url: \"https://stingy-word.org//webhook\"\n      events: [\n        \"create\"\n        \"update\"\n        \"delete\"\n      ]\n      active: true\n    }\n\n    {\n      url: \"https://strident-lay.info/callback\"\n      events: [\n        \"payment.success\"\n        \"payment.failed\"\n      ]\n      active: true\n    }\n  ]\n\n  retry: {\n    max_attempts: 8\n    backoff: \"linear\"\n    interval: 45 # seconds\n  }\n  timeout: 14 # seconds\n}"
