  {
    num: "7221"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"localhost\"\n    databases: [\n      \"parsnip\"\n      \"tentacle\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 11\n    weekly: 7\n    monthly: 12\n  }\n\n  destination: {\n    type: \"gcs\"\n    path: \"s3://backups-boulevard\"\n    encryption: true\n    compression: \"gzip\"\n  }\n}"
  }
  {
    num: "7222"
    title: "Terraform Resource"
    description: "Infrastructure as code resource definition."
    shapeIndex: 1
    mamlText: "{\n  provider: \"google\"\n  region: \"eu-west-1\"\n  resources: {\n    # Network\n    vpc: {\n      cidr_block: \"10.83.0.0/16\"\n      enable_dns: true\n      tags: {\n        Name: \"lender-vpc\"\n        Environment: \"production\"\n      }\n    }\n\n    # Compute\n    instance: {\n      ami: \"ami-f0db3cd5\"\n      type: \"m5.large\"\n      key_name: \"pecan-key\"\n      monitoring: true\n      root_volume: {\n        size: 20\n        type: \"gp2\"\n        encrypted: true\n      }\n    }\n\n    # Security\n    security_group: {\n      name: \"allow-all\"\n      ingress_port: 443\n      ingress_cidr: \"0.0.0.0/0\"\n    }\n  }\n}"
  }
  {
    num: "7223"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"alarmed-apricot.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.alarmed-apricot.info\"\n      \"mx2.alarmed-apricot.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.alarmed-apricot.info\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 210\n      per_hour: 7789\n    }\n  }\n}"
  }
  {
