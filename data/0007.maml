    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"mealy-legislature.name\"\n  inbound: {\n    mx_records: [\n      \"mx1.mealy-legislature.name\"\n      \"mx2.mealy-legislature.name\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.mealy-legislature.name\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 118\n      per_hour: 2965\n    }\n  }\n}"
