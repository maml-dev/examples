  {
    num: "7073"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Broccoli And Asian Noodles Stew\"\n  servings: 7\n  prep_time: \"29 minutes\"\n  cook_time: \"116 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 tsp cornichons\"\n    \"2 oz hokkien noodles\"\n    \"2 tsp chicken stock\"\n    \"2 pieces feijoa\"\n    \"1 lbs buttermilk\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A robust salty stew featuring Turkish flavors, loaded with salty meat, fresh vegetables, and a fluffy, smoky broth.\"\n    \"A crunchy bok choy creation, seasoned with parsley and cloves, showcasing the best of plant-based cuisine.\"\n    \"Juicy lamb, grilled to your liking and drizzled with a bold sweet basil sauce, served alongside roasted artichoke.\"\n    \"A simple avocado pie. No fancy stuff. Just pie.\"\n    \"Tender beef skewers, glazed with a sweet and tangy kiwiberry sauce, served over a bed of fragrant jasmine rice.\"\n  ]\n\n  nutrition: {\n    calories: 628\n    protein: \"43g\"\n    carbs: \"34g\"\n    fat: \"27g\"\n  }\n}"
  }
