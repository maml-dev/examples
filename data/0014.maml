    mamlText: "{\n  date: \"2026-08-24\"\n  events: [\n    {\n      time: \"18:30\"\n      title: \"Stips administratio demoror earum.\"\n      duration: \"2h\"\n      location: \"Main Hall\"\n    }\n\n    {\n      time: \"16:00\"\n      title: \"Infit civitas aliquid suspendo.\"\n      duration: \"1h30m\"\n      location: \"Virtual\"\n    }\n\n    {\n      time: \"15:45\"\n      title: \"Cerno tepidus bis coniuratio vaco.\"\n      duration: \"2h\"\n      location: \"Room J5\"\n    }\n\n    {\n      time: \"08:45\"\n      title: \"Demitto adipisci tristis stultus qui.\"\n      duration: \"1h\"\n      location: \"Lobby\"\n    }\n\n    {\n      time: \"09:00\"\n      title: \"Audeo thesaurus universe cogito.\"\n      duration: \"1h30m\"\n      location: \"Lobby\"\n    }\n\n    {\n      time: \"13:30\"\n      title: \"Angulus corporis cum vix conatus.\"\n      duration: \"15m\"\n      location: \"Main Hall\"\n    }\n\n    {\n      time: \"09:00\"\n      title: \"Quas decens utpote curto consuasor.\"\n      duration: \"15m\"\n      location: \"Shanahan LLC HQ\"\n    }\n\n    {\n      time: \"17:45\"\n      title: \"Explicabo abundans venio degusto solutio causa.\"\n      duration: \"2h\"\n      location: \"Virtual\"\n    }\n  ]\n}"
