    title: "K8s Deployment"
    description: "Kubernetes deployment specification."
    shapeIndex: 1
    mamlText: "{\n  apiVersion: \"apps/v1\"\n  kind: \"Deployment\"\n  metadata: {\n    name: \"cannon-worker\"\n    namespace: \"staging\"\n    labels: {\n      app: \"polarisation\"\n      tier: \"backend\"\n    }\n  }\n\n  # Deployment spec\n  spec: {\n    replicas: 2\n    container: {\n      image: \"harp:0.13.11\"\n      port: 8000\n      resources: {\n        cpu_limit: \"500m\"\n        memory_limit: \"1Gi\"\n      }\n    }\n\n    health_check: {\n      path: \"/health\"\n      interval: 30\n      timeout: 5\n    }\n  }\n}"
  }
  {
    num: "14441"
    title: "API Routes"
    description: "REST API route definitions."
    shapeIndex: 2
    mamlText: "{\n  base_url: \"/api/v1\"\n  routes: [\n    {\n      method: \"POST\"\n      path: \"/users/:id\"\n      handler: \"getUsers\"\n      auth: true\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/products\"\n      handler: \"getPosts\"\n      auth: true\n    }\n\n    {\n      method: \"PATCH\"\n      path: \"/comments/:id\"\n      handler: \"deleteProducts\"\n      auth: false\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/products\"\n      handler: \"createProducts\"\n      auth: false\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/posts\"\n      handler: \"createPosts\"\n      auth: false\n    }\n\n    {\n      method: \"DELETE\"\n      path: \"/orders\"\n      handler: \"getOrders\"\n      auth: true\n    }\n  ]\n}"
  }
