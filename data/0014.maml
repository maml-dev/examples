    mamlText: "{\n  application: \"smart contracts\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: backing up the program won't do anything, we need to input the online SSL firewall!\n    at /etc/defaults/hence.opus:174\n    at /bin/eyeglasses_where_augment.3gp:431\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPUT /api/dash HTTP/1.1\nHost: coordinated-apricot.org\nUser-Agent: Mozilla/5.0 (Macintosh; U; Intel Mac OS X 10_15_7) AppleWebKit/549.90.40 (KHTML, like Gecko) Chrome/88.5.8.14 Safari/600.73.64\nAccept: application/json\n\"\"\"\n  retention_days: 77\n}"
