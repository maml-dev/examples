    mamlText: "{\n  title: \"Grapefruit-infused Chicken Roast\"\n  servings: 6\n  prep_time: \"46 minutes\"\n  cook_time: \"72 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"4 tsp shiitake mushrooms\"\n    \"2 oz avocado\"\n    \"1 tbsp brown rice\"\n    \"2 cups squid\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A delightful tart combining bitter broccolini and sweet kiwiberry, set in a buttery pastry shell and finished with a hint of garam masala.\"\n    \"A classic pie filled with delicious crocodile and moist parrotfish, baked in a fluffy pastry crust and topped with a golden-brown lattice.\"\n    \"Fresh caraway seed with a pinch of dhansak, topped by a caramelized mulberry with whipped cream\"\n    \"24-day aged crocodile steak, with choice of 2 sides.\"\n    \"A delightful tart combining fresh carrot and sweet blackberry, set in a buttery pastry shell and finished with a hint of orange zest.\"\n    \"Tenderly braised turkey in a rich five spice and snowpea sprouts sauce, served with a side of creamy jicama.\"\n  ]\n\n  nutrition: {\n    calories: 685\n    protein: \"15g\"\n    carbs: \"54g\"\n    fat: \"14g\"\n  }\n}"
  }
  {
    num: "14472"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"California Maki\"\n  servings: 5\n  prep_time: \"28 minutes\"\n  cook_time: \"88 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 cups lavender flowers\"\n    \"3 lbs brussels sprouts\"\n    \"2 tbsp star anise\"\n    \"3 cups mountain bread\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Hearty agave syrup and salmon stew, slow-cooked with rosemary and onion for a comforting, flavorful meal.\"\n    \"Juicy pigeon, grilled to your liking and drizzled with a bold cardamom sauce, served alongside roasted dried chinese broccoli.\"\n    \"A slow-roasted Mexican Chickadee with a tender, crispy exterior. Stuffed with mandarin and covered in mango sauce. Sides with asparagus puree and wild green pepper.\"\n    \"A heartwarming Thai soup, featuring fresh tabasco and an aromatic blend of traditional spices.\"\n    \"Grilled emu kebabs, marinated in Chechen spices and served with a fresh cos lettuce and loquat salad.\"\n    \"Hearty horseradish and kangaroo stew, slow-cooked with cumin and brussels sprouts for a comforting, flavorful meal.\"\n    \"A succulent chicken steak, encased in a savory chives crust, served with a side of anise star mashed chives.\"\n  ]\n\n  nutrition: {\n    calories: 297\n    protein: \"6g\"\n    carbs: \"66g\"\n    fat: \"9g\"\n  }\n}"
  }
