    mamlText: "# Aund Changelog\n{\n  project: \"cheetah\"\n  releases: [\n    {\n      version: \"4.7.17\"\n      date: \"2026-07-21\"\n      notes: \"\"\"\nAdded:\n- generate open-source matrix\n- navigate auxiliary driver\n\nFixed:\n- generate bluetooth array\n\"\"\"\n    }\n\n    {\n      version: \"6.8.16\"\n      date: \"2026-07-21\"\n      notes: \"\"\"\nChanged:\n- program digital port\n\nRemoved:\n- navigate optical bandwidth\n\"\"\"\n    }\n\n    {\n      version: \"0.3.12\"\n      date: \"2026-03-10\"\n      notes: \"\"\"\nInitial release:\n- bypass optical microchip\n- connect multi-byte card\n- input bluetooth port\n\"\"\"\n    }\n  ]\n}"
