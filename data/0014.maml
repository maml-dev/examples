    mamlText: "{\n  title: \"Lentil Bolognese\"\n  servings: 4\n  prep_time: \"32 minutes\"\n  cook_time: \"100 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 pieces albacore tuna\"\n    \"4 tsp pandanus leaves\"\n    \"1 pieces cumquat\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Fresh buckwheat noodles with a pinch of zahtar, topped by a caramelized mangosteen with whipped cream\"\n    \"Tender duck skewers, glazed with a sweet and tangy bush tomato sauce, served over a bed of fragrant jasmine rice.\"\n    \"Fresh mixed greens tossed with green cardamom-rubbed salmon, fresh chillies, and a light dressing.\"\n    \"A robust smoky stew featuring Chinese flavors, loaded with crispy meat, salty vegetables, and a tangy, salty broth.\"\n    \"A heartwarming Pennsylvania Dutch soup, featuring fresh chicken and an aromatic blend of traditional spices.\"\n    \"A robust sweet stew featuring Bangladeshi flavors, loaded with salty meat, delicious vegetables, and a tangy, salty broth.\"\n  ]\n\n  nutrition: {\n    calories: 404\n    protein: \"43g\"\n    carbs: \"91g\"\n    fat: \"18g\"\n  }\n}"
  }
