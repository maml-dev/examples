  {
    num: "14125"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"postgresql\"\n    host: \"localhost\"\n    databases: [\n      \"government\"\n      \"bathhouse\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 11\n    weekly: 11\n    monthly: 8\n  }\n\n  destination: {\n    type: \"gcs\"\n    path: \"s3://backups-courtroom\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
  }
  {
    num: "14126"
