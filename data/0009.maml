    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"mysterious-provider.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.mysterious-provider.biz\"\n      \"mx2.mysterious-provider.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.mysterious-provider.biz\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 149\n      per_hour: 5193\n    }\n  }\n}"
  }
