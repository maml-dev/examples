    mamlText: "# Email template configuration\n{\n  from: \"noreply@coarse-inspection.com\"\n  subject: \"Toties carbo taedium deficio antepono perferendis.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Stabilis vel surculus beatus. Dignissimos vomica delectatio vereor cohaero subito aspernatur. Tumultus apud ancilla adamo patior condico tondeo urbanus acerbitas.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nAlioqui aveho creptio xiphias. Caste cupiditas curia. Ipsam baiulus totidem dolorem amitto.\n\nVisit: {{url}}\n\"\"\"\n}"
