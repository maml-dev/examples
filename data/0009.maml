    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@dapper-silk.name\"\n  subject: \"Sponte asporto cultellus tracto.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Consectetur qui ceno utpote abstergo studio. Vergo canis cresco viridis cras sonitus artificiose demergo. Quidem illo toties varius comprehendo ocer sursum voluptatem sortitus deserunt.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nDesolo sodalitas argumentum valens administratio considero thermae aliqua vulnero tabesco. Arbitro sodalitas vos blanditiis. Derelinquo clibanus statim patruus.\n\nVisit: {{url}}\n\"\"\"\n}"
