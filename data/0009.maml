    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@afraid-encouragement.name\"\n  subject: \"Cunctatio trepide occaecati summopere curvo.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Tener tabula degenero denique animus patrocinor capillus convoco tamquam vomito. Suasoria deludo tonsor abeo. Sequi caute sui.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nVinitor id arca. Arca ascit tergo desipio thymum ocer usitas adfero. Demo voluptatibus talio verecundia ex pecco communis pel.\n\nVisit: {{url}}\n\"\"\"\n}"
