  {
    num: "9441"
    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 42\"\n  tasks: [\n    {\n      id: \"MOLRAX\"\n      title: \"You can't program the transmitter without indexing the haptic CLI hard drive!\"\n      assignee: \"Mr. Justus Rowe\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 3\n    }\n\n    {\n      id: \"5MBNLJ\"\n      title: \"Try to connect the SCSI monitor, maybe it will compress the haptic firewall!\"\n      assignee: \"Alexie Boehm-Romaguera\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 3\n    }\n\n    {\n      id: \"I8EN0C\"\n      title: \"We need to reboot the cross-platform HTTP bus!\"\n      assignee: \"Lindsay Gibson\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 2\n    }\n\n    {\n      id: \"APIQ6J\"\n      title: \"If we override the program, we can get to the IB circuit through the digital JSON alarm!\"\n      assignee: \"Santiago Skiles\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 1\n    }\n\n    {\n      id: \"XPQZVL\"\n      title: \"navigating the sensor won't do anything, we need to calculate the digital RSS bus!\"\n      assignee: \"Gina Rice\"\n      priority: \"low\"\n      status: \"done\"\n      points: 2\n    }\n\n    {\n      id: \"FJDUIY\"\n      title: \"Try to reboot the SMTP pixel, maybe it will compress the back-end pixel!\"\n      assignee: \"Alexandrine Senger\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 2\n    }\n  ]\n}"
  }
