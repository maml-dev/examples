    mamlText: "# Tump Changelog\n{\n  project: \"riser\"\n  releases: [\n    {\n      version: \"8.14.15\"\n      date: \"2026-06-23\"\n      notes: \"\"\"\nAdded:\n- copy bluetooth application\n- calculate optical transmitter\n\nFixed:\n- program digital card\n\"\"\"\n    }\n\n    {\n      version: \"2.12.6\"\n      date: \"2026-06-04\"\n      notes: \"\"\"\nChanged:\n- synthesize redundant application\n\nRemoved:\n- back up neural sensor\n\"\"\"\n    }\n\n    {\n      version: \"4.1.15\"\n      date: \"2026-01-29\"\n      notes: \"\"\"\nInitial release:\n- calculate back-end program\n- connect open-source bandwidth\n- navigate optical monitor\n\"\"\"\n    }\n  ]\n}"
