    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"gcp\"\n  region: \"eu-west-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"t3.medium\"\n    count: 7\n    auto_scaling: {\n      enabled: true\n      min: 2\n      max: 19\n      target_cpu: 72\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 90\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-b9893bcd\"\n    subnet: \"10.244.0.0/16\"\n    public_ip: true\n  }\n}"
  }
  {
    num: "9035"
    title: "Terraform Resource"
    description: "Infrastructure as code resource definition."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"asia-southeast1\"\n  resources: {\n    # Network\n    vpc: {\n      cidr_block: \"10.234.0.0/16\"\n      enable_dns: true\n      tags: {\n        Name: \"bowler-vpc\"\n        Environment: \"production\"\n      }\n    }\n\n    # Compute\n    instance: {\n      ami: \"ami-98bebcf1\"\n      type: \"t3.micro\"\n      key_name: \"inspection-key\"\n      monitoring: true\n      root_volume: {\n        size: 100\n        type: \"gp3\"\n        encrypted: true\n      }\n    }\n\n    # Security\n    security_group: {\n      name: \"allow-all\"\n      ingress_port: 80\n      ingress_cidr: \"0.0.0.0/0\"\n    }\n  }\n}"
  }
  {
    num: "9036"
