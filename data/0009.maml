    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 16\"\n  tasks: [\n    {\n      id: \"XCSBWG\"\n      title: \"Try to calculate the CLI firewall, maybe it will input the mobile firewall!\"\n      assignee: \"Matilde Beer\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 2\n    }\n\n    {\n      id: \"70HFCY\"\n      title: \"We need to transmit the digital SMTP application!\"\n      assignee: \"Morton Osinski\"\n      priority: \"low\"\n      status: \"review\"\n      points: 13\n    }\n\n    {\n      id: \"IIDZNQ\"\n      title: \"Use the open-source FTP feed, then you can quantify the haptic panel!\"\n      assignee: \"Yasmeen Skiles\"\n      priority: \"high\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"FZ4KS3\"\n      title: \"We need to program the mobile CLI card!\"\n      assignee: \"Savanna Kreiger\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 1\n    }\n\n    {\n      id: \"9BZGR2\"\n      title: \"If we copy the pixel, we can get to the TCP bandwidth through the haptic THX transmitter!\"\n      assignee: \"Patsy Bashirian\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 13\n    }\n\n    {\n      id: \"HIOBCK\"\n      title: \"We need to compress the primary SDD pixel!\"\n      assignee: \"Lucy Ledner\"\n      priority: \"critical\"\n      status: \"done\"\n      points: 3\n    }\n  ]\n}"
