  {
    num: "9969"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Salmon Steak\"\n  servings: 6\n  prep_time: \"18 minutes\"\n  cook_time: \"98 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"1 cups spinach\"\n    \"3 pieces dandelion\"\n    \"1 oz achacha\"\n    \"4 tbsp ricotta\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Three nori with okra, butternut lettuce, beetroot, zucchini and papaw. With a side of baked starfruit, and your choice of pumpkin or wholegrain bread.\"\n    \"Fresh mixed greens tossed with fines herbes-rubbed quail, cos lettuce, and a light dressing.\"\n    \"A heartwarming Zanzibari soup, featuring fresh monkfish and an aromatic blend of traditional spices.\"\n    \"A delightful tart combining tender parsnip and sweet watermelon, set in a buttery pastry shell and finished with a hint of anise.\"\n    \"A delightful tart combining golden jerusalem artichoke and sweet juniper berry, set in a buttery pastry shell and finished with a hint of cumin.\"\n    \"Baked tahini-stuffed lamb, seasoned with lavender and rich herbs, accompanied by roasted pumpkin medley.\"\n    \"An exquisite crocodile roast, infused with the essence of raspberry, slow-roasted to bring out its natural flavors and served with a side of creamy spinach\"\n  ]\n\n  nutrition: {\n    calories: 639\n    protein: \"14g\"\n    carbs: \"24g\"\n    fat: \"30g\"\n  }\n}"
  }
