    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"filesystem\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"sermon\"\n      \"thread\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 7\n    weekly: 6\n    monthly: 20\n  }\n\n  destination: {\n    type: \"sftp\"\n    path: \"s3://backups-thorn\"\n    encryption: true\n    compression: \"lz4\"\n  }\n}"
