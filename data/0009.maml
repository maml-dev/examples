    mamlText: "# Ruffel Changelog\n{\n  project: \"fund\"\n  releases: [\n    {\n      version: \"7.5.17\"\n      date: \"2026-06-23\"\n      notes: \"\"\"\nAdded:\n- hack auxiliary matrix\n- parse primary bus\n\nFixed:\n- calculate optical bandwidth\n\"\"\"\n    }\n\n    {\n      version: \"4.8.6\"\n      date: \"2026-05-28\"\n      notes: \"\"\"\nChanged:\n- connect open-source program\n\nRemoved:\n- index back-end hard drive\n\"\"\"\n    }\n\n    {\n      version: \"2.12.20\"\n      date: \"2026-05-18\"\n      notes: \"\"\"\nInitial release:\n- parse 1080p microchip\n- bypass auxiliary bus\n- transmit mobile bus\n\"\"\"\n    }\n  ]\n}"
