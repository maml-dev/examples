    mamlText: "{\n  application: \"relationships\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: Use the open-source COM feed, then you can quantify the digital system!\n    at /usr/ports/mealy_ah_however.mp2a:342\n    at /var/yp/commemorate_irritably_er.deploy:422\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPUT /api/omelet HTTP/1.1\nHost: uncommon-legend.com\nUser-Agent: Mozilla/5.0 (Linux; Android 9; SM-G998N) AppleWebKit/543.14 (KHTML, like Gecko) Chrome/115.0.15.9 Mobile Safari/554.90\nAccept: application/json\n\"\"\"\n  retention_days: 45\n}"
