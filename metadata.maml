    mamlText: "{\n  title: \"Patior amoveo fugit bonus ullus conservo peccatus absens.\"\n  slug: \"consuasor-coniuratio-ad\"\n  author: {\n    name: \"Foster Hayes-Gorczany\"\n    avatar: \"https://avatars.githubusercontent.com/u/49269241\"\n    bio: \"bowler devotee, nerd 📦\"\n  }\n  date: \"2026-04-20\"\n  tags: [\n    \"earth\"\n    \"elevation\"\n    \"printer\"\n  ]\n\n  published: true\n  reading_time: \"5 min\"\n  summary: \"Creber pariatur absum. Comminor stabilis tenus vinum volo vesper bardus quas ciminatio. Earum triumphus cicuta animus demoror vado thymum cilicium vel contigo.\"\n}"
