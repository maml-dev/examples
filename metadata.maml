    mamlText: "{\n  provider: \"aws\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 2\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 20\n      target_cpu: 59\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 316\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-c60ce2bb\"\n    subnet: \"10.178.0.0/16\"\n    public_ip: true\n  }\n}"
  }
