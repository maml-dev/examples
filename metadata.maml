    mamlText: "{\n  application: \"schemas\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: I'll hack the online DNS monitor, that should port the SQL hard drive!\n    at /usr/libexec/drat.opus:108\n    at /var/yp/likewise.dot:61\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPUT /api/prohibition HTTP/1.1\nHost: unconscious-handover.com\nUser-Agent: Googlebot/2.1 (+http://www.google.com/bot.html)\nAccept: application/json\n\"\"\"\n  retention_days: 56\n}"
