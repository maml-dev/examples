    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"strange-excess.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.strange-excess.org\"\n      \"mx2.strange-excess.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.strange-excess.org\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 146\n      per_hour: 3951\n    }\n  }\n}"
  }
  {
    num: "13435"
    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"azure\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"t3.medium\"\n    count: 2\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 15\n      target_cpu: 59\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 48\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-ef6acd2d\"\n    subnet: \"10.171.0.0/16\"\n    public_ip: true\n  }\n}"
