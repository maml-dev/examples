    mamlText: "{\n  zone: \"soulful-testimonial.net\"\n  ttl: 600 # seconds\n  nameservers: [\n    \"ns1.bare-window.com\"\n    \"ns2.scratchy-hepatitis.info\"\n  ]\n\n  soa_email: \"admin@stark-substitution.com\"\n  refresh: 3600\n  retry: 1800\n  expire: 1209600\n}"
