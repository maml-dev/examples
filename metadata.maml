    mamlText: "{\n  app_name: \"Stokes, Towne and Stokes\"\n  environment: \"production\"\n  debug: false\n  port: 4955\n\n  # Logging\n  log_level: \"warn\"\n  log_format: \"text\"\n  api_version: \"v4\"\n  max_request_size: \"56mb\"\n}"
