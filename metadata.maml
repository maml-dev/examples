  {
    num: "12698"
    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@unsightly-platter.com\"\n  subject: \"Cibus acervus acquiro vapulus cunabula.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Caveo conitor stipes verecundia tamdiu arbustum abbas antea terminatio. Ter truculenter tredecim voluptatum acerbitas corroboro sopor cometes. Ambitus aegrus temporibus vito depraedor argumentum balbus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nAntepono utor itaque clarus condico sumo trado deputo laboriosam. Dicta impedit blanditiis pecus. Cogito cognomen suspendo aestivus placeat annus stips contra.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
