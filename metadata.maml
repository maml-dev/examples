    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@putrid-membership.info\"\n  subject: \"Carus consequatur coma.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Soluta utrum crepusculum vitae acies. Quasi baiulus contigo acer. Chirographum talio dolorum tondeo patria vinculum.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nColor facere confido cotidie cupiditas. Sodalitas praesentium supellex depopulo turpis agnitio textilis cubitum utroque accusator. Coniuratio aestus volo perferendis abutor inflammatio taceo ascit tener calamitas.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
