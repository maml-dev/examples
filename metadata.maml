    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"filesystem\"\n    host: \"localhost\"\n    databases: [\n      \"halt\"\n      \"pulse\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 10\n    weekly: 8\n    monthly: 10\n  }\n\n  destination: {\n    type: \"s3\"\n    path: \"s3://backups-instance\"\n    encryption: true\n    compression: \"gzip\"\n  }\n}"
  }
