    mamlText: "{\n  name: \"window-well-worn\"\n  version: \"6.0.10\"\n  description: \"Terreo sub qui thymum itaque aliquam dedecor.\"\n  license: \"ISC\"\n\n  author: \"Marcelino Shanahan\"\n  homepage: \"https://breakable-scaffold.org\"\n  repository: \"https://github.com/Yazmin57/window-well-worn\"\n\n  private: true\n  type: \"module\"\n}"
