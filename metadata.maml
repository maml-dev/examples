  {
    num: "15230"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"lazy-reasoning.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.lazy-reasoning.biz\"\n      \"mx2.lazy-reasoning.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.lazy-reasoning.biz\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 468\n      per_hour: 4967\n    }\n  }\n}"
  }
  {
