    mamlText: "{\n  title: \"Balbus sub condico creta aeternus vindico argumentum pauper.\"\n  slug: \"cupiditate-animi-vallum\"\n  author: {\n    name: \"Haylie Hartmann\"\n    avatar: \"https://cdn.jsdelivr.net/gh/faker-js/assets-person-portrait/male/512/58.jpg\"\n    bio: \"designer\"\n  }\n  date: \"2026-03-11\"\n  tags: [\n    \"tribe\"\n    \"subsidy\"\n    \"median\"\n  ]\n\n  published: false\n  reading_time: \"10 min\"\n  summary: \"Repellat quo universe comedo tener benigne velit ulciscor tempora arbor. Consuasor harum video speciosus tergo bis adaugeo. Allatus aperio vulpes audacia adhaero vitae vox vulgus.\"\n}"
