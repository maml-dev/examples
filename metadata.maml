    mamlText: "{\n  application: \"lifetime value\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: I'll generate the primary SSD capacitor, that should feed the USB capacitor!\n    at /usr/ports/as.json:465\n    at /sbin/once_yuck.m3a:133\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nGET /api/story HTTP/1.1\nHost: wee-courtroom.org\nUser-Agent: FakerBot/2.10.9\nAccept: application/json\n\"\"\"\n  retention_days: 20\n}"
