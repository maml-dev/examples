  {
    num: "7321"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mongodb\"\n    host: \"primary.db.internal\"\n    databases: [\n      \"millet\"\n      \"retrospectivity\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 10\n    weekly: 10\n    monthly: 23\n  }\n\n  destination: {\n    type: \"gcs\"\n    path: \"/mnt/backups/detective\"\n    encryption: true\n    compression: \"zstd\"\n  }\n}"
  }
  {
    num: "7322"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"lovable-peninsula.name\"\n  inbound: {\n    mx_records: [\n      \"mx1.lovable-peninsula.name\"\n      \"mx2.lovable-peninsula.name\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.lovable-peninsula.name\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 270\n      per_hour: 2396\n    }\n  }\n}"
  }
  {
    num: "7323"
    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"eu-west-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"t3.medium\"\n    count: 4\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 13\n      target_cpu: 77\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 211\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-45f0f0c2\"\n    subnet: \"10.228.0.0/16\"\n    public_ip: false\n  }\n}"
  }
  {
    num: "7324"
    title: "GraphQL Schema"
    description: "GraphQL type and resolver configuration."
    shapeIndex: 1
    mamlText: "{\n  schema: {\n    query: \"Query\"\n    mutation: \"Mutation\"\n  }\n\n  types: {\n    # User type\n    User: {\n      fields: {\n        id: \"ID!\"\n        name: \"String!\"\n        email: \"String!\"\n        avatar: \"String\"\n        posts: \"[Post!]!\"\n        role: \"Role!\"\n      }\n    }\n\n    # Post type\n    Post: {\n      fields: {\n        id: \"ID!\"\n        title: \"String!\"\n        body: \"String!\"\n        author: \"User!\"\n        published: \"Boolean!\"\n        created_at: \"DateTime!\"\n      }\n    }\n  }\n\n  resolvers: {\n    cache: true\n    max_depth: 8\n    max_complexity: 499\n  }\n}"
  }
  {
    num: "7325"
    title: "K8s Deployment"
    description: "Kubernetes deployment specification."
    shapeIndex: 1
    mamlText: "{\n  apiVersion: \"apps/v1\"\n  kind: \"Deployment\"\n  metadata: {\n    name: \"birdbath-worker\"\n    namespace: \"default\"\n    labels: {\n      app: \"hovel\"\n      tier: \"data\"\n    }\n  }\n\n  # Deployment spec\n  spec: {\n    replicas: 2\n    container: {\n      image: \"providence:1.0.8\"\n      port: 8080\n      resources: {\n        cpu_limit: \"1000m\"\n        memory_limit: \"512Mi\"\n      }\n    }\n\n    health_check: {\n      path: \"/health\"\n      interval: 10\n      timeout: 5\n    }\n  }\n}"
  }
