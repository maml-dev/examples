    mamlText: "{\n  domain: \"understated-tentacle.com\"\n  inbound: {\n    mx_records: [\n      \"mx1.understated-tentacle.com\"\n      \"mx2.understated-tentacle.com\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.understated-tentacle.com\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 207\n      per_hour: 4516\n    }\n  }\n}"
