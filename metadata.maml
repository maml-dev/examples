    title: "Notification Config"
    description: "Multi-channel notification routing rules."
    shapeIndex: 3
    mamlText: "{\n  channels: {\n    email: {\n      enabled: true\n      provider: \"sendgrid\"\n      from: \"notifications@juicy-skean.info\"\n    }\n\n    slack: {\n      enabled: true\n      webhook_url: \"https://hooks.slack.com/services/jaRWsHKM4c5lijwMh07Z\"\n      default_channel: \"#deployments\"\n    }\n\n    sms: {\n      enabled: false\n      provider: \"sns\"\n    }\n  }\n\n  # Routing rules\n  rules: [\n    {\n      event: \"deploy_success\"\n      channels: [\n        \"slack\"\n        \"email\"\n      ]\n      priority: \"low\"\n    }\n\n    {\n      event: \"deploy_failure\"\n      channels: [\n        \"slack\"\n        \"email\"\n        \"sms\"\n      ]\n      priority: \"critical\"\n    }\n\n    {\n      event: \"error_spike\"\n      channels: [\n        \"slack\"\n      ]\n      priority: \"high\"\n    }\n  ]\n}"
  }
  {
    num: "10168"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Pasta Carbonara\"\n  servings: 8\n  prep_time: \"11 minutes\"\n  cook_time: \"46 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 tsp rice paper\"\n    \"1 pieces endive\"\n    \"3 tbsp buckwheat\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Baked turnips-stuffed kangaroo, seasoned with cardamom and bitter herbs, accompanied by roasted squash medley.\"\n    \"Tender pork skewers, glazed with a sweet and tangy mangosteen sauce, served over a bed of fragrant jasmine rice.\"\n    \"Our creamy lamb, slow-cooked to perfection, accompanied by steamed potatoes and a rich, savory gravy.\"\n    \"Fresh mixed greens tossed with rosemary-rubbed goose, cucumber, and a light dressing.\"\n  ]\n\n  nutrition: {\n    calories: 259\n    protein: \"17g\"\n    carbs: \"52g\"\n    fat: \"32g\"\n  }\n}"
  }
  {
    num: "10169"
    title: "i18n Config"
    description: "Internationalization and locale settings."
    shapeIndex: 3
    mamlText: "{\n  default_locale: \"en-US\"\n  fallback: \"en\"\n  locales: [\n    {\n      code: \"en\"\n      name: \"English\"\n      dir: \"ltr\"\n    }\n\n    {\n      code: \"fr\"\n      name: \"Français\"\n      dir: \"ltr\"\n    }\n\n    {\n      code: \"ar\"\n      name: \"العربية\"\n      dir: \"rtl\"\n    }\n\n    {\n      code: \"ja\"\n      name: \"日本語\"\n      dir: \"ltr\"\n    }\n  ]\n\n  detection: {\n    order: [\n      \"cookie\"\n      \"header\"\n      \"query\"\n    ]\n    cookie_name: \"lang\"\n  }\n}"
  }
  {
    num: "10170"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Caesar Salad\"\n  servings: 6\n  prep_time: \"16 minutes\"\n  cook_time: \"94 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 tsp nectarines\"\n    \"2 oz almonds\"\n    \"4 pieces thyme\"\n    \"3 tbsp miso\"\n    \"4 lbs nutmeg\"\n  ]\n\n  # Instructions\n  steps: [\n    \"A delicious potatoes creation, seasoned with dill and pepper, showcasing the best of plant-based cuisine.\"\n    \"A delightful tart combining juicy capers and sweet jarrahdale pumpkin, set in a buttery pastry shell and finished with a hint of galangal.\"\n    \"Baked oats-stuffed beef, seasoned with cassia and golden herbs, accompanied by roasted cauliflower medley.\"\n    \"19-day aged lamb steak, with choice of 2 sides.\"\n    \"A heartwarming Persian soup, featuring fresh radish and an aromatic blend of traditional spices.\"\n    \"An exquisite chilli pepper dish, paired with jicama and a hint of sumac.\"\n  ]\n\n  nutrition: {\n    calories: 533\n    protein: \"27g\"\n    carbs: \"35g\"\n    fat: \"22g\"\n  }\n}"
  }
