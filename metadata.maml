    mamlText: "# Email template configuration\n{\n  from: \"noreply@indelible-understanding.info\"\n  subject: \"Volup subiungo conscendo brevis bonus.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Pectus arma balbus attero dolore somniculosus. Repudiandae aliquam tum in. Ascisco laboriosam ancilla.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nDefaeco commodo tardus comparo sustineo cilicium stultus articulus cunae alias. Subnecto usitas sortitus arceo aiunt laboriosam vado. Conor versus eligendi adicio abbas sequi denuncio vetus harum suscipit.\n\nVisit: {{url}}\n\"\"\"\n}"
