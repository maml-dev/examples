    title: "Dashboard Layout"
    description: "Dashboard widget layout configuration."
    shapeIndex: 3
    mamlText: "{\n  title: \"Goyette - Crooks Dashboard\"\n  refresh_interval: 60 # seconds\n  widgets: [\n    {\n      type: \"chart\"\n      title: \"Active Users\"\n      source: \"/api/metrics/traffic\"\n      chart_type: \"line\"\n      period: \"7d\"\n    }\n\n    {\n      type: \"stat\"\n      title: \"Uptime\"\n      source: \"/api/stats/users\"\n      format: \"currency\"\n    }\n\n    {\n      type: \"table\"\n      title: \"Top Pages\"\n      source: \"/api/recent/orders\"\n      limit: 19\n    }\n  ]\n\n  theme: \"light\"\n}"
  }
  {
