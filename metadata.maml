  {
    num: "13193"
    title: "Config with Comments"
    description: "Heavily documented configuration file."
    shapeIndex: 4
    mamlText: "# Application Configuration File\n# Generated by MAML examples\n{\n  # Application metadata\n  # These values are shown in the UI\n  app: {\n    # The display name shown in the UI\n    name: \"Barrows - Littel\"\n    version: \"3.2.20\" # semver\n    # Brief description for the about page\n    description: \"Digitized content-based benchmark\"\n  }\n\n  # Server configuration\n  server: {\n    host: \"0.0.0.0\" # bind to all interfaces\n    port: 8820 # default: 8080\n    # Number of worker processes\n    workers: 15 # set to 0 for auto\n  }\n\n  # Logging settings\n  logging: {\n    # Valid levels: debug, info, warn, error\n    level: \"warn\"\n    format: \"json\" # json recommended for production\n    output: \"stdout\" # file path or stdout\n  }\n}"
  }
  {
    num: "13194"
    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@pointless-roadway.biz\"\n  subject: \"Aqua utrimque cavus curto.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Coma eos auctor odio temeritas nesciunt calamitas attollo delectatio celer. Aequitas cibus ager sum copiose tersus decimus. Clementia caritas spargo.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nArto cinis vomica vir doloremque ipsam tamdiu. Deprimo crinis natus velit sustineo aedificium adduco taedium versus. Depulso cohibeo caput.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
