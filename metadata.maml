    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@moral-polarisation.info\"\n  subject: \"Vitiosus viduo stipes fugiat.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Ciminatio vitiosus cimentarius aegre truculenter conforto strenuus decipio. Sursum congregatio vito dolore decumbo neque armarium. Aliquid deludo laborum vere praesentium absens conventus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nVivo terror degenero celo vito tutis celo vicinus. Brevis tracto crastinus cuius voluptas. Rerum audacia carcer callide coadunatio desparatus truculenter delectus atqui.\n\nVisit: {{url}}\n\"\"\"\n}"
