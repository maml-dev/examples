    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 10\"\n  tasks: [\n    {\n      id: \"ZZ59EK\"\n      title: \"programming the interface won't do anything, we need to program the 1080p IB port!\"\n      assignee: \"Ruby MacGyver\"\n      priority: \"medium\"\n      status: \"todo\"\n      points: 5\n    }\n\n    {\n      id: \"GEOBIK\"\n      title: \"You can't transmit the matrix without parsing the auxiliary TLS circuit!\"\n      assignee: \"Lura Mraz\"\n      priority: \"medium\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"A3I6N4\"\n      title: \"You can't generate the monitor without compressing the primary GB application!\"\n      assignee: \"Lowell Mills\"\n      priority: \"high\"\n      status: \"done\"\n      points: 3\n    }\n\n    {\n      id: \"I5N4UV\"\n      title: \"The FTP capacitor is down, parse the wireless program so we can transmit the AI application!\"\n      assignee: \"Nicklaus Kessler\"\n      priority: \"low\"\n      status: \"done\"\n      points: 2\n    }\n\n    {\n      id: \"9OBZX2\"\n      title: \"We need to index the optical SCSI bandwidth!\"\n      assignee: \"Megan Kozey\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 5\n    }\n\n    {\n      id: \"NY6IX3\"\n      title: \"If we index the panel, we can get to the HEX driver through the wireless EXE panel!\"\n      assignee: \"Dr. Karolann Konopelski\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 2\n    }\n  ]\n}"
