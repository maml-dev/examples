    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 6\"\n  tasks: [\n    {\n      id: \"JAWSGV\"\n      title: \"connecting the sensor won't do anything, we need to calculate the online SMS transmitter!\"\n      assignee: \"Lillie Mueller\"\n      priority: \"high\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"U3YBSZ\"\n      title: \"You can't transmit the driver without generating the auxiliary ASCII circuit!\"\n      assignee: \"Mr. Levi Dickinson\"\n      priority: \"high\"\n      status: \"in_progress\"\n      points: 5\n    }\n\n    {\n      id: \"VGMR7U\"\n      title: \"Use the primary HDD microchip, then you can program the primary application!\"\n      assignee: \"Ms. Sonya Bahringer\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 3\n    }\n\n    {\n      id: \"W4K6FX\"\n      title: \"generating the alarm won't do anything, we need to copy the online RSS protocol!\"\n      assignee: \"Virgil Gorczany\"\n      priority: \"low\"\n      status: \"done\"\n      points: 8\n    }\n\n    {\n      id: \"NW1LMW\"\n      title: \"We need to generate the primary FTP interface!\"\n      assignee: \"Lois Herman\"\n      priority: \"high\"\n      status: \"todo\"\n      points: 13\n    }\n  ]\n}"
