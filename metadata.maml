    shapeIndex: 3
    mamlText: "{\n  title: \"Tangelo-glazed Beef Skewers\"\n  servings: 2\n  prep_time: \"55 minutes\"\n  cook_time: \"75 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 cups rice syrup\"\n    \"3 lbs hokkien noodles\"\n    \"1 pieces papaw\"\n    \"1 oz cardamom\"\n    \"1 cups cantaloupe\"\n    \"2 cups scallops\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Grilled pigeon kebabs, marinated in Eritrean spices and served with a fresh zucchini and apricot salad.\"\n    \"Savor the rich flavors of crispy capers, complemented by currant and lemon grass.\"\n    \"A special red kumera from Nicaragua. To support the strong flavor it is sided with a tablespoon of cassia.\"\n    \"Tender chicken skewers, glazed with a sweet and tangy fingerlime sauce, served over a bed of fragrant jasmine rice.\"\n  ]\n\n  nutrition: {\n    calories: 792\n    protein: \"44g\"\n    carbs: \"34g\"\n    fat: \"6g\"\n  }\n}"
