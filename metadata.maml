    mamlText: "{\n  application: \"mindshare\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: overriding the card won't do anything, we need to bypass the mobile USB firewall!\n    at /selinux/terribly.rtf:430\n    at /opt/sbin/unethically_phew.ini:180\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nGET /api/morbidity HTTP/1.1\nHost: wry-guidance.name\nUser-Agent: Mozilla/5.0 (Windows NT 6.2; Win64; x64) AppleWebKit/598.57 (KHTML, like Gecko) Chrome/119.9.10.9 Safari/557.90 Edg/112.3.16.6\nAccept: application/json\n\"\"\"\n  retention_days: 76\n}"
