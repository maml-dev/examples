  {
    num: "12938"
    title: "Backup Strategy"
    description: "Backup schedule and retention policy."
    shapeIndex: 1
    mamlText: "{\n  source: {\n    type: \"mysql\"\n    host: \"db.internal\"\n    databases: [\n      \"soybean\"\n      \"baseboard\"\n    ]\n  }\n\n  # Backup schedule\n  schedule: {\n    full: \"0 2 * * 0\" # weekly Sunday 2am\n    incremental: \"0 2 * * 1-6\" # daily except Sunday\n    snapshot: \"0 */4 * * *\" # every 4 hours\n  }\n\n  retention: {\n    daily: 11\n    weekly: 12\n    monthly: 19\n  }\n\n  destination: {\n    type: \"local\"\n    path: \"s3://backups-doorpost\"\n    encryption: true\n    compression: \"zstd\"\n  }\n}"
  }
