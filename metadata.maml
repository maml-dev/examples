    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"metallic-saw.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.metallic-saw.info\"\n      \"mx2.metallic-saw.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.metallic-saw.info\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 307\n      per_hour: 5956\n    }\n  }\n}"
