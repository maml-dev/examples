    description: "Authentication and authorization settings."
    shapeIndex: 1
    mamlText: "{\n  provider: \"oauth2\"\n  # Token settings\n  jwt: {\n    secret_key: \"HoJ2GsuopuB06osNXbUDQ0SQkNYhBQO1\"\n    algorithm: \"RS256\"\n    expiry: \"24h\"\n    refresh_expiry: \"7d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"OJjm1E3jkTTcvkBxAikl2tqy\"\n    authorize_url: \"https://auth.sizzling-exterior.org/authorize\"\n    token_url: \"https://auth.wiggly-typeface.biz/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"memory\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
