  {
    num: "13421"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"granular-noon.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.granular-noon.biz\"\n      \"mx2.granular-noon.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.granular-noon.biz\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 394\n      per_hour: 8044\n    }\n  }\n}"
  }
  {
    num: "13422"
    title: "Monitoring Config"
    description: "Application monitoring and alerting setup."
    shapeIndex: 1
    mamlText: "{\n  service: \"applications\"\n  # Prometheus metrics\n  metrics: {\n    endpoint: \"/metrics\"\n    interval: 30 # seconds\n    labels: {\n      env: \"prod\"\n      region: \"eu-west\"\n      team: \"beauty\"\n    }\n  }\n\n  # Alert thresholds\n  alerts: {\n    cpu_threshold: 86\n    memory_threshold: 89\n    latency_p99_ms: 1439\n    error_rate: 0.05\n    notification: {\n      channel: \"#oncall\"\n      severity: \"warning\"\n    }\n  }\n}"
  }
