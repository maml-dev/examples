    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"oddball-bathhouse.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.oddball-bathhouse.info\"\n      \"mx2.oddball-bathhouse.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.oddball-bathhouse.info\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 246\n      per_hour: 6601\n    }\n  }\n}"
  }
  {
    num: "4734"
    title: "API Gateway"
    description: "API gateway routing and middleware configuration."
    shapeIndex: 1
    mamlText: "{\n  gateway: {\n    host: \"api.scared-bell.org\"\n    port: 8443\n    protocol: \"https\"\n  }\n\n  # Rate limiting\n  rate_limit: {\n    enabled: true\n    window: \"5m\"\n    max_requests: 8134\n    by: \"api_key\"\n  }\n\n  # CORS policy\n  cors: {\n    enabled: true\n    origins: [\n      \"https://woeful-nephew.name\"\n      \"https://app.wise-nerve.com\"\n    ]\n    methods: [\n      \"GET\"\n      \"POST\"\n      \"PUT\"\n      \"DELETE\"\n    ]\n    max_age: 86400\n  }\n\n  cache: {\n    enabled: false\n    ttl: 2853\n    store: \"redis\"\n  }\n}"
  }
  {
    num: "4735"
    title: "Auth Config"
    description: "Authentication and authorization settings."
    shapeIndex: 1
    mamlText: "{\n  provider: \"saml\"\n  # Token settings\n  jwt: {\n    secret_key: \"XCLppfaP1ZcFgtjhTTotlcM5Xpyk7aXG\"\n    algorithm: \"RS256\"\n    expiry: \"1h\"\n    refresh_expiry: \"7d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"8lmHKt5363zNtzvVHUkC6AhQ\"\n    authorize_url: \"https://auth.courageous-mechanic.info/authorize\"\n    token_url: \"https://auth.important-overcoat.net/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"redis\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
  }
  {
