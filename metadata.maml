    description: "Mock API response payloads for testing."
    shapeIndex: 4
    mamlText: "# Mock API definition\n{\n  endpoint: \"/api/v1/users\"\n  method: \"GET\"\n  status: 200\n  # JSON response body\n  response: \"\"\"\n[\n  {\n    \"id\": 1,\n    \"name\": \"Shaina Ortiz\",\n    \"email\": \"Gregoria38@yahoo.com\",\n    \"role\": \"admin\"\n  },\n  {\n    \"id\": 2,\n    \"name\": \"Mr. Justin Ziemann Jr.\",\n    \"email\": \"Donny_Hettinger@gmail.com\",\n    \"role\": \"user\"\n  }\n]\n\"\"\"\n\n  # Response headers\n  headers: {\n    Content-Type: \"application/json\"\n    X-Total-Count: \"2\"\n    X-Request-Id: \"1a4eb675-2355-4cb7-89ed-5396b68221c5\"\n  }\n  delay_ms: 171 # simulated latency\n}"
  }
