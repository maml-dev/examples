    shapeIndex: 1
    mamlText: "{\n  provider: \"gcp\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 5\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 15\n      target_cpu: 75\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 334\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-a5c58ae2\"\n    subnet: \"10.21.0.0/16\"\n    public_ip: true\n  }\n}"
  }
  {
    num: "3937"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"unripe-blowgun.name\"\n  inbound: {\n    mx_records: [\n      \"mx1.unripe-blowgun.name\"\n      \"mx2.unripe-blowgun.name\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.unripe-blowgun.name\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 117\n      per_hour: 7245\n    }\n  }\n}"
  }
  {
    num: "3938"
    title: "API Gateway"
    description: "API gateway routing and middleware configuration."
    shapeIndex: 1
    mamlText: "{\n  gateway: {\n    host: \"api.sociable-sand.org\"\n    port: 443\n    protocol: \"https\"\n  }\n\n  # Rate limiting\n  rate_limit: {\n    enabled: true\n    window: \"1m\"\n    max_requests: 9725\n    by: \"api_key\"\n  }\n\n  # CORS policy\n  cors: {\n    enabled: true\n    origins: [\n      \"https://possible-galoshes.name\"\n      \"https://app.icy-yeast.net\"\n    ]\n    methods: [\n      \"GET\"\n      \"POST\"\n      \"PUT\"\n      \"DELETE\"\n    ]\n    max_age: 86400\n  }\n\n  cache: {\n    enabled: true\n    ttl: 1218\n    store: \"memory\"\n  }\n}"
  }
  {
