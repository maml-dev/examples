    description: "SSH client host configuration."
    shapeIndex: 0
    mamlText: "{\n  host: \"staging\"\n  hostname: \"231.170.90.222\"\n  user: \"dena_kertzmann82\"\n  port: 22\n  identity_file: \"~/.ssh/id_rsa\"\n\n  forward_agent: true\n  server_alive_interval: 60\n  compression: true\n}"
