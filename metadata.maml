  {
    num: "10187"
    title: "Config with Comments"
    description: "Heavily documented configuration file."
    shapeIndex: 4
    mamlText: "# Application Configuration File\n# Generated by MAML examples\n{\n  # Application metadata\n  # These values are shown in the UI\n  app: {\n    # The display name shown in the UI\n    name: \"Jacobs, Hoeger and Balistreri\"\n    version: \"3.1.19\" # semver\n    # Brief description for the about page\n    description: \"Smart mobile structure\"\n  }\n\n  # Server configuration\n  server: {\n    host: \"0.0.0.0\" # bind to all interfaces\n    port: 8514 # default: 8080\n    # Number of worker processes\n    workers: 4 # set to 0 for auto\n  }\n\n  # Logging settings\n  logging: {\n    # Valid levels: debug, info, warn, error\n    level: \"warn\"\n    format: \"json\" # json recommended for production\n    output: \"/var/log/app.log\" # file path or stdout\n  }\n}"
  }
  {
    num: "10188"
    title: "HTML Templates"
    description: "Email HTML templates with raw string content."
    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@reflecting-mentor.info\"\n  subject: \"Subseco tardus territo solio.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Demonstro corporis basium. Virga clementia addo comitatus valetudo correptius. Crux vinum caterva solutio adeptio acidus tibi terreo amoveo.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nSolutio adflicto vulpes conspergo voluptate solutio patior. Ad sunt eligendi illum pariatur abundans quae. Tendo argumentum ambulo.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
