    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@quintessential-husband.org\"\n  subject: \"Vinum somnus crapula aegrus dolores comis.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Curvo similique trans stillicidium accusantium thymbra adeo colligo. Pauci cibo exercitationem auctor inflammatio. Centum demonstro delicate demitto.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nCernuus thema curto aedificium. Synagoga quo virgo. Valetudo qui demum.\n\nVisit: {{url}}\n\"\"\"\n}"
