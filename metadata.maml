    description: "SMTP email service settings."
    shapeIndex: 0
    mamlText: "{\n  smtp_host: \"smtp.ripe-louse.net\"\n  smtp_port: 465\n  use_tls: true\n  from_name: \"Lang-Hermann, Russel and Hickle\"\n  from_email: \"noreply@ripe-louse.net\"\n\n  # Rate limiting\n  max_batch_size: 332\n  retry_interval: 238\n}"
