    mamlText: "{\n  domain: \"afraid-academics.info\"\n  inbound: {\n    mx_records: [\n      \"mx1.afraid-academics.info\"\n      \"mx2.afraid-academics.info\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.afraid-academics.info\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 375\n      per_hour: 5440\n    }\n  }\n}"
