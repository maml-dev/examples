    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"legal-underneath.net\"\n  inbound: {\n    mx_records: [\n      \"mx1.legal-underneath.net\"\n      \"mx2.legal-underneath.net\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.legal-underneath.net\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 289\n      per_hour: 4673\n    }\n  }\n}"
