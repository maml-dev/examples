    mamlText: "{\n  title: \"Armarium titulus sto est utique curso.\"\n  slug: \"alter-tumultus-viridis\"\n  author: {\n    name: \"Rosemarie Kuhic\"\n    avatar: \"https://cdn.jsdelivr.net/gh/faker-js/assets-person-portrait/female/512/7.jpg\"\n    bio: \"leader, dreamer, film lover\"\n  }\n  date: \"2026-07-09\"\n  tags: [\n    \"outset\"\n    \"flight\"\n    \"space\"\n  ]\n\n  published: true\n  reading_time: \"18 min\"\n  summary: \"Illum ultio contego spoliatio terreo unde voluptatibus adversus. Tamdiu baiulus adhaero utpote temporibus tyrannus veniam comptus eum doloribus. Crux pectus voveo denuncio blanditiis soluta.\"\n}"
