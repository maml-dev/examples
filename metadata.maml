    mamlText: "# Email template configuration\n{\n  from: \"noreply@ordinary-programme.biz\"\n  subject: \"Celebrer alii beatus sumptus cotidie.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Creber tempus sint vinum arma. Verto asporto curiositas spero vehemens aut aestivus. Traho triduana video testimonium possimus validus somnus.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nQuibusdam nobis verbera. Atqui tremo desipio calcar ratione vito vapulus debitis. Argumentum sublime confido perspiciatis velit sollicito blandior iste suffoco.\n\nVisit: {{url}}\n\"\"\"\n}"
