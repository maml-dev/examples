    title: "K8s Deployment"
    description: "Kubernetes deployment specification."
    shapeIndex: 1
    mamlText: "{\n  apiVersion: \"apps/v1\"\n  kind: \"Deployment\"\n  metadata: {\n    name: \"starboard-worker\"\n    namespace: \"default\"\n    labels: {\n      app: \"yak\"\n      tier: \"data\"\n    }\n  }\n\n  # Deployment spec\n  spec: {\n    replicas: 4\n    container: {\n      image: \"conservation:7.15.6\"\n      port: 9090\n      resources: {\n        cpu_limit: \"1000m\"\n        memory_limit: \"256Mi\"\n      }\n    }\n\n    health_check: {\n      path: \"/health\"\n      interval: 15\n      timeout: 5\n    }\n  }\n}"
  }
  {
    num: "5726"
    title: "Email Routing"
    description: "Email routing and filtering rules."
    shapeIndex: 1
    mamlText: "{\n  domain: \"scared-stay.name\"\n  inbound: {\n    mx_records: [\n      \"mx1.scared-stay.name\"\n      \"mx2.scared-stay.name\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 7\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 2048\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.scared-stay.name\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 485\n      per_hour: 6643\n    }\n  }\n}"
  }
  {
