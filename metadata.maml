    mamlText: "{\n  domain: \"these-responsibility.org\"\n  inbound: {\n    mx_records: [\n      \"mx1.these-responsibility.org\"\n      \"mx2.these-responsibility.org\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.these-responsibility.org\"\n    port: 587\n    tls: true\n    rate_limit: {\n      per_minute: 84\n      per_hour: 7158\n    }\n  }\n}"
