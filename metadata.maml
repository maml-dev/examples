    title: "Auth Config"
    description: "Authentication and authorization settings."
    shapeIndex: 1
    mamlText: "{\n  provider: \"saml\"\n  # Token settings\n  jwt: {\n    secret_key: \"ymhmuHPLiczTdfcxpwTm44HMtEJPzfJ9\"\n    algorithm: \"HS256\"\n    expiry: \"7d\"\n    refresh_expiry: \"30d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"lVfguCMt8Tx5Lof1A6JRwsMu\"\n    authorize_url: \"https://auth.well-off-comparison.com/authorize\"\n    token_url: \"https://auth.fruitful-median.org/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"memory\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
