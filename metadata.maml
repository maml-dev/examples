    mamlText: "{\n  domain: \"plain-designation.com\"\n  inbound: {\n    mx_records: [\n      \"mx1.plain-designation.com\"\n      \"mx2.plain-designation.com\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 8.5\n      action: \"reject\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.plain-designation.com\"\n    port: 25\n    tls: true\n    rate_limit: {\n      per_minute: 86\n      per_hour: 1209\n    }\n  }\n}"
