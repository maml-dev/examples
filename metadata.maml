    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"us-west-2\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 10\n    auto_scaling: {\n      enabled: true\n      min: 2\n      max: 14\n      target_cpu: 54\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 98\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-dccf6c6b\"\n    subnet: \"10.120.0.0/16\"\n    public_ip: false\n  }\n}"
