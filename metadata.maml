    mamlText: "{\n  sprint: \"Sprint 36\"\n  tasks: [\n    {\n      id: \"PJHVZ2\"\n      title: \"You can't compress the transmitter without connecting the primary AGP capacitor!\"\n      assignee: \"Wyman Kub II\"\n      priority: \"high\"\n      status: \"review\"\n      points: 2\n    }\n\n    {\n      id: \"LLORKZ\"\n      title: \"We need to generate the optical VGA sensor!\"\n      assignee: \"Annie Howell\"\n      priority: \"low\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"UYTO21\"\n      title: \"Try to navigate the CLI feed, maybe it will transmit the multi-byte driver!\"\n      assignee: \"Ethyl Rodriguez\"\n      priority: \"high\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"DVB0C2\"\n      title: \"We need to generate the online DRAM feed!\"\n      assignee: \"Madeline Howell\"\n      priority: \"high\"\n      status: \"review\"\n      points: 13\n    }\n\n    {\n      id: \"JMVQZ3\"\n      title: \"I'll calculate the wireless UDP microchip, that should feed the TCP interface!\"\n      assignee: \"Samuel Sauer\"\n      priority: \"medium\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"GF2KMQ\"\n      title: \"If we bypass the card, we can get to the OCR microchip through the solid state UTF8 system!\"\n      assignee: \"Jill Leffler-Krajcik\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 13\n    }\n  ]\n}"
