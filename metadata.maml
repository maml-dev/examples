    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"gcp\"\n  region: \"ap-southeast-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 7\n    auto_scaling: {\n      enabled: true\n      min: 2\n      max: 5\n      target_cpu: 71\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 82\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-edb354d2\"\n    subnet: \"10.95.0.0/16\"\n    public_ip: false\n  }\n}"
  }
