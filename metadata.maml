    mamlText: "{\n  sprint: \"Sprint 7\"\n  tasks: [\n    {\n      id: \"ELI6GY\"\n      title: \"Use the multi-byte PNG alarm, then you can connect the redundant interface!\"\n      assignee: \"Edna Volkman\"\n      priority: \"critical\"\n      status: \"review\"\n      points: 1\n    }\n\n    {\n      id: \"J09TR8\"\n      title: \"Try to index the JBOD monitor, maybe it will override the back-end array!\"\n      assignee: \"Roselyn Hyatt\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 1\n    }\n\n    {\n      id: \"9EZ3ZO\"\n      title: \"Try to hack the VGA matrix, maybe it will back up the cross-platform firewall!\"\n      assignee: \"Kristin Rolfson\"\n      priority: \"critical\"\n      status: \"review\"\n      points: 1\n    }\n  ]\n}"
