    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@rough-transom.biz\"\n  subject: \"Agnosco explicabo ocer.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Quasi ara convoco claro quo. Defungo vergo adstringo thesis audeo creptio altus sono. Confugo textor tenus tricesimus debilito blandior creator censura.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nOmnis cunae considero thesaurus accusator. Vulgus sollers vado barba corrumpo alii adhuc paulatim. Basium caecus vicinus sperno nesciunt concido denuo.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
