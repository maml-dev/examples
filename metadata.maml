    mamlText: "{\n  provider: \"oidc\"\n  # Token settings\n  jwt: {\n    secret_key: \"CS6uqOwLrPxef06ORFjLJBcjQT7xDjhn\"\n    algorithm: \"HS256\"\n    expiry: \"7d\"\n    refresh_expiry: \"7d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"8XZ5uuHIa8h5K78VEQVp9lGX\"\n    authorize_url: \"https://auth.defensive-hierarchy.com/authorize\"\n    token_url: \"https://auth.clumsy-diversity.biz/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"redis\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
