    shapeIndex: 0
    mamlText: "{\n  level: \"warn\"\n  format: \"logfmt\"\n  timestamp: true\n  caller: false # include file:line\n\n  output: \"/var/log/app.log\"\n  rotation: false\n  max_size_mb: 468\n  max_age_days: 12\n  compress: true\n}"
  }
