    description: "Role-based access control definitions."
    shapeIndex: 2
    mamlText: "{\n  roles: [\n    {\n      name: \"support\"\n      permissions: [\n        \"manage_billing\"\n        \"view_analytics\"\n        \"export_data\"\n        \"delete\"\n      ]\n      max_seats: 8\n    }\n\n    {\n      name: \"editor\"\n      permissions: [\n        \"write\"\n        \"manage_users\"\n        \"manage_billing\"\n      ]\n      max_seats: 4\n    }\n\n    {\n      name: \"editor\"\n      permissions: [\n        \"write\"\n        \"manage_billing\"\n        \"view_analytics\"\n        \"delete\"\n      ]\n      max_seats: 17\n    }\n\n    {\n      name: \"billing\"\n      permissions: [\n        \"export_data\"\n        \"manage_users\"\n        \"read\"\n      ]\n      max_seats: null\n    }\n\n    {\n      name: \"moderator\"\n      permissions: [\n        \"read\"\n        \"manage_billing\"\n      ]\n      max_seats: 26\n    }\n  ]\n}"
