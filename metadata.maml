    description: "Outgoing webhook endpoint configuration."
    shapeIndex: 3
    mamlText: "{\n  name: \"taxicab-hooks\"\n  secret: \"kmrXJSc5Ztr2tqoEnddyJt47smOAKjFY\"\n  endpoints: [\n    {\n      url: \"https://unlucky-deployment.com/webhook\"\n      events: [\n        \"create\"\n        \"update\"\n        \"delete\"\n      ]\n      active: true\n    }\n\n    {\n      url: \"https://salty-igloo.org/callback\"\n      events: [\n        \"payment.success\"\n        \"payment.failed\"\n      ]\n      active: false\n    }\n  ]\n\n  retry: {\n    max_attempts: 4\n    backoff: \"linear\"\n    interval: 43 # seconds\n  }\n  timeout: 24 # seconds\n}"
