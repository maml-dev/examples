    title: "Blog Post"
    description: "A blog post with metadata and content sections."
    shapeIndex: 3
    mamlText: "{\n  title: \"Deputo adipisci curatio caritas numquam laboriosam.\"\n  slug: \"adfero-candidus-ante\"\n  author: {\n    name: \"Henry Yundt II\"\n    avatar: \"https://avatars.githubusercontent.com/u/90879307\"\n    bio: \"coach, grad, photographer\"\n  }\n  date: \"2026-07-16\"\n  tags: [\n    \"joy\"\n    \"object\"\n    \"information\"\n  ]\n\n  published: true\n  reading_time: \"15 min\"\n  summary: \"Decumbo quae maxime convoco vulnero tunc expedita. Depopulo decerno tunc credo textilis iure enim crur catena supellex. Iure aer aestas vaco coadunatio tredecim vapulus deserunt deludo.\"\n}"
  }
