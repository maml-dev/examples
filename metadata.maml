    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 37\"\n  tasks: [\n    {\n      id: \"XALK24\"\n      title: \"The TLS card is down, override the digital interface so we can quantify the UTF8 port!\"\n      assignee: \"Laisha Haley\"\n      priority: \"low\"\n      status: \"in_progress\"\n      points: 13\n    }\n\n    {\n      id: \"G8NJKT\"\n      title: \"If we calculate the feed, we can get to the TLS capacitor through the 1080p SCSI microchip!\"\n      assignee: \"Toni Casper\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 13\n    }\n\n    {\n      id: \"AMIGDG\"\n      title: \"Use the haptic USB alarm, then you can reboot the solid state alarm!\"\n      assignee: \"Molly Moen MD\"\n      priority: \"critical\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"3VH433\"\n      title: \"Try to synthesize the SQL firewall, maybe it will quantify the redundant pixel!\"\n      assignee: \"Bernita White\"\n      priority: \"low\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"XX2W3U\"\n      title: \"bypassing the capacitor won't do anything, we need to override the auxiliary JBOD system!\"\n      assignee: \"Miss Myra Lowe\"\n      priority: \"critical\"\n      status: \"done\"\n      points: 13\n    }\n  ]\n}"
