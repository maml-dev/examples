    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"us-east-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"Standard_B2s\"\n    count: 9\n    auto_scaling: {\n      enabled: true\n      min: 1\n      max: 10\n      target_cpu: 79\n    }\n  }\n\n  storage: {\n    type: \"nvme\"\n    size_gb: 496\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-f623ccbe\"\n    subnet: \"10.143.0.0/16\"\n    public_ip: false\n  }\n}"
  }
