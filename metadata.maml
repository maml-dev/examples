    mamlText: "{\n  app_name: \"Zieme, Morissette and Gibson\"\n  environment: \"staging\"\n  debug: true\n  port: 6234\n\n  # Logging\n  log_level: \"warn\"\n  log_format: \"pretty\"\n  api_version: \"v1\"\n  max_request_size: \"7mb\"\n}"
