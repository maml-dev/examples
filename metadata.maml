    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 48\"\n  tasks: [\n    {\n      id: \"MKDVOG\"\n      title: \"The SAS card is down, back up the solid state firewall so we can quantify the AI transmitter!\"\n      assignee: \"Mrs. Jan Weissnat\"\n      priority: \"high\"\n      status: \"in_progress\"\n      points: 3\n    }\n\n    {\n      id: \"SIJEUP\"\n      title: \"The TLS sensor is down, hack the virtual protocol so we can calculate the UDP pixel!\"\n      assignee: \"Anthony Miller\"\n      priority: \"critical\"\n      status: \"todo\"\n      points: 3\n    }\n\n    {\n      id: \"DEOQ9L\"\n      title: \"Use the solid state API firewall, then you can compress the back-end panel!\"\n      assignee: \"Alanis Ward\"\n      priority: \"critical\"\n      status: \"in_progress\"\n      points: 13\n    }\n\n    {\n      id: \"GV64PG\"\n      title: \"Use the mobile IB sensor, then you can hack the primary pixel!\"\n      assignee: \"Margarita Frami\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 2\n    }\n\n    {\n      id: \"HBBWV4\"\n      title: \"Try to calculate the TCP panel, maybe it will transmit the auxiliary bandwidth!\"\n      assignee: \"Branson Flatley\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 8\n    }\n\n    {\n      id: \"GEBPVY\"\n      title: \"The SCSI alarm is down, calculate the online system so we can bypass the COM bandwidth!\"\n      assignee: \"Aurelie Buckridge\"\n      priority: \"medium\"\n      status: \"in_progress\"\n      points: 13\n    }\n  ]\n}"
