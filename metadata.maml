    mamlText: "{\n  domain: \"far-off-custom.biz\"\n  inbound: {\n    mx_records: [\n      \"mx1.far-off-custom.biz\"\n      \"mx2.far-off-custom.biz\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"tag\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.far-off-custom.biz\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 182\n      per_hour: 7733\n    }\n  }\n}"
  }
