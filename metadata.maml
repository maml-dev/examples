    mamlText: "{\n  base_url: \"/api/v3\"\n  routes: [\n    {\n      method: \"GET\"\n      path: \"/users/:id\"\n      handler: \"listPosts\"\n      auth: true\n    }\n\n    {\n      method: \"GET\"\n      path: \"/users\"\n      handler: \"listOrders\"\n      auth: false\n    }\n\n    {\n      method: \"POST\"\n      path: \"/posts\"\n      handler: \"deleteUsers\"\n      auth: false\n    }\n\n    {\n      method: \"GET\"\n      path: \"/posts\"\n      handler: \"deletePosts\"\n      auth: false\n    }\n\n    {\n      method: \"PUT\"\n      path: \"/users\"\n      handler: \"updateOrders\"\n      auth: false\n    }\n\n    {\n      method: \"POST\"\n      path: \"/users/:id\"\n      handler: \"listUsers\"\n      auth: false\n    }\n\n    {\n      method: \"POST\"\n      path: \"/users\"\n      handler: \"updateProducts\"\n      auth: true\n    }\n  ]\n}"
