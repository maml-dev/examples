    mamlText: "{\n  provider: \"jwt\"\n  # Token settings\n  jwt: {\n    secret_key: \"fA6pknjK1uPGmaAQbLrXY1GynPB74dx6\"\n    algorithm: \"ES256\"\n    expiry: \"24h\"\n    refresh_expiry: \"30d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"hyBU0OXBUkGHhAJYOLdmoDiP\"\n    authorize_url: \"https://auth.caring-pharmacopoeia.net/authorize\"\n    token_url: \"https://auth.shy-tooth.name/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"memory\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
