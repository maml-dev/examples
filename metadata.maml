    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"azure\"\n  region: \"eu-west-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"t3.medium\"\n    count: 1\n    auto_scaling: {\n      enabled: true\n      min: 3\n      max: 19\n      target_cpu: 74\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 452\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-d994fc90\"\n    subnet: \"10.192.0.0/16\"\n    public_ip: false\n  }\n}"
  }
  {
