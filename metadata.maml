    shapeIndex: 3
    mamlText: "{\n  title: \"Greek Zucchini Soup\"\n  servings: 3\n  prep_time: \"22 minutes\"\n  cook_time: \"29 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"2 tsp barley\"\n    \"2 lbs vegetable stock\"\n    \"1 tbsp rockmelon\"\n    \"3 tbsp sultanas\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Savor the rich flavors of spicy chives, complemented by lime and liquorice root.\"\n    \"A savory broccoli creation, seasoned with cumin and orange zest, showcasing the best of plant-based cuisine.\"\n    \"An exquisite chicken roast, infused with the essence of apricot, slow-roasted to bring out its natural flavors and served with a side of creamy radish\"\n    \"A heartwarming Udupi soup, featuring fresh buckwheat and an aromatic blend of traditional spices.\"\n    \"A special plum peanuts from Wallis and Futuna. To support the strong flavor it is sided with a tablespoon of sweet laurel.\"\n    \"Juicy rabbit, grilled to your liking and drizzled with a bold balti stir fry mix sauce, served alongside roasted celery.\"\n    \"Fresh nashi pear with a pinch of amchoor, topped by a caramelized apricot with whipped cream\"\n  ]\n\n  nutrition: {\n    calories: 230\n    protein: \"31g\"\n    carbs: \"68g\"\n    fat: \"38g\"\n  }\n}"
