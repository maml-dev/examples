    mamlText: "{\n  application: \"roi\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: parsing the capacitor won't do anything, we need to program the neural SSL feed!\n    at /sbin/orchestrate_scientific.ogx:346\n    at /proc/reproach_optimistically.ttf:23\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPOST /api/ceramic HTTP/1.1\nHost: quarterly-battle.net\nUser-Agent: Mozilla/5.0 (compatible; MSIE 9.0; Windows NT 10.0; Trident/6.0)\nAccept: application/json\n\"\"\"\n  retention_days: 55\n}"
