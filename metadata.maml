    description: "Outgoing webhook endpoint configuration."
    shapeIndex: 3
    mamlText: "{\n  name: \"packaging-hooks\"\n  secret: \"J4ej1D71Dg1qKM1BpCsv4DwMN7iJHG9i\"\n  endpoints: [\n    {\n      url: \"https://tiny-republican.com//webhook\"\n      events: [\n        \"create\"\n        \"update\"\n        \"delete\"\n      ]\n      active: true\n    }\n\n    {\n      url: \"https://needy-tail.name/callback\"\n      events: [\n        \"payment.success\"\n        \"payment.failed\"\n      ]\n      active: false\n    }\n  ]\n\n  retry: {\n    max_attempts: 10\n    backoff: \"linear\"\n    interval: 41 # seconds\n  }\n  timeout: 20 # seconds\n}"
