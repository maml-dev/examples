    mamlText: "{\n  provider: \"aws\"\n  region: \"ap-southeast-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 5\n    auto_scaling: {\n      enabled: true\n      min: 3\n      max: 7\n      target_cpu: 71\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 361\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-ed4ecc8a\"\n    subnet: \"10.136.0.0/16\"\n    public_ip: false\n  }\n}"
