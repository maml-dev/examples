    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"azure\"\n  region: \"eu-west-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 2\n    auto_scaling: {\n      enabled: true\n      min: 2\n      max: 18\n      target_cpu: 52\n    }\n  }\n\n  storage: {\n    type: \"ssd\"\n    size_gb: 462\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-1fb46b7b\"\n    subnet: \"10.48.0.0/16\"\n    public_ip: true\n  }\n}"
  }
  {
