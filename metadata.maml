    title: "Log Entries"
    description: "Application log samples with raw multiline content."
    shapeIndex: 4
    mamlText: "{\n  application: \"ai\"\n  log_format: \"structured\"\n  # Example stack trace\n  sample_error: \"\"\"\nError: We need to navigate the open-source EXE interface!\n    at /etc/under_how_manage.zip:128\n    at /opt/sbin/anti_covenant.webp:444\n    at process.main (node:internal/main:1:1)\n\"\"\"\n\n  # Sample HTTP request\n  sample_request: \"\"\"\nPOST /api/planula HTTP/1.1\nHost: yellow-gown.org\nUser-Agent: Googlebot/2.1 (+http://www.google.com/bot.html)\nAccept: application/json\n\"\"\"\n  retention_days: 75\n}"
