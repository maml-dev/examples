    mamlText: "{\n  name: \"gerbil-hooks\"\n  secret: \"LKuNFRB8VDKASP0A2mLdD6C667tqYb4I\"\n  endpoints: [\n    {\n      url: \"https://miserly-partridge.net/webhook\"\n      events: [\n        \"create\"\n        \"update\"\n        \"delete\"\n      ]\n      active: true\n    }\n\n    {\n      url: \"https://polished-place.org/callback\"\n      events: [\n        \"payment.success\"\n        \"payment.failed\"\n      ]\n      active: true\n    }\n  ]\n\n  retry: {\n    max_attempts: 8\n    backoff: \"exponential\"\n    interval: 15 # seconds\n  }\n  timeout: 8 # seconds\n}"
