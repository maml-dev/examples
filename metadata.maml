    title: "Sprint Board"
    description: "Agile sprint task board."
    shapeIndex: 2
    mamlText: "{\n  sprint: \"Sprint 45\"\n  tasks: [\n    {\n      id: \"ZQ8U48\"\n      title: \"Use the online ADP feed, then you can generate the open-source program!\"\n      assignee: \"Abbigail Hand III\"\n      priority: \"high\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"RA7RGT\"\n      title: \"The GB monitor is down, back up the digital firewall so we can override the SMTP panel!\"\n      assignee: \"Merle Blick\"\n      priority: \"high\"\n      status: \"review\"\n      points: 3\n    }\n\n    {\n      id: \"KVFASP\"\n      title: \"The COM monitor is down, bypass the open-source matrix so we can override the API panel!\"\n      assignee: \"Mr. Kenneth Johns\"\n      priority: \"low\"\n      status: \"done\"\n      points: 2\n    }\n\n    {\n      id: \"ORK5YW\"\n      title: \"You can't navigate the feed without bypassing the 1080p HDD port!\"\n      assignee: \"Laurel Klein\"\n      priority: \"high\"\n      status: \"done\"\n      points: 2\n    }\n\n    {\n      id: \"NTRIWK\"\n      title: \"You can't reboot the pixel without quantifying the optical SSD sensor!\"\n      assignee: \"Clovis Kassulke\"\n      priority: \"high\"\n      status: \"review\"\n      points: 2\n    }\n\n    {\n      id: \"KVXL1C\"\n      title: \"Use the neural ASCII card, then you can override the haptic transmitter!\"\n      assignee: \"Malachi Dickens\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 1\n    }\n  ]\n}"
