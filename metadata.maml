    shapeIndex: 1
    mamlText: "{\n  domain: \"bad-scratch.name\"\n  inbound: {\n    mx_records: [\n      \"mx1.bad-scratch.name\"\n      \"mx2.bad-scratch.name\"\n    ]\n    spam_filter: {\n      enabled: true\n      threshold: 5\n      action: \"quarantine\"\n    }\n\n    dkim: {\n      enabled: true\n      selector: \"default\"\n      key_size: 1024\n    }\n  }\n\n  outbound: {\n    relay: \"smtp.bad-scratch.name\"\n    port: 465\n    tls: true\n    rate_limit: {\n      per_minute: 466\n      per_hour: 8382\n    }\n  }\n}"
