    shapeIndex: 4
    mamlText: "# Email template configuration\n{\n  from: \"noreply@aggressive-detective.biz\"\n  subject: \"Taedium cumque taceo cimentarius.\"\n  # HTML email body\n  template: \"\"\"\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome</title>\n</head>\n<body>\n  <h1>Hello, {{name}}!</h1>\n  <p>Deputo surculus comburo amplitudo. Adipiscor pecto laboriosam cum ambulo accommodo. Adeo sed caries verbum deficio quidem.</p>\n  <a href=\"{{url}}\">Get Started</a>\n</body>\n</html>\n\"\"\"\n\n  # Plain text fallback\n  plain_text: \"\"\"\nHello, {{name}}!\n\nClaudeo cogo crux earum sperno cinis neque. Acerbitas sumptus distinctio cicuta surculus vulgivagus valeo conventus ustulo suadeo. Tondeo distinctio volup dapifer ullam subnecto decimus collum.\n\nVisit: {{url}}\n\"\"\"\n}"
  }
  {
