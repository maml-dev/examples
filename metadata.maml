  {
    num: "11373"
    title: "Test Suite"
    description: "Test runner configuration with coverage settings."
    shapeIndex: 3
    mamlText: "{\n  runner: \"mocha\"\n  root: \"./src/__tests__\"\n  include: [\n    \"**/*.test.ts\"\n    \"**/*.spec.ts\"\n  ]\n  exclude: [\n    \"node_modules\"\n    \"dist\"\n    \"**/*.e2e.ts\"\n  ]\n\n  # Coverage\n  coverage: {\n    enabled: true\n    provider: \"istanbul\"\n    thresholds: {\n      lines: 78\n      branches: 61\n      functions: 92\n    }\n    reporter: [\n      \"text\"\n      \"lcov\"\n      \"html\"\n    ]\n  }\n  globals: true\n  timeout: 5565 # ms\n}"
  }
  {
    num: "11374"
    title: "Recipe"
    description: "A cooking recipe with ingredients and steps."
    shapeIndex: 3
    mamlText: "{\n  title: \"Anise-spiced Peppers Bowl\"\n  servings: 7\n  prep_time: \"54 minutes\"\n  cook_time: \"37 minutes\"\n\n  # Ingredients\n  ingredients: [\n    \"3 pieces buckwheat flour\"\n    \"1 tsp star fruit\"\n    \"2 lbs raspberry\"\n  ]\n\n  # Instructions\n  steps: [\n    \"Grilled beef kebabs, marinated in Ainu spices and served with a fresh zucchini and mango salad.\"\n    \"An exquisite kangaroo roast, infused with the essence of raspberry, slow-roasted to bring out its natural flavors and served with a side of creamy celery\"\n    \"Hearty octopus and pork stew, slow-cooked with turmeric and carob carrot for a comforting, flavorful meal.\"\n    \"Grilled venison kebabs, marinated in Malay spices and served with a fresh asparagus and apple salad.\"\n  ]\n\n  nutrition: {\n    calories: 662\n    protein: \"50g\"\n    carbs: \"91g\"\n    fat: \"34g\"\n  }\n}"
  }
