    title: "Locale Config"
    description: "Regional and locale settings."
    shapeIndex: 0
    mamlText: "{\n  language: \"en\"\n  country: \"IE\"\n  timezone: \"Indian/Comoro\"\n  currency: \"BDT\"\n\n  date_format: \"MM/DD/YYYY\"\n  time_format: \"12h\"\n  first_day_of_week: \"monday\"\n  decimal_separator: \",\"\n}"
  }
