    mamlText: "{\n  host: \"staging\"\n  hostname: \"155.253.137.98\"\n  user: \"oscar_lehner\"\n  port: 22\n  identity_file: \"~/.ssh/id_ed25519\"\n\n  forward_agent: false\n  server_alive_interval: 60\n  compression: true\n}"
