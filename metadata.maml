    mamlText: "{\n  sprint: \"Sprint 3\"\n  tasks: [\n    {\n      id: \"BLISRB\"\n      title: \"Use the auxiliary SSD alarm, then you can input the wireless microchip!\"\n      assignee: \"Stanley Huels\"\n      priority: \"high\"\n      status: \"review\"\n      points: 13\n    }\n\n    {\n      id: \"5R6ZS8\"\n      title: \"If we index the port, we can get to the COM array through the primary SSD card!\"\n      assignee: \"Lindsay Volkman\"\n      priority: \"medium\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"FG0BGS\"\n      title: \"I'll bypass the multi-byte USB bus, that should system the SCSI feed!\"\n      assignee: \"Mr. Tremayne Murazik\"\n      priority: \"high\"\n      status: \"review\"\n      points: 1\n    }\n\n    {\n      id: \"KU4FHO\"\n      title: \"You can't reboot the array without parsing the 1080p VGA microchip!\"\n      assignee: \"Scott Ortiz\"\n      priority: \"high\"\n      status: \"review\"\n      points: 3\n    }\n  ]\n}"
