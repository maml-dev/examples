    title: "Auth Config"
    description: "Authentication and authorization settings."
    shapeIndex: 1
    mamlText: "{\n  provider: \"saml\"\n  # Token settings\n  jwt: {\n    secret_key: \"1cN33Z7eBpoHsYwhUqBgeRfbYzqrGup1\"\n    algorithm: \"HS256\"\n    expiry: \"1h\"\n    refresh_expiry: \"7d\"\n  }\n\n  # OAuth provider\n  oauth: {\n    client_id: \"evxOihq1NlMrfALtcWNL7kZF\"\n    authorize_url: \"https://auth.realistic-cuckoo.name/authorize\"\n    token_url: \"https://auth.dense-thyme.com/token\"\n    scopes: [\n      \"openid\"\n      \"profile\"\n      \"email\"\n    ]\n  }\n\n  session: {\n    store: \"redis\"\n    cookie_name: \"sid\"\n    secure: true\n    http_only: true\n  }\n}"
