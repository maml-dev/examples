    mamlText: "{\n  sprint: \"Sprint 28\"\n  tasks: [\n    {\n      id: \"ZTOURD\"\n      title: \"Try to override the HEX alarm, maybe it will input the solid state card!\"\n      assignee: \"Josiah Bergnaum MD\"\n      priority: \"medium\"\n      status: \"review\"\n      points: 5\n    }\n\n    {\n      id: \"I2VMKU\"\n      title: \"hacking the interface won't do anything, we need to reboot the 1080p THX bandwidth!\"\n      assignee: \"Stephon Cormier\"\n      priority: \"critical\"\n      status: \"done\"\n      points: 8\n    }\n\n    {\n      id: \"VYMMX1\"\n      title: \"calculating the bandwidth won't do anything, we need to input the neural THX interface!\"\n      assignee: \"Dr. Christian Quitzon\"\n      priority: \"low\"\n      status: \"done\"\n      points: 13\n    }\n\n    {\n      id: \"OOTD1U\"\n      title: \"I'll input the solid state SCSI bandwidth, that should interface the UDP array!\"\n      assignee: \"Mr. Ken Jast\"\n      priority: \"high\"\n      status: \"review\"\n      points: 13\n    }\n\n    {\n      id: \"JUZFDY\"\n      title: \"Try to generate the IP circuit, maybe it will transmit the digital card!\"\n      assignee: \"Al Watsica\"\n      priority: \"low\"\n      status: \"todo\"\n      points: 2\n    }\n\n    {\n      id: \"ZXEI9A\"\n      title: \"If we index the feed, we can get to the HTTP interface through the solid state CSS protocol!\"\n      assignee: \"Dante Hirthe\"\n      priority: \"high\"\n      status: \"in_progress\"\n      points: 8\n    }\n  ]\n}"
