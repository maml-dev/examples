    description: "Full application manifest with metadata, dependencies, and scripts."
    shapeIndex: 3
    mamlText: "{\n  name: \"rust-pillow\"\n  version: \"2.10.14\"\n  description: \"Robust 24 hour contingency\"\n\n  keywords: [\n    \"pronoun\"\n    \"receptor\"\n    \"near\"\n  ]\n\n  scripts: {\n    dev: \"node server.js --watch\"\n    build: \"tsc && esbuild src/index.ts --bundle --outfile=dist/index.js\"\n    test: \"jest\"\n    lint: \"eslint .\"\n  }\n  engines: {\n    node: \">=20\"\n  }\n\n  author: {\n    name: \"Delores Gleason\"\n    email: \"Maxwell75@yahoo.com\"\n    url: \"https://miserable-sushi.com/\"\n  }\n}"
  }
