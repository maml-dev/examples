    title: "Cloud Deploy Config"
    description: "Cloud deployment infrastructure configuration."
    shapeIndex: 1
    mamlText: "{\n  provider: \"digitalocean\"\n  region: \"eu-west-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"e2-standard-4\"\n    count: 7\n    auto_scaling: {\n      enabled: true\n      min: 3\n      max: 17\n      target_cpu: 56\n    }\n  }\n\n  storage: {\n    type: \"hdd\"\n    size_gb: 161\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-02a56be4\"\n    subnet: \"10.21.0.0/16\"\n    public_ip: true\n  }\n}"
  }
  {
