    mamlText: "{\n  provider: \"azure\"\n  region: \"ap-southeast-1\"\n\n  # Compute resources\n  compute: {\n    instance_type: \"t3.medium\"\n    count: 8\n    auto_scaling: {\n      enabled: true\n      min: 2\n      max: 17\n      target_cpu: 74\n    }\n  }\n\n  storage: {\n    type: \"nvme\"\n    size_gb: 397\n    encrypted: true\n  }\n\n  networking: {\n    vpc: \"vpc-e8a3fb9f\"\n    subnet: \"10.182.0.0/16\"\n    public_ip: true\n  }\n}"
